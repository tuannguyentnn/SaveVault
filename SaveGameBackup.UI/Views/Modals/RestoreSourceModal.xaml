<UserControl x:Class="SaveGameBackup.UI.Views.Modals.RestoreSourceModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Visibility="{Binding IsRestoreSourceModalOpen, Converter={StaticResource BoolToVis}}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Width="540" MaxWidth="560"
            Background="#101726" BorderBrush="#0284C7" BorderThickness="1.5"
            CornerRadius="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.95" ShadowDepth="14"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="#082F49" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="21" Width="42" Height="42" Margin="0,0,14,0">
                    <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RestoreSourceModalTitle}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Bản sao lưu này đã được đồng bộ lên Cloud" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Message Description -->
            <TextBlock Grid.Row="1" Text="{Binding RestoreSourceModalMessage}" 
                       Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18"/>

            <!-- Selection Choices Card -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Local Option -->
                <Border Grid.Column="0" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💻" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Bản Local" FontWeight="Bold" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="File zip trên máy tính." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,10"/>
                        <Button Content="💻 Chọn Local" Command="{Binding ConfirmRestoreFromLocalCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Google Drive Option -->
                <Border Grid.Column="1" Background="#0C2540" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="3,0,3,0"
                        IsEnabled="{Binding IsPendingDetailSyncedToGoogleDrive}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Google Drive" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tải zip từ Google Drive." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,10"/>
                        <Button Content="📁 Google Drive" Command="{Binding ConfirmRestoreFromGoogleDriveCommand}"
                                Style="{StaticResource SuccessButtonStyle}" Background="#0284C7" Padding="12,6" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- OneDrive Option -->
                <Border Grid.Column="2" Background="#0C233C" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="5,0,0,0"
                        IsEnabled="{Binding IsPendingDetailSyncedToOneDrive}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☁️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="OneDrive" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tải zip từ OneDrive." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,10"/>
                        <Button Content="☁️ OneDrive" Command="{Binding ConfirmRestoreFromOneDriveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Background="#2563EB" Padding="12,6" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Cancel Footer -->
            <Button Grid.Row="3" Content="✕ Hủy bỏ" Command="{Binding CancelRestoreSourceModalCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Center" Padding="22,7" FontSize="12"/>
        </Grid>
    </Border>
</UserControl>

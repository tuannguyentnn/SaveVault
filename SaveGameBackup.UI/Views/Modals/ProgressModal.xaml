<UserControl x:Class="SaveGameBackup.UI.Views.Modals.ProgressModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Visibility="{Binding IsProgressModalOpen, Converter={StaticResource BoolToVis}}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Width="520" MaxWidth="540"
            Background="#101726" BorderBrush="#38BDF8" BorderThickness="1.5"
            CornerRadius="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.95" ShadowDepth="14"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                <Border Background="#0C2A4A" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="21" Width="44" Height="44" Margin="0,0,14,0">
                    <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveProgressTitle}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Vui lòng đợi quá trình xử lý hoàn tất..." FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Progress Information Area -->
            <Border Grid.Row="1" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Message & Percent Row -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding ActiveProgressMessage}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActiveProgressPercent, StringFormat='{}{0}%'}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Modern Progress Bar -->
                    <ProgressBar Value="{Binding ActiveProgressPercent, Mode=OneWay}" Maximum="100" Height="10" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>

                    <!-- Optional Subtext (Speed, chunk info, etc.) -->
                    <TextBlock Text="{Binding ActiveProgressSubText}" Foreground="#94A3B8" FontSize="11" FontStyle="Italic" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Cancel Sync Button (Shown when syncing) -->
            <Button Grid.Row="2" Content="✕ Hủy đồng bộ"
                    Command="{Binding CancelSyncCommand}"
                    Visibility="{Binding IsCloudSyncing, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource DangerButtonStyle}"
                    HorizontalAlignment="Center" Padding="20,7" FontSize="12" Margin="0,0,0,10"/>

            <!-- Bottom Notice / Safety Badge -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBlock Text="🔒 Ứng dụng đang khóa thao tác để bảo toàn toàn vẹn dữ liệu." Foreground="#64748B" FontSize="11"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

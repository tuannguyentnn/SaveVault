<UserControl x:Class="SaveGameBackup.UI.Views.Modals.GameDetailsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Visibility="{Binding IsHistoryDetailsModalOpen, Converter={StaticResource BoolToVis}}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Width="1080" MaxHeight="720"
            Background="#101726" BorderBrush="#2563EB" BorderThickness="1.5"
            CornerRadius="12" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Color="#000000" Opacity="0.85" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lịch sử sao lưu: " FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedGameHistory.GameName}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                        <TextBlock Text="Danh sách toàn bộ các bản snapshot sao lưu được tải trực tiếp từ cơ sở dữ liệu" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Command="{Binding CloseModalCommand}" Style="{StaticResource CloseIconButtonStyle}" ToolTip="Đóng"/>
            </Grid>

            <!-- Quick Summary Stats Bar -->
            <Border Grid.Row="1" Background="#172238" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TỔNG SỐ BẢN BACKUP" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedGameHistory.BackupCount, StringFormat='{}{0} bản ghi'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="BẢN MỚI NHẤT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedGameHistory.FormattedLatestDate}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TỔNG DUNG LƯỢNG" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedGameHistory.FormattedTotalSize}" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Snapshots List (Detail table: backup_history_details) -->
            <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="0" MinHeight="180" MaxHeight="400">
                <Grid>
                    <DataGrid ItemsSource="{Binding CurrentHistoryDetails}"
                              SelectedItem="{Binding SelectedHistoryDetail}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="Transparent" 
                              Foreground="White" 
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B"
                              RowBackground="#0E1524"
                              AlternatingRowBackground="#0B0F19"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding BackupDate, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="160" MinWidth="150" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Dung lượng" Binding="{Binding FormattedSize}" Width="110" MinWidth="100"/>
                            <DataGridTextColumn Header="Số file" Binding="{Binding FileCount}" Width="80" MinWidth="70"/>
                            <DataGridTextColumn Header="Định dạng" Binding="{Binding BackupTypeFormatted}" Width="100" MinWidth="90"/>
                            <DataGridTemplateColumn Header="Lưu trữ Cloud" Width="Auto" MinWidth="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="4,2">
                                            <ItemsControl ItemsSource="{Binding CloudSyncList}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenCloudWebViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand" Margin="0,1,6,1"
                                                                ToolTip="{Binding TooltipText}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{Binding BadgeBackground}" 
                                                                            BorderBrush="{Binding BadgeBorder}" 
                                                                            BorderThickness="1" CornerRadius="5" 
                                                                            Padding="8,3">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <TextBlock Text="{Binding ActionButtonText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Thao tác" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                            <Button Content="📂 Mở" 
                                                    Command="{Binding DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SecondaryButtonStyle}" 
                                                    Padding="10,4" FontSize="11" Margin="0,0,8,0"
                                                    ToolTip="Mở thư mục chứa bản sao lưu này trên máy"/>

                                            <Button Content="🗑 Xóa" 
                                                    Command="{Binding DataContext.RequestDeleteHistoryDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}" 
                                                    Padding="10,4" FontSize="11"
                                                    ToolTip="Xóa bản snapshot này và xóa vĩnh viễn tệp dữ liệu trên đĩa"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Footer Action Bar -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="💾 Nạp vị trí save bản này" 
                            Command="{Binding LoadBackupPathsFromHistoryCommand}"
                            CommandParameter="{Binding SelectedHistoryDetail}"
                            Style="{StaticResource SuccessButtonStyle}"
                            Padding="16,8" Margin="0,0,8,0"/>

                    <Button Content="🔄 Khôi phục bản đã chọn" 
                            Command="{Binding OpenRestoreModalCommand}"
                            CommandParameter="{Binding SelectedHistoryDetail}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8" Margin="0,0,8,0"
                            ToolTip="Khôi phục lại dữ liệu save game từ bản snapshot đã chọn"/>

                    <Button Content="☁️ Cloud Sync bản đã chọn" 
                            Command="{Binding OpenSyncCloudSelectModalCommand}"
                            CommandParameter="{Binding SelectedHistoryDetail}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            BorderBrush="#0284C7" Foreground="#38BDF8"
                            Padding="16,8"
                            ToolTip="Chọn Cloud Provider (Google Drive / OneDrive) để tải lên"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Đóng" Command="{Binding CloseModalCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" Padding="22,8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="SaveGameBackup.UI.Views.Tabs.HistoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="0,14,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Danh sách game đã sao lưu (Tóm tắt mỗi game 1 dòng):" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="💡 Nhấp đúp vào dòng để xem chi tiết tất cả snapshot" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
        </Grid>

        <!-- History DataGrid (Master table: backup_history) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding GameHistories}"
                      SelectedItem="{Binding SelectedGameHistory}"
                      MouseDoubleClick="GameHistoryGrid_MouseDoubleClick"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="#131C2E" 
                      Foreground="White" 
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B"
                      RowBackground="#131C2E"
                      AlternatingRowBackground="#0F172A"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Tên Game" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="🎮" Margin="0,0,8,0" FontSize="14"/>
                                    <TextBlock Text="{Binding GameName}" FontWeight="Bold" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Số bản sao lưu" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding BackupCount, StringFormat='{}{0} bản'}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Lần sao lưu gần nhất" Binding="{Binding FormattedLatestDate}" Width="180"/>
                    <DataGridTextColumn Header="Dung lượng (Mới nhất)" Binding="{Binding FormattedLatestSize}" Width="160"/>
                    <DataGridTextColumn Header="Tổng dung lượng" Binding="{Binding FormattedTotalSize}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- History Action Toolbar -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Nhấp đúp vào dòng game hoặc bấm '📜 Chi tiết sao lưu' để xem và khôi phục các bản snapshot." 
                           VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding LoadBackupPathsFromHistoryCommand}"
                            CommandParameter="{Binding SelectedGameHistory}"
                            Style="{StaticResource SuccessButtonStyle}" 
                            Padding="14,6" Margin="0,0,8,0">
                        <TextBlock Text="💾 Sao lưu game đã chọn"/>
                    </Button>

                    <Button Command="{Binding OpenGameDetailsCommand}"
                            CommandParameter="{Binding SelectedGameHistory}"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,6" Margin="0,0,8,0">
                        <TextBlock Text="📜 Xem chi tiết game đã chọn"/>
                    </Button>

                    <Button Command="{Binding RequestDeleteGameHistoryCommand}"
                            CommandParameter="{Binding SelectedGameHistory}"
                            Style="{StaticResource DangerButtonStyle}" 
                            Padding="14,6">
                        <TextBlock Text="🗑 Xóa game đã chọn"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

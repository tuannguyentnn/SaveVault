<Window x:Class="SaveGameBackup.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveGameBackup.UI.ViewModels"
        mc:Ignorable="d"
        Title="SaveVault - Game Save Backup Tool (.NET 10 &amp; SQLite &amp; Cloud Sync)" 
        Height="950" Width="1400"
        MinHeight="950" MinWidth="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Green Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Item Modern Dark Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Icon Button Style -->
        <Style x:Key="SmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Close Icon Button Style -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#131C2E"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Header -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Game Save Backup" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text=".NET 10" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SQLite" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tự động tìm kiếm đường dẫn save game trên mạng và sao lưu trên máy" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats / Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lịch sử sao lưu:" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BackupHistory.Count}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="16,8,16,0">
            
            <!-- TAB 1: SEARCH & BACKUP -->
            <TabItem Header="🔍 Tìm kiếm &amp; Sao lưu">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,16">
                    <StackPanel>
                        
                        <!-- Search Box Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Nhập tên game để tìm kiếm vị trí save game:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Input -->
                                    <TextBox x:Name="SearchTextBox" 
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Height="44"
                                             Background="#0B0F19" 
                                             Foreground="White" 
                                             CaretBrush="#38BDF8"
                                             BorderBrush="#334155" 
                                             BorderThickness="1" 
                                             FontSize="15" 
                                             Padding="14,10"
                                             VerticalContentAlignment="Center"
                                             KeyDown="SearchTextBox_KeyDown"/>

                                    <!-- Search Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding SearchCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" 
                                            Margin="10,0,0,0" 
                                            Height="44" 
                                            Padding="20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔎" Margin="0,0,8,0"/>
                                            <TextBlock Text="Tìm kiếm &amp; Quét máy"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Quick Suggestions & Online Checkbox -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock Text="Gợi ý nhanh:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <WrapPanel>
                                        <Button Content="Elden Ring" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                        <Button Content="Cyberpunk 2077" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                        <Button Content="Black Myth: Wukong" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                        <Button Content="Baldur's Gate 3" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                        <Button Content="The Witcher 3" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                        <Button Content="Hades" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Game Search & Detection Result Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Thông tin &amp; Vị trí Save Game" FontSize="16" FontWeight="Bold"/>
                                        
                                        <!-- Source Badge -->
                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" 
                                                Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding CurrentGame.Source, StringFormat='Nguồn: {0}'}" FontSize="11" Foreground="#A7F3D0"/>
                                        </Border>

                                        <!-- Steam AppId Badge -->
                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" 
                                                Visibility="{Binding CurrentGame.SteamAppId, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding CurrentGame.SteamAppId, StringFormat='Steam AppID: {0}'}" FontSize="11" Foreground="#93C5FD"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Add Custom Path Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding AddCustomPathCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="10,4" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" Margin="0,0,6,0"/>
                                            <TextBlock Text="Chọn thư mục thủ công"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Detection Status Banner -->
                                <Border Margin="0,0,0,14" CornerRadius="8" Padding="14,10"
                                        Background="#1E293B">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="📁" 
                                                   FontSize="20" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0"/>

                                        <!-- Status Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentGame.GameName, FallbackValue='Chưa chọn game nào'}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Size and Files Info -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SelectedSizeFormatted}" FontSize="16" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding SelectedFileCount, StringFormat='{}{0} tệp đã chọn'}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Detected Paths List Header -->
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Thư mục save phát hiện trên máy tính:" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Đã chọn: " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding SelectedPathCount}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="/" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding DetectedPathItems.Count}" FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text=" vị trí" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Quick Selection Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding SelectAllPathsCommand}" 
                                                Content="✓ Chọn tất cả" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Padding="10,3" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Command="{Binding DeselectAllPathsCommand}" 
                                                Content="✕ Bỏ chọn hết" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Padding="10,3" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Detected Paths CheckBox List Container -->
                                <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" MinHeight="65" MaxHeight="220" Padding="6">
                                    <Grid>
                                        <!-- Empty Placeholder Message -->
                                        <TextBlock Text="Chưa phát hiện thư mục save nào trên máy tính. Bạn có thể nhấn '📁 Chọn thư mục thủ công' ở góc trên để thêm vị trí lưu." 
                                                   Foreground="#64748B" FontSize="12" FontStyle="Italic"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10"
                                                   Visibility="{Binding HasNoDetectedPaths, Converter={StaticResource BoolToVis}}"/>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasDetectedPaths, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding DetectedPathItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3" Cursor="Hand" MouseLeftButtonUp="DetectedPathItem_MouseLeftButtonUp">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#131C2E"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#1E293B"/>
                                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Selection Checkbox -->
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                                          VerticalAlignment="Center" 
                                                                          Cursor="Hand"
                                                                          Margin="0,0,12,0"/>

                                                                <!-- Path Details -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                        <TextBlock Text="📁 " FontSize="12"/>
                                                                        <TextBlock Text="{Binding Path}" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Badges: File Count & Size -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding FileCount, StringFormat='{}{0} tệp'}" FontSize="11" Foreground="#94A3B8"/>
                                                                    </Border>
                                                                    <Border Background="#0F172A" CornerRadius="4" Padding="6,2">
                                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Online Reference Patterns -->
                                <Expander Header="Xem các định dạng đường dẫn tra cứu từ mạng / wiki" Foreground="#64748B" FontSize="12" Margin="0,10,0,0">
                                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding OnlinePatternsList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Mode=OneWay, StringFormat='• {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Action & Execution Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Tùy chọn &amp; Thực hiện Sao lưu" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Destination Directory -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Thư mục gốc lưu Backup:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding BackupDestinationRoot, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0F19" Foreground="White" BorderBrush="#334155" 
                                                 Padding="10,8" Height="36" FontSize="12" IsReadOnly="True"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" 
                                            Command="{Binding BrowseBackupDirectoryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            VerticalAlignment="Bottom" 
                                            Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="Duyệt thư mục..."/>
                                    </Button>
                                </Grid>

                                <!-- Checkboxes -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <CheckBox IsChecked="{Binding CreateTimestampSubfolder}" 
                                              Content="Tạo thư mục con kèm ngày giờ (Snapshot)" 
                                              Foreground="#E2E8F0" Margin="0,0,24,0"/>

                                    <CheckBox IsChecked="{Binding AutoCompressZip}" 
                                              Content="Nén thành file .ZIP tiết kiệm dung lượng" 
                                              Foreground="#E2E8F0"/>
                                </StackPanel>

                                <!-- Progress Bar -->
                                <StackPanel Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding BackupProgressText}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BackupProgressPercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding BackupProgressPercent}" Maximum="100" Height="8" Background="#1E293B" Foreground="#38BDF8"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Big Backup Now Button -->
                                    <Button Command="{Binding BackupCommand}"
                                            Style="{StaticResource SuccessButtonStyle}" 
                                            Height="48" FontSize="16" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SAO LƯU NGAY (BACKUP NOW)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Open Source Folder Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding OpenSourceFolderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="48" Padding="16,0" Margin="0,0,8,0">
                                        <TextBlock Text="📂 Mở vị trí Save gốc"/>
                                    </Button>

                                    <!-- Open Backup Folder Button -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding OpenBackupFolderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="48" Padding="16,0">
                                        <TextBlock Text="📦 Mở thư mục Backup"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: BACKUP HISTORY -->
            <TabItem Header="📋 Lịch sử sao lưu">
                <Grid Margin="0,14,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Danh sách game đã sao lưu (Tóm tắt mỗi game 1 dòng):" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="💡 Nhấp đúp vào dòng để xem chi tiết tất cả snapshot" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- History DataGrid (Master table: backup_history) -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding GameHistories}"
                                  SelectedItem="{Binding SelectedGameHistory}"
                                  MouseDoubleClick="GameHistoryGrid_MouseDoubleClick"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="#131C2E" 
                                  Foreground="White" 
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B"
                                  RowBackground="#131C2E"
                                  AlternatingRowBackground="#0F172A"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column">
                            
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tên Game" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="🎮" Margin="0,0,8,0" FontSize="14"/>
                                                <TextBlock Text="{Binding GameName}" FontWeight="Bold" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Số bản sao lưu" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding BackupCount, StringFormat='{}{0} bản'}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Lần sao lưu gần nhất" Binding="{Binding FormattedLatestDate}" Width="160"/>
                                <DataGridTextColumn Header="Dung lượng (Mới nhất)" Binding="{Binding FormattedLatestSize}" Width="150"/>
                                <DataGridTextColumn Header="Tổng dung lượng" Binding="{Binding FormattedTotalSize}" Width="130"/>

                                <DataGridTemplateColumn Header="Thao tác" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,4">
                                                <Button Content="💾 Sao lưu" 
                                                        Command="{Binding DataContext.LoadBackupPathsFromHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SuccessButtonStyle}" 
                                                        Padding="10,4" FontSize="11" Margin="0,0,8,0"
                                                        ToolTip="Nạp danh sách vị trí save từ trường save_paths của game để chuẩn bị sao lưu ngay (không cần tìm kiếm lại)"/>

                                                <Button Content="📜 Chi tiết sao lưu" 
                                                        Command="{Binding DataContext.OpenGameDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}" 
                                                        Padding="10,4" FontSize="11" Margin="0,0,8,0"/>

                                                <Button Content="🗑 Xóa game" 
                                                        Command="{Binding DataContext.RequestDeleteGameHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButtonStyle}" 
                                                        Padding="10,4" FontSize="11"
                                                        ToolTip="Xóa toàn bộ lịch sử và tất cả các tệp sao lưu trên đĩa của game này"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- History Action Toolbar -->
                    <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Nhấp đúp vào dòng game hoặc bấm '📜 Chi tiết sao lưu' để xem và khôi phục các bản snapshot." 
                                       VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding LoadBackupPathsFromHistoryCommand}"
                                        CommandParameter="{Binding SelectedGameHistory}"
                                        Style="{StaticResource SuccessButtonStyle}" 
                                        Padding="14,6" Margin="0,0,8,0">
                                    <TextBlock Text="💾 Sao lưu game đã chọn"/>
                                </Button>

                                <Button Command="{Binding OpenGameDetailsCommand}"
                                        CommandParameter="{Binding SelectedGameHistory}"
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="14,6" Margin="0,0,8,0">
                                    <TextBlock Text="📜 Xem chi tiết game đã chọn"/>
                                </Button>

                                <Button Command="{Binding RequestDeleteGameHistoryCommand}"
                                        CommandParameter="{Binding SelectedGameHistory}"
                                        Style="{StaticResource DangerButtonStyle}" 
                                        Padding="14,6">
                                    <TextBlock Text="🗑 Xóa game đã chọn"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="⚙️ Cài đặt">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,16">
                    <StackPanel MaxWidth="750" HorizontalAlignment="Left">
                        
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Sao lưu mặc định" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                                <TextBlock Text="Thư mục lưu trữ sao lưu mặc định:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding BackupDestinationRoot, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#0B0F19" Foreground="White" BorderBrush="#334155" 
                                             Padding="10,8" Height="36" FontSize="13"/>

                                    <Button Grid.Column="1" 
                                            Command="{Binding BrowseBackupDirectoryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="Chọn..."/>
                                    </Button>
                                </Grid>

                                <CheckBox IsChecked="{Binding CreateTimestampSubfolder}" 
                                          Content="Tự động tạo thư mục con theo thời gian (Snapshot)" 
                                          Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding AutoCompressZip}" 
                                          Content="Tự động nén thành file .zip" 
                                          Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,16"/>

                                <Button Command="{Binding SaveSettingsCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        HorizontalAlignment="Left" Padding="20,10">
                                    <TextBlock Text="💾 Lưu cài đặt"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Storage Configuration Card (REST API) -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="☁️ " FontSize="18"/>
                                        <TextBlock Text="Kết nối Lưu trữ Đám mây (Cloud REST API)" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Cloud Auth Status Badge -->
                                    <Border Grid.Column="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCloudLoggedIn}" Value="True">
                                                        <Setter Property="Background" Value="#064E3B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⚠️ Chưa kết nối"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCloudLoggedIn}" Value="True">
                                                            <Setter Property="Text" Value="✓ Đã kết nối"/>
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Chọn nhà cung cấp dịch vụ Cloud để đồng bộ:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,8"/>

                                <!-- Provider Selector ComboBox -->
                                <ComboBox SelectedIndex="{Binding SelectedCloudProviderIndex, Mode=TwoWay}"
                                          Height="38" FontSize="13" Margin="0,0,0,14"
                                          Background="#0B0F19" Foreground="White" BorderBrush="#334155"
                                          Padding="10,6">
                                    <ComboBoxItem Content="☁️ Google Drive (Google Drive v3 REST API)" IsSelected="True"/>
                                    <ComboBoxItem Content="☁️ Microsoft OneDrive (Microsoft Graph REST API)"/>
                                </ComboBox>

                                <!-- Account Connection Info Box -->
                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveCloudProviderName, StringFormat='Dịch vụ đang chọn: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding CloudAccountEmail, StringFormat='Tài khoản: {0}', TargetNullValue='Chưa đăng nhập tài khoản nào.'}" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🔑 Kết nối tài khoản"
                                                    Command="{Binding ConnectCloudAccountCommand}"
                                                    Visibility="{Binding IsCloudLoggedOut, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" FontSize="12"/>

                                            <Button Content="🚪 Đăng xuất"
                                                    Command="{Binding DisconnectCloudAccountCommand}"
                                                    Visibility="{Binding IsCloudLoggedIn, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource SecondaryButtonStyle}" BorderBrush="#EF4444" Foreground="#F87171"
                                                    Padding="16,8" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Cloud API Credentials Configuration -->
                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="⚙️ Cấu hình API Credentials (Client ID)" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Cần thiết lập khóa ứng dụng để kết nối trực tiếp với tài khoản Cloud của bạn." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding OpenAzurePortalGuideCommand}"
                                                    Visibility="{Binding IsOneDriveSelected, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="12,4" FontSize="11" Height="30">
                                                <TextBlock Text="🌐 Mở Azure Portal"/>
                                            </Button>
                                        </Grid>

                                        <!-- OneDrive Fields -->
                                        <StackPanel Visibility="{Binding IsOneDriveSelected, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="OneDrive Application (Client) ID:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding OneDriveClientId, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155"
                                                     Padding="10,6" Height="34" FontSize="12" Margin="0,0,0,8"/>

                                            <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="📌 Cách tạo Client ID OneDrive miễn phí trong 1 phút:" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                                    <TextBlock Text="1. Đăng nhập portal.azure.com bằng tài khoản Microsoft cá nhân (hoặc bấm nút '🌐 Mở Azure Portal')." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                    <TextBlock Text="2. Vào 'App registrations' > nhấn 'New registration' > Đặt tên (vd: SaveVault)." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                    <TextBlock Text="3. Supported account types: Chọn 'Accounts in any organizational directory and personal Microsoft accounts'." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                    <TextBlock Text="4. Redirect URI: Chọn platform 'Mobile and desktop applications' > tích chọn hoặc nhập: http://localhost" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                    <TextBlock Text="5. Nhấn 'Register', copy 'Application (client) ID' dán vào ô trên và bấm 'Lưu cấu hình API'." FontSize="11" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Google Drive Fields -->
                                        <StackPanel Visibility="{Binding IsGoogleDriveSelected, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Google Drive OAuth Client ID:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding GoogleDriveClientId, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155"
                                                     Padding="10,6" Height="34" FontSize="12" Margin="0,0,0,8"/>

                                            <TextBlock Text="Google Drive OAuth Client Secret:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding GoogleDriveClientSecret, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155"
                                                     Padding="10,6" Height="34" FontSize="12" Margin="0,0,0,10"/>
                                        </StackPanel>

                                        <Button Command="{Binding SaveCloudApiSettingsCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left" Padding="16,6" Height="32" FontSize="12">
                                            <TextBlock Text="💾 Lưu cấu hình API Credentials"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 Cơ chế sao lưu Cloud REST API:" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Tải lên và tải về qua API chính thức, hoàn toàn độc lập, không cần cài Google Drive hoặc OneDrive desktop." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Backup thường sẽ lưu cục bộ trên máy. Để đưa bản lưu lên Cloud: Vào tab '📜 Lịch sử', chọn game và nhấn nút '☁️ Cloud Sync'." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Khi khôi phục bản save đã sync Cloud, hệ thống sẽ cho bạn tùy chọn tải từ Cloud hoặc dùng bản local." FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Database Info Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Cơ sở dữ liệu SQLite" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="Đường dẫn file cơ sở dữ liệu SQLite (.db):" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding DatabaseLocation, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155" 
                                             Padding="10,8" Height="36" FontSize="13"/>

                                    <Button Grid.Column="1" 
                                             Command="{Binding BrowseDatabaseFileCommand}"
                                             Style="{StaticResource SecondaryButtonStyle}" 
                                             Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="📂 Duyệt file..."/>
                                    </Button>

                                    <Button Grid.Column="2" 
                                             Command="{Binding ResetDatabaseLocationCommand}"
                                             Style="{StaticResource SecondaryButtonStyle}" 
                                             Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="Mặc định"/>
                                    </Button>
                                </Grid>

                                <Button Command="{Binding ApplyDatabaseLocationCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        HorizontalAlignment="Left" Padding="20,10" Margin="0,0,0,14">
                                    <TextBlock Text="💾 Đổi &amp; Lưu đường dẫn DB"/>
                                </Button>

                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 Ghi chú cấu hình:" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Đường dẫn mặc định đặt tại thư mục gốc của dự án (save_backup.db)." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Cấu hình được ghi nhớ trong file app_config.json để tự động sử dụng cho các lần khởi động sau." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Khi đổi sang file mới, hệ thống tự động khởi tạo bảng dữ liệu và nạp lại lịch sử sao lưu." FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái: " FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="SaveGameBackup v1.0 • .NET 10" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- IN-APP MODAL OVERLAY (DIMMED BACKDROP & IN-APP DIALOGS)             -->
        <!-- =================================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000"
              Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}">
            
            <!-- Dim Backdrop -->
            <Border Background="#D9050914">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseModalCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- MODAL 1: CHI TIẾT LỊCH SỬ SAO LƯU GAME (CurrentHistoryDetails) -->
            <Border Visibility="{Binding IsHistoryDetailsModalOpen, Converter={StaticResource BoolToVis}}"
                    Width="820" MaxHeight="620"
                    Background="#101726" BorderBrush="#2563EB" BorderThickness="1.5"
                    CornerRadius="12" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" Color="#000000" Opacity="0.85" ShadowDepth="10"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Lịch sử sao lưu: " FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding SelectedGameHistory.GameName}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                                <TextBlock Text="Danh sách toàn bộ các bản snapshot sao lưu được tải trực tiếp từ cơ sở dữ liệu" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseModalCommand}" Style="{StaticResource CloseIconButtonStyle}"/>
                    </Grid>

                    <!-- Quick Summary Stats Bar -->
                    <Border Grid.Row="1" Background="#172238" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TỔNG SỐ BẢN BACKUP" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedGameHistory.BackupCount, StringFormat='{}{0} bản ghi'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BẢN MỚI NHẤT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedGameHistory.FormattedLatestDate}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TỔNG DUNG LƯỢNG" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedGameHistory.FormattedTotalSize}" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Snapshots List (Detail table: backup_history_details) -->
                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="0" MinHeight="180" MaxHeight="340">
                        <Grid>
                            <DataGrid ItemsSource="{Binding CurrentHistoryDetails}"
                                      SelectedItem="{Binding SelectedHistoryDetail}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Background="Transparent" 
                                      Foreground="White" 
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#1E293B"
                                      RowBackground="#0E1524"
                                      AlternatingRowBackground="#0B0F19"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column">
                                
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding BackupDate, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="150" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Dung lượng" Binding="{Binding FormattedSize}" Width="100"/>
                                    <DataGridTextColumn Header="Số file" Binding="{Binding FileCount}" Width="70"/>
                                    <DataGridTextColumn Header="Định dạng" Binding="{Binding BackupTypeFormatted}" Width="90"/>
                                    <DataGridTemplateColumn Header="Cloud" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Visibility="{Binding IsCloudSynced, Converter={StaticResource BoolToVis}}"
                                                            Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1"
                                                            CornerRadius="4" Padding="6,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="☁️" FontSize="11" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding CloudProvider, FallbackValue='Cloud'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Thao tác" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                                    <Button Content="💾 Sao lưu" 
                                                            Command="{Binding DataContext.LoadBackupPathsFromHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SuccessButtonStyle}" 
                                                            Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                            ToolTip="Nạp các vị trí save của bản snapshot này vào tab Sao lưu"/>

                                                    <Button Content="🔄 Khôi phục" 
                                                            Command="{Binding DataContext.OpenRestoreModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}" 
                                                            Padding="10,4" FontSize="11" Margin="0,0,6,0"/>

                                                    <Button Content="☁️ Cloud Sync" 
                                                            Command="{Binding DataContext.SyncSelectedDetailToCloudCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}" 
                                                            BorderBrush="#0284C7" Foreground="#38BDF8"
                                                            Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                            ToolTip="Đồng bộ snapshot này lên Google Drive hoặc OneDrive qua REST API"/>

                                                    <Button Content="📂 Mở" 
                                                            Command="{Binding DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource SecondaryButtonStyle}" 
                                                            Padding="8,4" FontSize="11" Margin="0,0,6,0"/>

                                                    <Button Content="🗑 Xóa" 
                                                            Command="{Binding DataContext.RequestDeleteHistoryDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButtonStyle}" 
                                                            Padding="8,4" FontSize="11"
                                                            ToolTip="Xóa bản snapshot này và xóa vĩnh viễn tệp dữ liệu trên đĩa"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Cloud Sync Progress Bar Overlay inside Details Modal -->
                            <Border VerticalAlignment="Bottom" Margin="8" 
                                    Background="#101726" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="12,8"
                                    Visibility="{Binding IsCloudSyncing, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☁️ " FontSize="12"/>
                                            <TextBlock Text="{Binding CloudSyncProgressText}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CloudSyncProgressPercent, StringFormat='{}{0}%'}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding CloudSyncProgressPercent}" Maximum="100" Height="7" Foreground="#0284C7" Background="#1E293B" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Footer Action Bar -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 Nạp vị trí save bản này" 
                                    Command="{Binding LoadBackupPathsFromHistoryCommand}"
                                    CommandParameter="{Binding SelectedHistoryDetail}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="16,8" Margin="0,0,8,0"/>

                            <Button Content="☁️ Cloud Sync bản đã chọn" 
                                    Command="{Binding SyncSelectedDetailToCloudCommand}"
                                    CommandParameter="{Binding SelectedHistoryDetail}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    BorderBrush="#0284C7" Foreground="#38BDF8"
                                    Padding="16,8"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Đóng" Command="{Binding CloseModalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" Padding="22,8"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- MODAL 2: IN-APP RESTORE MODAL -->
            <Border Visibility="{Binding IsRestoreModalOpen, Converter={StaticResource BoolToVis}}"
                    Width="820" MaxHeight="660"
                    Background="#101726" BorderBrush="#059669" BorderThickness="1.5"
                    CornerRadius="12" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" Color="#000000" Opacity="0.85" ShadowDepth="10"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Khôi phục Save Game: " FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding ActiveRestoreDetail.GameName, TargetNullValue=''}" FontSize="18" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="{Binding ActiveRestoreRecord.GameName, TargetNullValue=''}" FontSize="18" FontWeight="Bold" Foreground="#34D399"/>
                                    <!-- Cloud Source Badge -->
                                    <Border Visibility="{Binding ActiveRestoreFromCloud, Converter={StaticResource BoolToVis}}"
                                            Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="☁️ Nguồn Cloud" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveRestoreDetail.BackupDate, StringFormat='Bản snapshot lưu lúc: {0:dd/MM/yyyy HH:mm:ss}', TargetNullValue=''}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ActiveRestoreRecord.BackupDate, StringFormat='Bản snapshot lưu lúc: {0:dd/MM/yyyy HH:mm:ss}', TargetNullValue=''}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseRestoreModalCommand}" Style="{StaticResource CloseIconButtonStyle}"/>
                    </Grid>

                    <!-- Options Bar -->
                    <Border Grid.Row="1" Background="#172554" BorderBrush="#1E40AF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡 Bấm vào từng dòng để chọn/bỏ chọn. Kiểm tra thư mục đích trước khi bấm Khôi phục." 
                                       FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Content="✓ Chọn tất cả" Command="{Binding ModalSelectAllRestoreItemsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="✕ Bỏ chọn hết" Command="{Binding ModalDeselectAllRestoreItemsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="↺ Đặt lại đích" Command="{Binding ModalResetRestorePathsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Restore Items List with Row Click -->
                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8" MaxHeight="330">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActiveRestoreItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3"
                                                Cursor="Hand" MouseLeftButtonUp="RestoreItem_MouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#131C2E"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                            <Setter Property="BorderBrush" Value="#34D399"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CheckBox -->
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Content Info & Destination Path -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📁 " FontSize="12"/>
                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                                        <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" Foreground="#34D399" FontSize="11" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding OriginalSourcePath, StringFormat='Gốc: {0}'}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

                                                    <!-- Destination Directory Input -->
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding RestoreDestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="#0B0F19" Foreground="#E2E8F0" BorderBrush="#334155"
                                                                 Padding="6,3" FontSize="11" Height="26" VerticalContentAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="Duyệt..."
                                                                Command="{Binding DataContext.ModalBrowseRestoreDestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8,2" FontSize="10" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Size Info Badge -->
                                                <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Progress Bar (while restoring) -->
                    <Border Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding IsModalRestoring, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ProgressBar Value="{Binding ModalRestoreProgressPercent}" Height="6" Foreground="#10B981" Background="#1E293B" BorderThickness="0"/>
                            <TextBlock Text="{Binding ModalRestoreProgressMessage}" FontSize="11" Foreground="#34D399" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer Action Bar -->
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ModalRestoreSelectedCountText}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Hủy bỏ" Command="{Binding CloseRestoreModalCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8" Margin="0,0,8,0"/>

                            <Button Content="🔄 Xác nhận Khôi phục" Command="{Binding ModalRestoreConfirmCommand}"
                                    IsEnabled="{Binding CanConfirmModalRestore}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="18,8"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- MODAL 3: IN-APP CONFIRMATION DIALOG (THEME-MATCHED DARK DIALOG) -->
            <Border Visibility="{Binding IsConfirmModalOpen, Converter={StaticResource BoolToVis}}"
                    Width="500" MaxWidth="520"
                    Background="#101726" BorderBrush="#EF4444" BorderThickness="1.5"
                    CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.95" ShadowDepth="14"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="20" Width="42" Height="42" Margin="0,0,14,0">
                            <TextBlock Text="🗑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfirmModalTitle}" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Cảnh báo: Thao tác này sẽ xóa vĩnh viễn dữ liệu trên đĩa!" FontSize="11" Foreground="#EF4444" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Message Body -->
                    <TextBlock Grid.Row="1" Text="{Binding ConfirmModalMessage}" 
                               Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>

                    <!-- Target File/Folder Info Box -->
                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ĐƯỜNG DẪN DỮ LIỆU BỊ XÓA VĨNH VIỄN:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ConfirmModalTargetPath}" Foreground="#F87171" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas, Courier New"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud Deletion Option CheckBox -->
                    <CheckBox Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                              IsChecked="{Binding DeleteAlsoFromCloud, Mode=TwoWay}"
                              Visibility="{Binding ShowDeleteCloudOption, Converter={StaticResource BoolToVis}}"
                              Content="☁️ Đồng thời xóa luôn tệp sao lưu trên Cloud" 
                              Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>

                    <!-- Deleting Progress Bar -->
                    <Border Grid.Row="3" Background="#0B0F19" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,14"
                            Visibility="{Binding IsConfirmModalDeleting, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding ConfirmModalProgressText}" Foreground="#F87171" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ConfirmModalProgressPercent, StringFormat='{}{0}%'}" Foreground="#F87171" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding ConfirmModalProgressPercent}" Maximum="100" Height="6" Foreground="#EF4444" Background="#1E293B" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons Action Bar -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="✕ Hủy bỏ" 
                                Command="{Binding CancelConfirmModalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left" Padding="20,9" FontSize="13"/>

                        <Button Grid.Column="1" Content="🗑 Xác nhận xóa vĩnh viễn" 
                                Command="{Binding ConfirmModalExecuteCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="20,9" FontSize="13" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- MODAL 4: UNIVERSAL IN-APP MESSAGE POPUP (DARK THEME POPUP) -->
            <Border Visibility="{Binding IsMessageModalOpen, Converter={StaticResource BoolToVis}}"
                    Width="520" MaxWidth="560" MaxHeight="620"
                    Background="#101726" BorderThickness="1.5"
                    CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageModalType}" Value="Success">
                                <Setter Property="BorderBrush" Value="#34D399"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageModalType}" Value="Warning">
                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageModalType}" Value="Error">
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageModalType}" Value="Info">
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.95" ShadowDepth="14"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with dynamic icon & title -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Dynamic Icon Badge -->
                        <Border Width="42" Height="42" CornerRadius="21" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#082F49"/>
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageModalType}" Value="Success">
                                            <Setter Property="Background" Value="#064E3B"/>
                                            <Setter Property="BorderBrush" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MessageModalType}" Value="Warning">
                                            <Setter Property="Background" Value="#451A03"/>
                                            <Setter Property="BorderBrush" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MessageModalType}" Value="Error">
                                            <Setter Property="Background" Value="#450A0A"/>
                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="ℹ️"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageModalType}" Value="Success">
                                                <Setter Property="Text" Value="✓"/>
                                                <Setter Property="Foreground" Value="#34D399"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MessageModalType}" Value="Warning">
                                                <Setter Property="Text" Value="⚠️"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MessageModalType}" Value="Error">
                                                <Setter Property="Text" Value="✕"/>
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Title Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MessageModalTitle}" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{Binding MessageModalType, StringFormat='Thông báo hệ thống ({0})'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Close 'X' button -->
                        <Button Grid.Column="2" Command="{Binding CloseMessageModalCommand}" Style="{StaticResource CloseIconButtonStyle}"/>
                    </Grid>

                    <!-- Message Content -->
                    <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <TextBlock Text="{Binding MessageModalContent}" 
                                   Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </ScrollViewer>

                    <!-- Technical Details Box (Visible if details present) -->
                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18"
                            Visibility="{Binding HasMessageModalDetails, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding MessageModalDetails}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas, Courier New"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Button -->
                    <Button Grid.Row="3" Content="✓ Đã hiểu" 
                            Command="{Binding CloseMessageModalCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right" Padding="26,9" FontSize="13"/>
                </Grid>
            </Border>

            <!-- MODAL 5: RESTORE SOURCE SELECTION MODAL (DARK THEME) -->
            <Border Visibility="{Binding IsRestoreSourceModalOpen, Converter={StaticResource BoolToVis}}"
                    Width="540" MaxWidth="560"
                    Background="#101726" BorderBrush="#0284C7" BorderThickness="1.5"
                    CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.95" ShadowDepth="14"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#082F49" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="21" Width="42" Height="42" Margin="0,0,14,0">
                            <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RestoreSourceModalTitle}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Bản sao lưu này đã được đồng bộ lên Cloud" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Message Description -->
                    <TextBlock Grid.Row="1" Text="{Binding RestoreSourceModalMessage}" 
                               Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18"/>

                    <!-- Selection Choices Card -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Local Option -->
                        <Border Grid.Column="0" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💻" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Khôi phục từ Máy" FontWeight="Bold" Foreground="White" FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock Text="Dùng file zip sao lưu cục bộ trên ổ đĩa máy tính." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12"/>
                                <Button Content="💻 Chọn Local" Command="{Binding ConfirmRestoreFromLocalCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Option -->
                        <Border Grid.Column="1" Background="#0C2540" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="☁️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Khôi phục từ Cloud" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tải trực tiếp bản zip mới nhất từ Cloud qua REST API." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12"/>
                                <Button Content="☁️ Chọn Cloud" Command="{Binding ConfirmRestoreFromCloudCommand}"
                                        Style="{StaticResource SuccessButtonStyle}" Background="#0284C7" Padding="16,8" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cancel Footer -->
                    <Button Grid.Row="3" Content="✕ Hủy bỏ" Command="{Binding CancelRestoreSourceModalCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center" Padding="22,7" FontSize="12"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>

<Window x:Class="SaveGameBackup.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveGameBackup.UI.ViewModels"
        mc:Ignorable="d"
        Title="Game Save Backup Tool (.NET 10 &amp; SQLite)" 
        Height="780" Width="1050"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Green Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Item Modern Dark Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Icon Button Style -->
        <Style x:Key="SmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Close Icon Button Style -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#131C2E"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Header -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Game Save Backup" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text=".NET 10" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SQLite" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tự động tìm kiếm đường dẫn save game trên mạng và sao lưu trên máy" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats / Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lịch sử sao lưu:" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BackupHistory.Count}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="16,8,16,0">
            
            <!-- TAB 1: SEARCH & BACKUP -->
            <TabItem Header="🔍 Tìm kiếm &amp; Sao lưu">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,16">
                    <StackPanel>
                        
                        <!-- Search Box Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Nhập tên game để tìm kiếm vị trí save game:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Input -->
                                    <TextBox x:Name="SearchTextBox" 
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Height="44"
                                             Background="#0B0F19" 
                                             Foreground="White" 
                                             CaretBrush="#38BDF8"
                                             BorderBrush="#334155" 
                                             BorderThickness="1" 
                                             FontSize="15" 
                                             Padding="14,10"
                                             VerticalContentAlignment="Center"
                                             KeyDown="SearchTextBox_KeyDown"/>

                                    <!-- Search Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding SearchCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" 
                                            Margin="10,0,0,0" 
                                            Height="44" 
                                            Padding="20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔎" Margin="0,0,8,0"/>
                                            <TextBlock Text="Tìm kiếm &amp; Quét máy"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Quick Suggestions & Online Checkbox -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Gợi ý nhanh:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <WrapPanel>
                                            <Button Content="Elden Ring" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                            <Button Content="Cyberpunk 2077" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                            <Button Content="Black Myth: Wukong" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                            <Button Content="Baldur's Gate 3" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                            <Button Content="The Witcher 3" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                            <Button Content="Hades" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SuggestionButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <CheckBox Grid.Column="1" 
                                              IsChecked="{Binding ForceOnlineSearch}" 
                                              Content="Buộc tìm mới trên mạng (PCGamingWiki)" 
                                              Foreground="#94A3B8" 
                                              FontSize="12" 
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Game Search & Detection Result Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Thông tin &amp; Vị trí Save Game" FontSize="16" FontWeight="Bold"/>
                                        
                                        <!-- Source Badge -->
                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" 
                                                Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding CurrentGame.Source, StringFormat='Nguồn: {0}'}" FontSize="11" Foreground="#A7F3D0"/>
                                        </Border>

                                        <!-- Steam AppId Badge -->
                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" 
                                                Visibility="{Binding CurrentGame.SteamAppId, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding CurrentGame.SteamAppId, StringFormat='Steam AppID: {0}'}" FontSize="11" Foreground="#93C5FD"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Add Custom Path Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding AddCustomPathCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="10,4" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" Margin="0,0,6,0"/>
                                            <TextBlock Text="Chọn thư mục thủ công"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Detection Status Banner -->
                                <Border Margin="0,0,0,14" CornerRadius="8" Padding="14,10"
                                        Background="#1E293B">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="📁" 
                                                   FontSize="20" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0"/>

                                        <!-- Status Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentGame.GameName, FallbackValue='Chưa chọn game nào'}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Size and Files Info -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SelectedSizeFormatted}" FontSize="16" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding SelectedFileCount, StringFormat='{}{0} tệp đã chọn'}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Detected Paths List Header -->
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Thư mục save phát hiện trên máy tính:" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Đã chọn: " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding SelectedPathCount}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="/" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding DetectedPathItems.Count}" FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text=" vị trí" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Quick Selection Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding SelectAllPathsCommand}" 
                                                Content="✓ Chọn tất cả" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Padding="10,3" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Command="{Binding DeselectAllPathsCommand}" 
                                                Content="✕ Bỏ chọn hết" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Padding="10,3" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Detected Paths CheckBox List Container -->
                                <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" MinHeight="65" MaxHeight="220" Padding="6">
                                    <Grid>
                                        <!-- Empty Placeholder Message -->
                                        <TextBlock Text="Chưa phát hiện thư mục save nào trên máy tính. Bạn có thể nhấn '📁 Chọn thư mục thủ công' ở góc trên để thêm vị trí lưu." 
                                                   Foreground="#64748B" FontSize="12" FontStyle="Italic"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10"
                                                   Visibility="{Binding HasNoDetectedPaths, Converter={StaticResource BoolToVis}}"/>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasDetectedPaths, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding DetectedPathItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3" Cursor="Hand" MouseLeftButtonUp="DetectedPathItem_MouseLeftButtonUp">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#131C2E"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#1E293B"/>
                                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Selection Checkbox -->
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                                          VerticalAlignment="Center" 
                                                                          Cursor="Hand"
                                                                          Margin="0,0,12,0"/>

                                                                <!-- Path Details -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                        <TextBlock Text="📁 " FontSize="12"/>
                                                                        <TextBlock Text="{Binding Path}" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Badges: File Count & Size -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding FileCount, StringFormat='{}{0} tệp'}" FontSize="11" Foreground="#94A3B8"/>
                                                                    </Border>
                                                                    <Border Background="#0F172A" CornerRadius="4" Padding="6,2">
                                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Online Reference Patterns -->
                                <Expander Header="Xem các định dạng đường dẫn tra cứu từ mạng / wiki" Foreground="#64748B" FontSize="12" Margin="0,10,0,0">
                                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding OnlinePatternsList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Mode=OneWay, StringFormat='• {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Action & Execution Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Tùy chọn &amp; Thực hiện Sao lưu" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Destination Directory -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Thư mục gốc lưu Backup:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding BackupDestinationRoot, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0F19" Foreground="White" BorderBrush="#334155" 
                                                 Padding="10,8" Height="36" FontSize="12" IsReadOnly="True"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" 
                                            Command="{Binding BrowseBackupDirectoryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            VerticalAlignment="Bottom" 
                                            Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="Duyệt thư mục..."/>
                                    </Button>
                                </Grid>

                                <!-- Checkboxes -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <CheckBox IsChecked="{Binding CreateTimestampSubfolder}" 
                                              Content="Tạo thư mục con kèm ngày giờ (Snapshot)" 
                                              Foreground="#E2E8F0" Margin="0,0,24,0"/>

                                    <CheckBox IsChecked="{Binding AutoCompressZip}" 
                                              Content="Nén thành file .ZIP tiết kiệm dung lượng" 
                                              Foreground="#E2E8F0"/>
                                </StackPanel>

                                <!-- Progress Bar -->
                                <StackPanel Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                    <ProgressBar Value="{Binding BackupProgressPercent}" Maximum="100" Height="8" Background="#1E293B" Foreground="#38BDF8"/>
                                    <TextBlock Text="{Binding BackupProgressText}" FontSize="12" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Big Backup Now Button -->
                                    <Button Command="{Binding BackupCommand}"
                                            Style="{StaticResource SuccessButtonStyle}" 
                                            Height="48" FontSize="16" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SAO LƯU NGAY (BACKUP NOW)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Open Source Folder Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding OpenSourceFolderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="48" Padding="16,0" Margin="0,0,8,0">
                                        <TextBlock Text="📂 Mở vị trí Save gốc"/>
                                    </Button>

                                    <!-- Open Backup Folder Button -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding OpenBackupFolderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="48" Padding="16,0">
                                        <TextBlock Text="📦 Mở thư mục Backup"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: BACKUP HISTORY -->
            <TabItem Header="📋 Lịch sử sao lưu">
                <Grid Margin="0,14,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Danh sách game đã sao lưu (Tóm tắt mỗi game 1 dòng):" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="💡 Nhấp đúp vào dòng để xem chi tiết tất cả snapshot" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- History DataGrid (Grouped by Game) -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding GroupedBackupHistory}"
                                  SelectedItem="{Binding SelectedGameSummary}"
                                  MouseDoubleClick="GameHistoryGrid_MouseDoubleClick"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="#131C2E" 
                                  Foreground="White" 
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B"
                                  RowBackground="#131C2E"
                                  AlternatingRowBackground="#0F172A"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column">
                            
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tên Game" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="🎮" Margin="0,0,8,0" FontSize="14"/>
                                                <TextBlock Text="{Binding GameName}" FontWeight="Bold" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Số bản sao lưu" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding BackupCount, StringFormat='{}{0} bản'}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Lần sao lưu gần nhất" Binding="{Binding FormattedLatestDate}" Width="160"/>
                                <DataGridTextColumn Header="Dung lượng (Mới nhất)" Binding="{Binding FormattedLatestSize}" Width="150"/>
                                <DataGridTextColumn Header="Tổng dung lượng" Binding="{Binding FormattedTotalSize}" Width="130"/>

                                <DataGridTemplateColumn Header="Thao tác" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,4">
                                                <Button Content="💾 Sao lưu" 
                                                        Command="{Binding DataContext.LoadBackupPathsForGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SuccessButtonStyle}" 
                                                        Padding="10,4" FontSize="11" Margin="0,0,8,0"
                                                        ToolTip="Nạp danh sách vị trí save từ bản sao lưu gần nhất để chuẩn bị sao lưu ngay (không cần tìm lại)"/>

                                                <Button Content="📜 Chi tiết sao lưu" 
                                                        Command="{Binding DataContext.OpenGameDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}" 
                                                        Padding="10,4" FontSize="11" Margin="0,0,8,0"/>

                                                <Button Content="🔄 Khôi phục mới nhất" 
                                                        Command="{Binding DataContext.OpenRestoreModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding LatestRecord}"
                                                        Style="{StaticResource PrimaryButtonStyle}" 
                                                        Padding="10,4" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- History Action Toolbar -->
                    <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Nhấp đúp vào dòng game hoặc bấm '📜 Chi tiết sao lưu' để xem và khôi phục các bản snapshot." 
                                       VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding LoadBackupPathsForGameCommand}"
                                        CommandParameter="{Binding SelectedGameSummary}"
                                        Style="{StaticResource SuccessButtonStyle}" 
                                        Padding="14,6" Margin="0,0,8,0">
                                    <TextBlock Text="💾 Sao lưu game đã chọn"/>
                                </Button>

                                <Button Command="{Binding OpenGameDetailsCommand}"
                                        CommandParameter="{Binding SelectedGameSummary}"
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="14,6" Margin="0,0,8,0">
                                    <TextBlock Text="📜 Xem chi tiết game đã chọn"/>
                                </Button>

                                <Button Command="{Binding OpenRestoreModalCommand}"
                                        CommandParameter="{Binding SelectedGameSummary.LatestRecord}"
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Padding="14,6">
                                    <TextBlock Text="🔄 Khôi phục bản mới nhất"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="⚙️ Cài đặt">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,16">
                    <StackPanel MaxWidth="750" HorizontalAlignment="Left">
                        
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Sao lưu mặc định" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                                <TextBlock Text="Thư mục lưu trữ sao lưu mặc định:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding BackupDestinationRoot, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#0B0F19" Foreground="White" BorderBrush="#334155" 
                                             Padding="10,8" Height="36" FontSize="13"/>

                                    <Button Grid.Column="1" 
                                            Command="{Binding BrowseBackupDirectoryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="Chọn..."/>
                                    </Button>
                                </Grid>

                                <CheckBox IsChecked="{Binding CreateTimestampSubfolder}" 
                                          Content="Tự động tạo thư mục con theo thời gian (Snapshot)" 
                                          Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding AutoCompressZip}" 
                                          Content="Tự động nén thành file .zip" 
                                          Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,16"/>

                                <Button Command="{Binding SaveSettingsCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        HorizontalAlignment="Left" Padding="20,10">
                                    <TextBlock Text="💾 Lưu cài đặt"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Database Info Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Cơ sở dữ liệu SQLite" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="Đường dẫn file cơ sở dữ liệu SQLite (.db):" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding DatabaseLocation, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155" 
                                             Padding="10,8" Height="36" FontSize="13"/>

                                    <Button Grid.Column="1" 
                                             Command="{Binding BrowseDatabaseFileCommand}"
                                             Style="{StaticResource SecondaryButtonStyle}" 
                                             Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="📂 Duyệt file..."/>
                                    </Button>

                                    <Button Grid.Column="2" 
                                             Command="{Binding ResetDatabaseLocationCommand}"
                                             Style="{StaticResource SecondaryButtonStyle}" 
                                             Margin="8,0,0,0" Height="36" Padding="14,0">
                                        <TextBlock Text="Mặc định"/>
                                    </Button>
                                </Grid>

                                <Button Command="{Binding ApplyDatabaseLocationCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        HorizontalAlignment="Left" Padding="20,10" Margin="0,0,0,14">
                                    <TextBlock Text="💾 Đổi &amp; Lưu đường dẫn DB"/>
                                </Button>

                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 Ghi chú cấu hình:" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Đường dẫn mặc định đặt tại thư mục gốc của dự án (save_backup.db)." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Cấu hình được ghi nhớ trong file app_config.json để tự động sử dụng cho các lần khởi động sau." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Khi đổi sang file mới, hệ thống tự động khởi tạo bảng dữ liệu và nạp lại lịch sử sao lưu." FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái: " FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="SaveGameBackup v1.0 • .NET 10" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- IN-APP MODAL OVERLAY (DIMMED BACKDROP & IN-APP DIALOGS)             -->
        <!-- =================================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000"
              Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}">
            
            <!-- Dim Backdrop -->
            <Border Background="#D9050914">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseModalCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- MODAL 1: CHI TIẾT LỊCH SỬ SAO LƯU GAME -->
            <Border Visibility="{Binding IsHistoryDetailsModalOpen, Converter={StaticResource BoolToVis}}"
                    Width="820" MaxHeight="620"
                    Background="#101726" BorderBrush="#2563EB" BorderThickness="1.5"
                    CornerRadius="12" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" Color="#000000" Opacity="0.85" ShadowDepth="10"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Lịch sử sao lưu: " FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding SelectedGameSummary.GameName}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                                <TextBlock Text="Danh sách toàn bộ các bản snapshot sao lưu đã tạo từ trước đến nay" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseModalCommand}" Style="{StaticResource CloseIconButtonStyle}"/>
                    </Grid>

                    <!-- Quick Summary Stats Bar -->
                    <Border Grid.Row="1" Background="#172238" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TỔNG SỐ BẢN BACKUP" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedGameSummary.BackupCount, StringFormat='{}{0} bản ghi'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BẢN MỚI NHẤT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedGameSummary.FormattedLatestDate}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TỔNG DUNG LƯỢNG" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedGameSummary.FormattedTotalSize}" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Snapshots List -->
                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="0" MinHeight="180" MaxHeight="340">
                        <DataGrid ItemsSource="{Binding SelectedGameSummary.Records}"
                                  SelectedItem="{Binding SelectedHistoryRecord}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="Transparent" 
                                  Foreground="White" 
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B"
                                  RowBackground="#0E1524"
                                  AlternatingRowBackground="#0B0F19"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column">
                            
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding BackupDate, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="160" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Dung lượng" Binding="{Binding FormattedSize}" Width="110"/>
                                <DataGridTextColumn Header="Số file" Binding="{Binding FileCount}" Width="80"/>
                                <DataGridTextColumn Header="Định dạng" Binding="{Binding BackupTypeFormatted}" Width="100"/>
                                <DataGridTemplateColumn Header="Thao tác" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                                <Button Content="💾 Sao lưu" 
                                                        Command="{Binding DataContext.LoadBackupPathsForGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SuccessButtonStyle}" 
                                                        Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                        ToolTip="Nạp các vị trí save từ bản snapshot này vào tab Sao lưu"/>

                                                <Button Content="🔄 Khôi phục" 
                                                        Command="{Binding DataContext.OpenRestoreModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButtonStyle}" 
                                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"/>

                                                <Button Content="📂 Mở" 
                                                        Command="{Binding DataContext.OpenRecordFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}" 
                                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"/>

                                                <Button Content="🗑 Xóa" 
                                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButtonStyle}" 
                                                        Padding="10,4" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Footer Action Bar -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="💾 Nạp vị trí save &amp; Chuẩn bị sao lưu game này" 
                                Command="{Binding LoadBackupPathsForGameCommand}"
                                CommandParameter="{Binding SelectedGameSummary}"
                                Style="{StaticResource SuccessButtonStyle}"
                                Padding="16,8"/>

                        <Button Grid.Column="1" Content="Đóng" Command="{Binding CloseModalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" Padding="22,8"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- MODAL 2: IN-APP RESTORE MODAL -->
            <Border Visibility="{Binding IsRestoreModalOpen, Converter={StaticResource BoolToVis}}"
                    Width="820" MaxHeight="660"
                    Background="#101726" BorderBrush="#059669" BorderThickness="1.5"
                    CornerRadius="12" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" Color="#000000" Opacity="0.85" ShadowDepth="10"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Khôi phục Save Game: " FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding ActiveRestoreRecord.GameName}" FontSize="18" FontWeight="Bold" Foreground="#34D399"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveRestoreRecord.BackupDate, StringFormat='Bản snapshot lưu lúc: {0:dd/MM/yyyy HH:mm:ss}'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseRestoreModalCommand}" Style="{StaticResource CloseIconButtonStyle}"/>
                    </Grid>

                    <!-- Options Bar -->
                    <Border Grid.Row="1" Background="#172554" BorderBrush="#1E40AF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡 Bấm vào từng dòng để chọn/bỏ chọn. Kiểm tra thư mục đích trước khi bấm Khôi phục." 
                                       FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Content="✓ Chọn tất cả" Command="{Binding ModalSelectAllRestoreItemsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="✕ Bỏ chọn hết" Command="{Binding ModalDeselectAllRestoreItemsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="↺ Đặt lại đích" Command="{Binding ModalResetRestorePathsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Restore Items List with Row Click -->
                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8" MaxHeight="330">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActiveRestoreItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3"
                                                Cursor="Hand" MouseLeftButtonUp="RestoreItem_MouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#131C2E"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                            <Setter Property="BorderBrush" Value="#34D399"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CheckBox -->
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Content Info & Destination Path -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📁 " FontSize="12"/>
                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                                        <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" Foreground="#34D399" FontSize="11" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding OriginalSourcePath, StringFormat='Gốc: {0}'}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

                                                    <!-- Destination Directory Input -->
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding RestoreDestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="#0B0F19" Foreground="#E2E8F0" BorderBrush="#334155"
                                                                 Padding="6,3" FontSize="11" Height="26" VerticalContentAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="Duyệt..."
                                                                Command="{Binding DataContext.ModalBrowseRestoreDestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8,2" FontSize="10" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Size Info Badge -->
                                                <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Progress Bar (while restoring) -->
                    <Border Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding IsModalRestoring, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ProgressBar Value="{Binding ModalRestoreProgressPercent}" Height="6" Foreground="#10B981" Background="#1E293B" BorderThickness="0"/>
                            <TextBlock Text="{Binding ModalRestoreProgressMessage}" FontSize="11" Foreground="#34D399" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer Action Bar -->
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ModalRestoreSelectedCountText}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Hủy bỏ" Command="{Binding CloseRestoreModalCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8" Margin="0,0,8,0"/>

                            <Button Content="🔄 Xác nhận Khôi phục" Command="{Binding ModalRestoreConfirmCommand}"
                                    IsEnabled="{Binding CanConfirmModalRestore}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="18,8"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>

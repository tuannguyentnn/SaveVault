<Window x:Class="SaveGameBackup.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveGameBackup.UI.ViewModels"
        xmlns:tabs="clr-namespace:SaveGameBackup.UI.Views.Tabs"
        xmlns:modals="clr-namespace:SaveGameBackup.UI.Views.Modals"
        mc:Ignorable="d"
        Title="SaveVault - Game Save Backup Tool (.NET 10 &amp; SQLite &amp; Cloud Sync)" 
        Height="950" Width="1400"
        MinHeight="950" MinWidth="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Header -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Game Save Backup" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text=".NET 10" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SQLite" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tự động tìm kiếm đường dẫn save game trên mạng và sao lưu trên máy" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats / Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lịch sử sao lưu:" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BackupHistory.Count}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Modular Tabs (Disabled when backing up) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" IsEnabled="{Binding IsNotBackingUp}" Background="Transparent" BorderThickness="0" Margin="16,8,16,0">
            
            <!-- TAB 1: SEARCH & BACKUP -->
            <TabItem Header="🔍 Tìm kiếm &amp; Sao lưu">
                <tabs:SearchTabView />
            </TabItem>

            <!-- TAB 2: BACKUP HISTORY -->
            <TabItem Header="📋 Lịch sử sao lưu">
                <tabs:HistoryTabView />
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="⚙️ Cài đặt">
                <tabs:SettingsTabView />
            </TabItem>

        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" 
                Padding="16,0" Height="36" MaxHeight="36" ClipToBounds="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Trạng thái: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold" 
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="4,0,16,0"
                           ToolTip="{Binding StatusMessage}"/>

                <TextBlock Grid.Column="2" Text="SaveGameBackup v1.0 • .NET 10" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- IN-APP MODAL OVERLAY (DIMMED BACKDROP & MODULAR DIALOGS)            -->
        <!-- =================================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000"
              Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}">
            
            <!-- Dim Backdrop with click to close -->
            <Border Background="#D9050914">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseModalCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- MODAL 1: Game History Details -->
            <modals:GameDetailsModal />

            <!-- MODAL 2: In-App Restore -->
            <modals:RestoreModal />

            <!-- MODAL 3: Restore Source Selection -->
            <modals:RestoreSourceModal />

            <!-- MODAL 4: Cloud Sync Provider Selection -->
            <modals:SyncCloudSelectModal />

            <!-- MODAL 5: In-App Confirm Dialog -->
            <modals:ConfirmDialogModal />

            <!-- MODAL 6: Progress Modal -->
            <modals:ProgressModal />

            <!-- MODAL 7: Universal Message Popup -->
            <modals:UniversalMessageModal />

        </Grid>
    </Grid>
</Window>

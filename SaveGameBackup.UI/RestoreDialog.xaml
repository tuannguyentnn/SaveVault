<Window x:Class="SaveGameBackup.UI.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Khôi phục bản sao lưu"
        Height="580" Width="840"
        MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0B0F19"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#7C3AED" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Khôi phục bản sao lưu" FontSize="17" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="SubTitleText" Text="" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Info badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BackupTypeBadge" Background="#1E293B" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="BackupTypeText" Text="Thư mục" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                    <Border x:Name="DateBadge" Background="#1E293B" CornerRadius="6" Padding="8,3">
                        <TextBlock x:Name="DateText" Text="" FontSize="11" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Info bar -->
        <Border Grid.Row="1" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦 Nguồn sao lưu: " FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="BackupPathText" Text="" FontSize="12" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectAllBtn" Content="✓ Chọn tất cả" Style="{StaticResource SmallIconButtonStyle}" Margin="0,0,6,0" Click="SelectAllBtn_Click"/>
                    <Button x:Name="DeselectAllBtn" Content="✗ Bỏ chọn tất cả" Style="{StaticResource SmallIconButtonStyle}" Margin="0,0,6,0" Click="DeselectAllBtn_Click"/>
                    <Button x:Name="ResetPathsBtn" Content="↩ Khôi phục đường dẫn gốc" Style="{StaticResource SmallIconButtonStyle}" Click="ResetPathsBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Restore Items List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,0">
            <StackPanel x:Name="RestoreItemsPanel">
                <!-- Items added dynamically in code-behind -->
            </StackPanel>
        </ScrollViewer>

        <!-- Progress area -->
        <Border Grid.Row="3" x:Name="ProgressArea" Visibility="Collapsed" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressMessageText" Text="Đang khôi phục..." FontSize="13" Foreground="#CBD5E1"/>
                    <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                </Grid>
                <ProgressBar x:Name="RestoreProgressBar" Value="0" Maximum="100" Height="6" Background="#1E293B" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>

        <!-- Footer action buttons -->
        <Border Grid.Row="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedCountText" Text="Đã chọn 0 / 0 vị trí lưu" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="⚠ Các file hiện tại tại vị trí đích sẽ bị ghi đè." FontSize="11" Foreground="#F59E0B" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="CancelBtn"
                        Content="Hủy bỏ"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="20,10" Margin="0,0,10,0"
                        Click="CancelBtn_Click"/>

                <Button Grid.Column="2"
                        x:Name="RestoreBtn"
                        Style="{StaticResource SuccessButtonStyle}"
                        Padding="20,10"
                        Click="RestoreBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bắt đầu Khôi phục" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

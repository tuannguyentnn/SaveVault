@namespace SaveGameBackup.UI.Components.Modals
@inject MainViewModel VM
@inject IBlazorDialogService DialogService
@inject INativeDialogService NativeDialog
@implements IDisposable

@if (RestoreVM.IsRestoreModalOpen || DialogService.IsRestoreModalOpen)
{
    var activeDetail = RestoreVM.ActiveRestoreDetail ?? DialogService.ActiveRestoreDetail;
    var restoreGameName = activeDetail?.GameName ?? RestoreVM.ActiveRestoreRecord?.GameName ?? "";
    var existingRevert = !string.IsNullOrEmpty(restoreGameName) ? RevertService.GetLatestRevertPoint(restoreGameName) : null;
    var restoreItems = (RestoreVM.ActiveRestoreItems.Count > 0 
        ? RestoreVM.ActiveRestoreItems 
        : (IEnumerable<RestoreItemTarget>)DialogService.ActiveRestoreItems).ToList();
    var selectedItems = restoreItems.Where(x => x.IsSelected).ToList();
    var canProceed = !RestoreVM.IsModalRestoring && selectedItems.Count > 0;
    var isCloud = RestoreVM.ActiveRestoreFromCloud || DialogService.ActiveRestoreFromCloud;
    var cloudProvider = !string.IsNullOrEmpty(RestoreVM.ActiveCloudProvider) 
        ? RestoreVM.ActiveCloudProvider 
        : DialogService.ActiveCloudProvider;
    var isOneDrive = string.Equals(cloudProvider, "OneDrive", StringComparison.OrdinalIgnoreCase);

    <div class="modal-backdrop z-50">
        <div class="modal-content w-full max-w-4xl border-2 border-emerald-500 flex flex-col max-h-[88vh] shadow-2xl bg-[#0F172A]">
            @if (RestoreStep == 1)
            {
                <!-- ================= BƯỚC 1: CHỌN MỤC & ĐƯỜNG DẪN ================= -->
                <!-- Header (Image 4.JPG) -->
                <div class="bg-[#1E293B] border-b border-[#334155] px-6 py-4 flex items-center justify-between flex-shrink-0">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-lg bg-emerald-600/30 border border-emerald-500/50 flex items-center justify-center">
                            <span class="text-emerald-400 font-bold text-lg">⚡</span>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2">
                                <h3 class="text-[17px] font-bold text-white tracking-wide">KHÔI PHỤC SAVE GAME</h3>
                                @if (activeDetail != null)
                                {
                                    <span class="badge-count text-[11px] bg-emerald-600/30 text-emerald-300 border border-emerald-500/30">
                                        @activeDetail.GameName
                                    </span>
                                }
                            </div>
                            <div class="text-[11px] text-slate-400 flex items-center flex-wrap gap-x-1.5 gap-y-0.5">
                                <span class="text-emerald-400 font-semibold">Bước 1/2: Chọn dữ liệu & đường dẫn</span>
                                <span class="text-slate-500">•</span>
                                <span>Nguồn: 
                                    @if (isCloud)
                                    {
                                        <strong class="@(isOneDrive ? "text-cyan-400" : "text-blue-400")">@(isOneDrive ? "☁️ OneDrive" : "📁 Google Drive")</strong>
                                    }
                                    else
                                    {
                                        <strong class="text-emerald-400">💻 Ổ cứng máy tính</strong>
                                    }
                                </span>
                                @if (activeDetail != null)
                                {
                                    <span class="text-slate-500">•</span>
                                    <span>Bản lưu: <strong class="text-white font-mono">@activeDetail.BackupDate.ToString("dd/MM/yyyy HH:mm:ss")</strong> (@activeDetail.FormattedSize)</span>
                                }
                            </div>
                        </div>
                    </div>

                    <button class="text-slate-400 hover:text-white text-lg font-bold p-1 rounded hover:bg-slate-700/50 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
                            disabled="@RestoreVM.IsModalRestoring"
                            @onclick="CloseModal">
                        ✕
                    </button>
                </div>

                <!-- Revert Alert Bar nếu game đã từng có bản hoàn tác trước đó -->
                @if (existingRevert != null)
                {
                    <div class="bg-gradient-to-r from-amber-950/60 via-slate-900 to-[#0F172A] border-b border-amber-500/40 px-6 py-2.5 flex items-center justify-between flex-shrink-0">
                        <div class="flex items-center space-x-2.5 text-[12px] text-amber-200">
                            <span class="text-base flex-shrink-0">🛡️</span>
                            <div>
                                <span class="font-bold text-amber-300">Đã có Điểm Hoàn Tác (Revert Point) an toàn:</span>
                                <span class="font-mono text-white ml-1">@existingRevert.FormattedDate</span>
                                <span class="text-amber-300 font-mono font-semibold ml-1">(@existingRevert.DisplaySize)</span>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button class="h-[28px] px-3 text-[11px] font-bold text-white rounded bg-amber-600 hover:bg-amber-500 border border-amber-400 transition-all flex items-center space-x-1 cursor-pointer shadow-sm active:scale-95"
                                    disabled="@RestoreVM.IsModalRestoring"
                                    @onclick="() => ExecuteRevertFromRestoreModal(restoreGameName, existingRevert)">
                                <span>🔄</span>
                                <span>Hoàn Tác Save Cũ Này</span>
                            </button>
                            <button class="h-[28px] px-2.5 text-[11px] font-medium text-slate-300 rounded bg-slate-800 hover:bg-red-950/40 hover:text-red-300 border border-slate-600 hover:border-red-500/50 transition-all flex items-center space-x-1 cursor-pointer shadow-sm active:scale-95"
                                    disabled="@RestoreVM.IsModalRestoring"
                                    @onclick="() => ExecuteClearRevertFromRestoreModal(restoreGameName, existingRevert)"
                                    title="Xóa bản nén hoàn tác này để giải phóng dung lượng đĩa">
                                <span>🧹</span>
                                <span>Xóa Revert</span>
                            </button>
                        </div>
                    </div>
                }

                <!-- Instruction & Toolbar (Image 4.JPG) -->
                <div class="bg-[#0F172A] border-b border-[#1E293B] px-6 py-3 flex items-center justify-between flex-shrink-0">
                    <div class="text-[12px] text-slate-300 flex-1 mr-4">
                        Chọn các mục muốn khôi phục. Bạn có thể nhấn <strong>"Duyệt..."</strong> để đổi đường dẫn đích nếu muốn khôi phục ra vị trí khác.
                    </div>

                    <div class="flex items-center space-x-2 flex-shrink-0">
                        <button class="btn-secondary text-[11px] py-1 px-2.5"
                                disabled="@RestoreVM.IsModalRestoring"
                                @onclick="() => RestoreVM.ModalSelectAllRestoreItemsCommand.Execute(null)">
                            ✓ Chọn Tất Cả
                        </button>
                        <button class="btn-secondary text-[11px] py-1 px-2.5"
                                disabled="@RestoreVM.IsModalRestoring"
                                @onclick="() => RestoreVM.ModalDeselectAllRestoreItemsCommand.Execute(null)">
                            ✕ Bỏ Chọn
                        </button>
                        <button class="btn-secondary text-[11px] py-1 px-2.5 text-blue-400 border-blue-500/30"
                                disabled="@RestoreVM.IsModalRestoring"
                                @onclick="() => RestoreVM.ModalResetRestorePathsCommand.Execute(null)">
                            ↺ Đặt Lại Gốc
                        </button>
                    </div>
                </div>

                <!-- List of Restore Items (Image 4.JPG) -->
                <div class="sv-scroll-wrapper flex-1 min-h-0 flex flex-col" data-scroll-text="Còn mục bên dưới (Cuộn)">
                    <div class="flex-1 overflow-y-auto p-5 space-y-3 min-h-0 bg-[#131C2E] sv-scroll-area">
                    @if (restoreItems.Count == 0)
                    {
                        <div class="p-8 text-center text-slate-400 text-[13px]">
                            Không có dữ liệu mục khôi phục nào trong bản lưu này.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in restoreItems)
                        {
                            <div class="bg-[#0F172A] border @(item.IsSelected ? "border-emerald-500/60 bg-emerald-950/10" : "border-[#2D3748]") rounded-xl p-4 transition-all">
                                <div class="flex items-center space-x-3 mb-2">
                                    <input type="checkbox"
                                           class="checkbox-custom"
                                           checked="@item.IsSelected"
                                           disabled="@RestoreVM.IsModalRestoring"
                                           @onchange="() => ToggleItem(item)" />
                                    <span class="font-bold text-white text-[13px]">
                                        @item.DisplayTitle
                                    </span>
                                    @if (item.FileCount > 0)
                                    {
                                        <span class="text-[11px] text-slate-400 font-mono">
                                            (@item.FileCount files - @item.FormattedSize)
                                        </span>
                                    }
                                </div>

                                <div class="pl-7">
                                    <label class="block text-[11px] text-slate-400 font-semibold mb-1">Đường dẫn đích khôi phục:</label>
                                    <div class="flex items-center space-x-2">
                                        <input type="text"
                                               class="input-dark font-mono text-[12px] py-1.5 px-3 flex-1 bg-[#131C2E] border-[#334155] text-slate-200"
                                               @bind="item.RestoreDestinationPath"
                                               disabled="@RestoreVM.IsModalRestoring" />
                                        <button class="btn-secondary py-1.5 px-3 text-[12px] flex-shrink-0"
                                                disabled="@RestoreVM.IsModalRestoring"
                                                @onclick="() => BrowseItemDestination(item)">
                                            📁 Duyệt...
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

                <!-- Footer Bước 1 -->
                <div class="bg-[#0F172A] border-t border-[#1E293B] px-6 py-3.5 flex items-center justify-between flex-shrink-0">
                    <div class="text-[12px] text-slate-400">
                        Đã chọn: <strong class="text-emerald-400 font-mono">@selectedItems.Count</strong> / @restoreItems.Count mục
                    </div>

                    <div class="flex items-center space-x-3 ml-auto">
                        <button class="btn-secondary py-2 px-4 text-[12px] flex items-center space-x-1.5 disabled:opacity-40 disabled:cursor-not-allowed"
                                disabled="@RestoreVM.IsModalRestoring"
                                @onclick="CloseModal">
                            <span>✕ Hủy Bỏ</span>
                        </button>
                        <button class="btn-success py-2 px-6 text-[12.5px] font-bold flex items-center space-x-2 bg-emerald-600 border-emerald-500 hover:bg-emerald-700 text-white rounded-lg shadow-md disabled:opacity-40 disabled:cursor-not-allowed"
                                disabled="@(!canProceed)"
                                @onclick="() => RestoreStep = 2">
                            <span>Tiếp Tục ➔</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- ================= BƯỚC 2: XÁC NHẬN LẦN CUỐI ================= -->
                <!-- Header Bước 2 -->
                <div class="bg-[#1E293B] border-b border-[#334155] px-6 py-4 flex items-center justify-between flex-shrink-0">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-lg bg-emerald-600/30 border border-emerald-500/50 flex items-center justify-center">
                            <span class="text-emerald-400 font-bold text-lg">⚡</span>
                        </div>
                        <div>
                            <h3 class="text-[17px] font-bold text-white tracking-wide">
                                XÁC NHẬN LẦN CUỐI: KHÔI PHỤC SAVE GAME
                            </h3>
                            <span class="text-[11px] text-slate-400">
                                Bước 2/2: Kiểm tra cẩn thận trước khi ghi đè dữ liệu save game
                            </span>
                        </div>
                    </div>

                    <button class="text-slate-400 hover:text-white text-lg font-bold p-1 rounded hover:bg-slate-700/50 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
                            disabled="@RestoreVM.IsModalRestoring"
                            @onclick="CloseModal">
                        ✕
                    </button>
                </div>

                <!-- Nội dung Bước 2 -->
                <div class="sv-scroll-wrapper flex-1 min-h-0 flex flex-col" data-scroll-text="Còn nội dung bên dưới (Cuộn)">
                    <div class="flex-1 overflow-y-auto p-6 space-y-4 min-h-0 bg-[#131C2E] sv-scroll-area">
                    <!-- Warning Box -->
                    <div class="p-3.5 rounded-xl bg-amber-950/30 border border-amber-500/40 text-amber-200 text-[12.5px] leading-relaxed flex items-start space-x-3">
                        <span class="text-xl flex-shrink-0">🚨</span>
                        <div>
                            <strong class="text-amber-300">CẢNH BÁO QUAN TRỌNG:</strong>
                            Hành động này sẽ <strong>ghi đè hoàn toàn</strong> các tệp save game hiện tại trong máy bằng dữ liệu từ bản sao lưu đã chọn. Hãy chắc chắn rằng bạn đã <strong>tắt trò chơi hoàn toàn</strong> trước khi xác nhận.
                        </div>
                    </div>

                    <!-- Bảng Tóm Tắt Chi Tiết -->
                    <div class="bg-[#0A0F1D] border border-emerald-500/30 rounded-xl p-4 space-y-3 shadow-inner">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <span class="text-[12px] text-slate-400">Tên Trò Chơi:</span>
                            <span class="text-[13px] font-bold text-white">@(activeDetail?.GameName ?? RestoreVM.ActiveRestoreRecord?.GameName ?? "Game")</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <span class="text-[12px] text-slate-400">Nguồn khôi phục:</span>
                            @if (isCloud)
                            {
                                @if (isOneDrive)
                                {
                                    <span class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-md text-[12px] font-semibold bg-cyan-950/60 border border-cyan-500/40 text-cyan-300 shadow-sm">
                                        <span>☁️</span>
                                        <span>Microsoft OneDrive (Đám mây)</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-md text-[12px] font-semibold bg-blue-950/60 border border-blue-500/40 text-blue-300 shadow-sm">
                                        <span>📁</span>
                                        <span>Google Drive (Đám mây)</span>
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-md text-[12px] font-semibold bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 shadow-sm">
                                    <span>💻</span>
                                    <span>Ổ cứng máy tính (Bản lưu Local)</span>
                                </span>
                            }
                        </div>
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <span class="text-[12px] text-slate-400">Thời điểm sao lưu:</span>
                            <span class="font-mono text-[12px] text-white">@(activeDetail?.BackupDate.ToString("dd/MM/yyyy HH:mm:ss") ?? RestoreVM.ActiveRestoreRecord?.BackupDate.ToString("dd/MM/yyyy HH:mm:ss"))</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <span class="text-[12px] text-slate-400">Dung lượng bản lưu:</span>
                            <span class="font-mono text-[12px] text-emerald-400 font-bold">@(activeDetail?.FormattedSize ?? RestoreVM.ActiveRestoreRecord?.FormattedSize)</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <span class="text-[12px] text-slate-400">Số mục sẽ khôi phục:</span>
                            <span class="font-mono text-[12px] text-emerald-300 font-bold">@selectedItems.Count mục đã chọn</span>
                        </div>

                        <!-- Danh sách các mục & đường dẫn đích -->
                        <div class="pt-1 space-y-2">
                            <div class="text-[11.5px] text-slate-400 font-semibold">Các thư mục đích sẽ nhận dữ liệu và bị ghi đè:</div>
                            <div class="sv-scroll-wrapper" data-scroll-text="Còn thư mục bên dưới (Cuộn)">
                                <div class="max-h-[220px] overflow-y-auto space-y-2 pr-1 sv-scroll-area">
                                    @foreach (var item in selectedItems)
                                    {
                                        <div class="bg-[#131C2E] border border-slate-700/80 rounded-lg p-3 text-[12px]">
                                            <div class="flex items-center justify-between mb-1.5">
                                                <span class="font-bold text-white flex items-center space-x-1.5">
                                                    <span>📁</span>
                                                    <span>@item.DisplayTitle</span>
                                                </span>
                                                @if (item.FileCount > 0)
                                                {
                                                    <span class="text-[11px] text-slate-400 font-mono">(@item.FileCount files - @item.FormattedSize)</span>
                                                }
                                            </div>
                                            <div class="font-mono text-[11px] text-emerald-300 break-all select-text bg-[#0A0F1D] p-2 rounded border border-emerald-500/20">
                                                ➔ @item.RestoreDestinationPath
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Bar if Restoring -->
                    @if (RestoreVM.IsModalRestoring)
                    {
                        <div class="bg-[#0F172A] border border-emerald-500/40 rounded-lg p-3.5 space-y-2">
                            <div class="flex items-center justify-between text-[12px] text-emerald-400">
                                <div class="flex items-center space-x-2">
                                    <div class="w-4 h-4 border-2 border-emerald-400 border-t-transparent rounded-full animate-spin"></div>
                                    <span class="font-medium">@(string.IsNullOrEmpty(RestoreVM.ModalRestoreProgressMessage) ? "Đang khôi phục dữ liệu..." : RestoreVM.ModalRestoreProgressMessage)</span>
                                </div>
                                <span class="font-mono font-bold text-emerald-400">@RestoreVM.ModalRestoreProgressPercent%</span>
                            </div>
                            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-700">
                                <div class="bg-gradient-to-r from-emerald-500 to-green-400 h-2 rounded-full transition-all duration-300"
                                     style="width: @(Math.Clamp(RestoreVM.ModalRestoreProgressPercent, 0, 100))%;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

                <!-- Footer Bước 2 -->
                <div class="bg-[#0F172A] border-t border-[#1E293B] px-6 py-3.5 flex items-center justify-between flex-shrink-0">
                    <button class="btn-secondary py-2 px-3 text-[12px] flex items-center space-x-1 disabled:opacity-40 disabled:cursor-not-allowed"
                            disabled="@RestoreVM.IsModalRestoring"
                            @onclick="() => RestoreStep = 1">
                        <span>⬅ Quay Lại</span>
                    </button>

                    <div class="flex items-center space-x-2.5">
                        <button class="btn-success py-2 px-6 text-[12.5px] font-bold flex items-center space-x-2 bg-emerald-600 border-emerald-500 hover:bg-emerald-700 text-white rounded-lg shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
                                disabled="@RestoreVM.IsModalRestoring"
                                @onclick="ConfirmRestore">
                            @if (RestoreVM.IsModalRestoring)
                            {
                                <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-1"></div>
                                <span>Đang Khôi Phục...</span>
                            }
                            else
                            {
                                <span>⚡ Xác Nhận Khôi Phục</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private RestoreSubViewModel RestoreVM => VM.RestoreVM;
    private int RestoreStep = 1;
    private bool _lastIsOpen = false;

    protected override void OnInitialized()
    {
        RestoreVM.PropertyChanged += OnStateChanged;
        DialogService.PropertyChanged += OnStateChanged;
    }

    private void OnStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        var currentOpen = RestoreVM.IsRestoreModalOpen || DialogService.IsRestoreModalOpen;
        if (currentOpen && !_lastIsOpen)
        {
            RestoreStep = 1;
        }
        _lastIsOpen = currentOpen;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleItem(RestoreItemTarget item)
    {
        item.IsSelected = !item.IsSelected;
        RestoreVM.ModalToggleRestoreItemCommand.Execute(item);
    }

    private async Task BrowseItemDestination(RestoreItemTarget item)
    {
        var folder = await NativeDialog.PickFolderAsync($"Chọn thư mục đích cho {item.DisplayTitle}");
        if (!string.IsNullOrEmpty(folder))
        {
            item.RestoreDestinationPath = folder;
        }
    }

    private async Task ConfirmRestore()
    {
        try
        {
            await RestoreVM.ExecuteModalRestoreConfirmAsync();
        }
        finally
        {
            CloseModal();
        }
    }

    private void ExecuteRevertFromRestoreModal(string gameName, RevertPointInfo revertPoint)
    {
        if (string.IsNullOrWhiteSpace(gameName) || revertPoint == null) return;

        DialogService.ShowConfirm(
            "Xác Nhận Hoàn Tác (Revert)",
            $"Bạn có chắc chắn muốn hoàn tác save game '{gameName}' về trạng thái trước lần Restore gần nhất ({revertPoint.FormattedDate})?\n\nToàn bộ dữ liệu save hiện tại của game sẽ được thay thế bằng dữ liệu an toàn này.",
            revertPoint.FilePath,
            async () =>
            {
                DialogService.ShowProgress("Đang Hoàn Tác Save Game", "Đang khôi phục lại dữ liệu từ điểm hoàn tác...", 15);
                var progress = new Progress<BackupProgress>(p =>
                {
                    DialogService.UpdateProgress(p.Percent, p.Message);
                });

                try
                {
                    await RevertService.RevertGameSaveAsync(gameName, revertPoint.FilePath, progress);

                    try
                    {
                        var dbRecord = new RestoreHistoryRecord
                        {
                            GameName = gameName,
                            SourcePath = revertPoint.FilePath,
                            RestoreDate = DateTime.Now,
                            Status = "Reverted",
                            RevertZipPath = null,
                            TotalSizeBytes = revertPoint.TotalSizeBytes,
                            ErrorMessage = "Người dùng thực hiện hoàn tác thủ công từ điểm hoàn tác (Revert Point)."
                        };
                        await VM.DatabaseService.InsertRestoreHistoryAsync(dbRecord);
                    }
                    catch { }

                    DialogService.CloseProgress();
                    CloseModal();
                    DialogService.ShowMessage("Hoàn Tác Thành Công", $"Đã khôi phục thành công dữ liệu save game '{gameName}' về trạng thái trước khi Restore!", "Success");
                }
                catch (Exception ex)
                {
                    DialogService.CloseProgress();
                    LoggingService.Error(ex, "Lỗi khi hoàn tác save game {Game}: {Message}", gameName, ex.Message);
                    DialogService.ShowMessage("Lỗi Hoàn Tác", $"Không thể hoàn tác save game: {ex.Message}", "Error");
                }
            });
    }

    private void ExecuteClearRevertFromRestoreModal(string gameName, RevertPointInfo revertPoint)
    {
        if (string.IsNullOrWhiteSpace(gameName) || revertPoint == null) return;

        DialogService.ShowConfirm(
            "Xác Nhận Xóa Bản Hoàn Tác",
            $"Bạn có chắc chắn muốn xóa bản nén hoàn tác của game '{gameName}' ({revertPoint.DisplaySize})?\n\nSau khi xóa, bạn sẽ giải phóng dung lượng ổ đĩa nhưng không thể tự động hoàn tác lại bản save cũ này được nữa.",
            revertPoint.FilePath,
            () =>
            {
                try
                {
                    RevertService.ClearRevertPoints(gameName);
                    DialogService.ShowMessage("Đã Dọn Dẹp", $"Đã xóa sạch bản nén hoàn tác của game '{gameName}'.", "Success");
                    InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    LoggingService.Error(ex, "Lỗi khi xóa bản hoàn tác của {Game}: {Message}", gameName, ex.Message);
                    DialogService.ShowMessage("Lỗi", $"Không thể xóa bản hoàn tác: {ex.Message}", "Error");
                }
                return Task.CompletedTask;
            });
    }

    private void CloseModal()
    {
        RestoreStep = 1;
        RestoreVM.ExecuteCloseRestoreModal();
        DialogService.CloseRestore();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RestoreVM.PropertyChanged -= OnStateChanged;
        DialogService.PropertyChanged -= OnStateChanged;
    }
}

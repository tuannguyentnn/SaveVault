@namespace SaveGameBackup.UI.Components.Pages
@inject MainViewModel VM
@inject IBlazorDialogService DialogService
@inject INativeDialogService NativeDialog
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="h-full flex flex-col p-5 space-y-3.5 overflow-hidden" style="background-color: #0A0F1D;" @onclick="DeselectEntry">
    <!-- Sub-header bar with Search Box & View Mode Toggle -->
    <div class="flex items-center justify-between flex-shrink-0">
        <div class="flex items-center space-x-3">
            <h2 class="text-[13.5px] font-bold text-white tracking-wide">
                Danh sách game đã sao lưu:
            </h2>
            <div class="relative w-72" @onclick:stopPropagation="true">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[12px]">🔍</span>
                <input type="text"
                       class="w-full bg-[#070B14] border border-[#1E2D42] focus:border-blue-500 rounded-lg pl-8 pr-7 py-1.5 text-[12px] text-white placeholder-slate-500 outline-none transition-all"
                       placeholder="Tìm kiếm theo tên game..."
                       value="@FilterText"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(FilterText))
                {
                    <button type="button"
                            class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-[11px] font-bold p-0.5"
                            @onclick="ClearSearch">
                        ✕
                    </button>
                }
            </div>
        </div>

        <div class="flex items-center space-x-3">
            <!-- Nút Đồng Bộ Ảnh Cho Các Game Chưa Có Ảnh -->
            <button type="button"
                    class="px-3 py-1.5 text-[11.5px] font-semibold rounded-lg bg-[#0F172A] border border-[#1E293B] hover:border-cyan-500 hover:text-cyan-300 text-slate-300 transition-all flex items-center space-x-1.5 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
                    @onclick="() => VM.HistoryVM.SyncMissingCoversCommand.Execute(null)"
                    @onclick:stopPropagation="true"
                    disabled="@VM.HistoryVM.IsSyncingCovers"
                    title="Tự động tìm kiếm và tải ảnh bìa cho các game chưa có ảnh trong lịch sử">
                <span>@(VM.HistoryVM.IsSyncingCovers ? "⏳" : "🖼️")</span>
                <span>@(VM.HistoryVM.IsSyncingCovers ? "Đang đồng bộ..." : "Đồng bộ ảnh game")</span>
            </button>

            <!-- View Mode Switcher (Gallery vs Table) -->
            <div class="inline-flex rounded-lg p-0.5 bg-[#0F172A] border border-[#1E293B]" @onclick:stopPropagation="true">
                <button type="button"
                        class="px-3 py-1 text-[11.5px] font-semibold rounded-md transition-all flex items-center space-x-1.5 @(IsGalleryView ? "bg-blue-600 text-white shadow" : "text-slate-400 hover:text-slate-200")"
                        @onclick="() => SetViewMode(true)"
                        title="Chế độ Lưới Thẻ Game (Gallery)">
                    <span>🔲</span>
                    <span>Lưới Game</span>
                </button>
                <button type="button"
                        class="px-3 py-1 text-[11.5px] font-semibold rounded-md transition-all flex items-center space-x-1.5 @(!IsGalleryView ? "bg-blue-600 text-white shadow" : "text-slate-400 hover:text-slate-200")"
                        @onclick="() => SetViewMode(false)"
                        title="Chế độ Bảng Danh Sách (Table)">
                    <span>☰</span>
                    <span>Bảng</span>
                </button>
            </div>

            <div class="text-[11.5px] text-slate-400 hidden sm:flex items-center space-x-1.5">
                <span>💡</span>
                <span>Nhấp đúp vào game để xem chi tiết snapshot</span>
            </div>
        </div>
    </div>

    <!-- Master Container (Card chứa Gallery hoặc Table) -->
    <div class="flex-1 sv-card p-0 overflow-hidden flex flex-col min-h-0" @onclick="DeselectEntry">
        
        @if (IsGalleryView)
        {
            <!-- ================= CHẾ ĐỘ GALLERY GAME (BOX ART POSTER CARDS) ================= -->
            <div id="gallery-container" class="flex-1 overflow-y-auto p-4 min-h-0">
                @if (PagedHistories.Count == 0)
                {
                    <div class="h-full flex flex-col items-center justify-center py-20 text-slate-400 text-[12.5px]">
                        <div class="text-[36px] mb-2.5">🎮</div>
                        <div class="font-semibold text-slate-300 text-[14px]">
                            @(string.IsNullOrWhiteSpace(FilterText) ? "Chưa có bản sao lưu game nào trong hệ thống" : $"Không tìm thấy game nào khớp với '{FilterText}'")
                        </div>
                        <div class="text-[11.5px] text-slate-500 mt-1">
                            @(string.IsNullOrWhiteSpace(FilterText) ? "Hãy chuyển sang tab 'Tìm kiếm & Sao lưu' để bắt đầu sao lưu game đầu tiên." : "Hãy thử từ khóa khác hoặc xóa bộ lọc tìm kiếm.")
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));">
                        @foreach (var entry in PagedHistories)
                        {
                            var isSelected = SelectedEntry == entry;
                            <div class="group relative bg-[#101726] border @(isSelected ? "border-emerald-500 ring-2 ring-emerald-500/40 shadow-lg shadow-emerald-950/40" : "border-[#1E293B] hover:border-blue-500/70") rounded-xl overflow-hidden flex flex-col cursor-pointer transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-blue-950/20 aspect-[2/3]"
                                 style="aspect-ratio: 2/3;"
                                 @onclick="() => SelectedEntry = entry"
                                 @onclick:stopPropagation="true"
                                 @ondblclick="() => OpenGameDetails(entry)">

                                <!-- Vùng Ảnh Bìa Game (Tự động co giãn theo tỉ lệ 2:3 của cả Card) -->
                                <div class="relative flex-1 min-h-0 w-full bg-[#070B14] overflow-hidden flex items-center justify-center select-none">
                                    @if (!string.IsNullOrEmpty(entry.CoverImageSrc))
                                    {
                                        <img src="@entry.CoverImageSrc"
                                             alt="@entry.GameName"
                                             referrerpolicy="no-referrer"
                                             class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                                             loading="lazy"
                                             onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                        <div style="display: none;" class="w-full h-full bg-gradient-to-br from-[#1E293B] via-[#0F172A] to-[#0A0F1D] flex-col items-center justify-center p-3 text-center">
                                            <span class="text-3xl mb-1 opacity-60 group-hover:scale-110 transition-transform">🎮</span>
                                            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider line-clamp-2 px-1">
                                                @entry.GameName
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Placeholder Game Cover (Khi tìm bằng tay hoặc không có ảnh) -->
                                        <div class="w-full h-full bg-gradient-to-br from-[#1E293B] via-[#0F172A] to-[#0A0F1D] flex flex-col items-center justify-center p-3 text-center">
                                            <span class="text-3xl mb-1 opacity-60 group-hover:scale-110 transition-transform">🎮</span>
                                            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider line-clamp-2 px-1">
                                                @entry.GameName
                                            </span>
                                        </div>
                                    }

                                    <!-- Badge Số bản sao lưu (Góc trên phải) -->
                                    <div class="absolute top-2 right-2 z-10">
                                        <span class="bg-[#0A1E3F]/90 backdrop-blur-md border border-blue-500/50 text-sky-300 text-[10px] font-bold px-1.5 py-0.5 rounded-full shadow">
                                            💾 @entry.BackupCount
                                        </span>
                                    </div>

                                    <!-- Badge Cloud Synced (Góc trên trái) -->
                                    @if (entry.HasCloudBackup)
                                    {
                                        <div class="absolute top-2 left-2 z-10">
                                            <span class="bg-[#064E3B]/90 backdrop-blur-md border border-emerald-500/50 text-emerald-300 text-[9.5px] font-bold px-1.5 py-0.5 rounded-full shadow flex items-center space-x-1"
                                                  title="Đã đồng bộ lên đám mây">
                                                <span>☁️</span>
                                                <span>Cloud</span>
                                            </span>
                                        </div>
                                    }

                                    <!-- Gradient Shadow mờ dần ở chân ảnh bìa -->
                                    <div class="absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-[#0F172A] to-transparent pointer-events-none"></div>
                                </div>

                                <!-- Thân Card Thông Tin: Tên Game tinh gọn chuẩn phong cách Steam/GOG -->
                                <div class="py-2 px-2 bg-[#0F172A] border-t border-[#1E293B]/60 flex items-center justify-center text-center flex-shrink-0">
                                    <h3 class="font-bold text-white text-[12px] line-clamp-1 leading-snug group-hover:text-blue-400 transition-colors"
                                        title="@entry.GameName">
                                        @entry.GameName
                                    </h3>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- ================= CHẾ ĐỘ TABLE (BẢNG DANH SÁCH CÓ THUMBNAIL COVER) ================= -->
            <div class="flex-1 overflow-y-auto overflow-x-auto min-h-0">
                <table class="custom-table w-full overflow-hidden" style="border-collapse: separate; border-spacing: 0;">
                    <thead class="sticky top-0 z-10 shadow-sm" style="background-color: #101726;">
                        <tr style="background-color: #101726; border-bottom: 1px solid #1E293B;">
                            <!-- Cột Ảnh Bìa Cover -->
                            <th style="padding: 10px 12px; text-align: center; font-size: 11.5px; color: #94A3B8; font-weight: 600; width: 68px; background-color: #101726; border-bottom: 1px solid #1E293B;"
                                class="select-none sticky top-0 z-10">
                                Ảnh Bìa
                            </th>
                            <th style="padding: 10px 16px; text-align: left; font-size: 11.5px; color: #94A3B8; font-weight: 600; background-color: #101726; border-bottom: 1px solid #1E293B;"
                                class="cursor-pointer select-none hover:text-white transition-colors sticky top-0 z-10"
                                @onclick='() => SortBy("GameName")' @onclick:stopPropagation="true"
                                title="Nhấp để sắp xếp theo Tên Game">
                                <div class="inline-flex items-center space-x-1">
                                    <span>Tên Game</span>
                                    <span class="text-cyan-400 font-bold">@(SortColumn == "GameName" ? (SortAscending ? "▲" : "▼") : "")</span>
                                </div>
                            </th>
                            <th style="padding: 10px 16px; text-align: center; font-size: 11.5px; color: #94A3B8; font-weight: 600; width: 140px; background-color: #101726; border-bottom: 1px solid #1E293B;"
                                class="cursor-pointer select-none hover:text-white transition-colors sticky top-0 z-10"
                                @onclick='() => SortBy("Count")' @onclick:stopPropagation="true"
                                title="Nhấp để sắp xếp theo Số bản sao lưu">
                                <div class="inline-flex items-center space-x-1 justify-center">
                                    <span>Số bản sao lưu</span>
                                    <span class="text-cyan-400 font-bold">@(SortColumn == "Count" ? (SortAscending ? "▲" : "▼") : "")</span>
                                </div>
                            </th>
                            <th style="padding: 10px 16px; text-align: left; font-size: 11.5px; color: #94A3B8; font-weight: 600; width: 180px; background-color: #101726; border-bottom: 1px solid #1E293B;"
                                class="cursor-pointer select-none hover:text-white transition-colors sticky top-0 z-10"
                                @onclick='() => SortBy("Date")' @onclick:stopPropagation="true"
                                title="Nhấp để sắp xếp theo Ngày sao lưu gần nhất">
                                <div class="inline-flex items-center space-x-1">
                                    <span>Lần sao lưu gần nhất</span>
                                    <span class="text-cyan-400 font-bold">@(SortColumn == "Date" ? (SortAscending ? "▲" : "▼") : "")</span>
                                </div>
                            </th>
                            <th style="padding: 10px 16px; text-align: left; font-size: 11.5px; color: #94A3B8; font-weight: 600; width: 180px; background-color: #101726; border-bottom: 1px solid #1E293B;"
                                class="cursor-pointer select-none hover:text-white transition-colors sticky top-0 z-10"
                                @onclick='() => SortBy("LatestSize")' @onclick:stopPropagation="true"
                                title="Nhấp để sắp xếp theo Dung lượng mới nhất">
                                <div class="inline-flex items-center space-x-1">
                                    <span>Dung lượng (Mới nhất)</span>
                                    <span class="text-cyan-400 font-bold">@(SortColumn == "LatestSize" ? (SortAscending ? "▲" : "▼") : "")</span>
                                </div>
                            </th>
                            <th style="padding: 10px 16px; text-align: left; font-size: 11.5px; color: #94A3B8; font-weight: 600; width: 180px; background-color: #101726; border-bottom: 1px solid #1E293B;"
                                class="cursor-pointer select-none hover:text-white transition-colors sticky top-0 z-10"
                                @onclick='() => SortBy("TotalSize")' @onclick:stopPropagation="true"
                                title="Nhấp để sắp xếp theo Tổng dung lượng">
                                <div class="inline-flex items-center space-x-1">
                                    <span>Tổng dung lượng</span>
                                    <span class="text-cyan-400 font-bold">@(SortColumn == "TotalSize" ? (SortAscending ? "▲" : "▼") : "")</span>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedHistories.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-16 text-slate-400 text-[12.5px]">
                                    <div>
                                        <div class="text-[32px] mb-2">📁</div>
                                        <div class="font-semibold text-slate-300">
                                            @(string.IsNullOrWhiteSpace(FilterText) ? "Chưa có bản sao lưu nào trong hệ thống" : $"Không tìm thấy game nào khớp với '{FilterText}'")
                                        </div>
                                        <div class="text-[11.5px] text-slate-500 mt-1">
                                            @(string.IsNullOrWhiteSpace(FilterText) ? "Hãy chuyển sang tab 'Tìm kiếm & Sao lưu' để bắt đầu sao lưu game đầu tiên." : "Hãy thử từ khóa khác hoặc xóa tìm kiếm.")
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var entry in PagedHistories)
                            {
                                var isSelected = SelectedEntry == entry;
                                <tr class="cursor-pointer transition-colors @(isSelected ? "selected bg-[#065F46]" : "hover:bg-[#131C2E]")"
                                    style="border-bottom: 1px solid #162030;"
                                    @onclick="() => SelectedEntry = entry"
                                    @onclick:stopPropagation="true"
                                    @ondblclick="() => OpenGameDetails(entry)">
                                    
                                    <!-- Cột Thumbnail Cover -->
                                    <td style="padding: 6px 12px; text-align: center; width: 68px;">
                                        <div class="w-10 h-14 rounded overflow-hidden bg-[#070B14] border border-slate-700/80 mx-auto flex items-center justify-center select-none shadow-sm">
                                            @if (!string.IsNullOrEmpty(entry.CoverImageSrc))
                                            {
                                                <img src="@entry.CoverImageSrc"
                                                     alt="@entry.GameName"
                                                     referrerpolicy="no-referrer"
                                                     class="w-full h-full object-cover object-top"
                                                     loading="lazy"
                                                     onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                                <div style="display: none;" class="w-full h-full bg-gradient-to-br from-[#1E293B] to-[#0A0F1D] flex-col items-center justify-center text-slate-400">
                                                    <span class="text-xs">🎮</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="w-full h-full bg-gradient-to-br from-[#1E293B] to-[#0A0F1D] flex items-center justify-center text-slate-400">
                                                    <span class="text-xs">🎮</span>
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <!-- Tên Game -->
                                    <td style="padding: 10px 16px;">
                                        <div class="flex items-center space-x-2.5">
                                            <span class="font-bold text-white text-[13px]">
                                                @entry.GameName
                                            </span>
                                            @if (entry.HasCloudBackup)
                                            {
                                                <span class="text-[10px] bg-emerald-950/80 text-emerald-400 border border-emerald-700/50 px-1.5 py-0.2 rounded font-bold">
                                                    ☁️
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Số Bản Sao Lưu -->
                                    <td style="padding: 10px 16px; text-align: center;">
                                        <span style="background-color: #0A1E3F; border: 1px solid #1E3A8A; color: #38BDF8; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 9999px;">
                                            @entry.BackupCount bản
                                        </span>
                                    </td>

                                    <!-- Lần Sao Lưu Gần Nhất -->
                                    <td style="padding: 10px 16px; font-family: var(--font-mono); font-size: 12px; color: #CBD5E1;">
                                        @entry.FormattedLatestDate
                                    </td>

                                    <!-- Dung Lượng Mới Nhất -->
                                    <td style="padding: 10px 16px; font-family: var(--font-mono); font-size: 12px; color: #CBD5E1;">
                                        @entry.FormattedLatestSize
                                    </td>

                                    <!-- Tổng Dung Lượng -->
                                    <td style="padding: 10px 16px; font-family: var(--font-mono); font-size: 12px; color: #CBD5E1;">
                                        @entry.FormattedTotalSize
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Pagination Bar (Phân trang dùng chung cho cả Gallery và Table - Luôn hiện khi có game) -->
        @if (TotalItems > 0)
        {
            <div class="px-4 py-2 border-t border-[#182234] flex items-center justify-between text-[11.5px] text-slate-400 flex-shrink-0"
                 style="background-color: #0A0F1D;" @onclick:stopPropagation="true">
                <div class="flex items-center space-x-3">
                    <div>
                        Hiển thị <span class="font-mono text-white font-semibold">@FromItem</span> - <span class="font-mono text-white font-semibold">@ToItem</span> trong tổng số <span class="font-mono text-cyan-400 font-bold">@TotalItems</span> game
                    </div>

                    <div class="flex items-center space-x-1.5 pl-3 border-l border-slate-800 text-[11px] text-slate-400">
                        <span>Hiển thị:</span>
                        <button type="button"
                                class="px-2 py-0.5 rounded text-[10.5px] font-mono transition-all @(RowsPerPage == 2 ? "bg-cyan-600/30 text-cyan-300 border border-cyan-500/50 font-bold" : "bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700")"
                                title="Hiển thị @(ResponsiveColumns * 2) mục mỗi trang"
                                @onclick="() => SetRowsPerPage(2)">
                            2 hàng (@(ResponsiveColumns * 2))
                        </button>
                        <button type="button"
                                class="px-2 py-0.5 rounded text-[10.5px] font-mono transition-all @(RowsPerPage == 3 ? "bg-cyan-600/30 text-cyan-300 border border-cyan-500/50 font-bold" : "bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700")"
                                title="Hiển thị @(ResponsiveColumns * 3) mục mỗi trang"
                                @onclick="() => SetRowsPerPage(3)">
                            3 hàng (@(ResponsiveColumns * 3))
                        </button>
                    </div>
                </div>

                <div class="flex items-center space-x-2">
                    <button type="button"
                            class="py-1 px-2.5 rounded text-[11px] font-medium border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="() => CurrentPage--">
                        ◀ Trước
                    </button>
                    <span class="px-2 font-mono text-[11.5px] text-white">
                        Trang @CurrentPage / @TotalPages
                    </span>
                    <button type="button"
                            class="py-1 px-2.5 rounded text-[11px] font-medium border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="() => CurrentPage++">
                        Tiếp ▶
                    </button>
                </div>
            </div>
        }

        <!-- Table / Gallery Bottom Action Bar -->
        <div class="border-t border-[#182234] p-3 flex items-center justify-between text-[11.5px] text-slate-400 flex-shrink-0"
             style="background-color: #0A0F1D;" @onclick:stopPropagation="true">
            <div style="color: #64748B;">
                @(SelectedEntry != null ? $"Đang chọn: {SelectedEntry.GameName}" : "Nhấp đúp vào game hoặc bấm 'Xem chi tiết game' để xem các bản snapshot.")
            </div>

            <div class="flex items-center space-x-2.5">
                <button type="button"
                        class="sv-btn-dark"
                        style="background-color: #059669; border-color: #10B981; color: #FFFFFF;"
                        disabled="@(SelectedEntry == null)"
                        @onclick="() => TriggerBackupSelected()">
                    <span>💾</span>
                    <span>Sao lưu game đã chọn</span>
                </button>

                <button type="button"
                        class="sv-btn-dark"
                        style="background-color: #1E3A8A; border-color: #3B82F6; color: #FFFFFF;"
                        disabled="@(SelectedEntry == null)"
                        @onclick="() => OpenGameDetails(SelectedEntry!)">
                    <span>📋</span>
                    <span>Xem chi tiết game đã chọn</span>
                </button>

                <button type="button"
                        class="sv-btn-dark"
                        style="background-color: #DC2626; border-color: #EF4444; color: #FFFFFF;"
                        disabled="@(SelectedEntry == null)"
                        @onclick="() => RequestDeleteGame(SelectedEntry!)">
                    <span>🗑</span>
                    <span>Xóa game đã chọn</span>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private HistorySubViewModel HistoryVM => VM.HistoryVM;
    private string FilterText { get; set; } = string.Empty;
    private GameHistoryEntry? SelectedEntry { get; set; }

    // Chế độ hiển thị: true = Gallery Game (Mặc định), false = Table
    private bool IsGalleryView { get; set; } = true;

    // Sắp xếp & Phân trang Thích ứng (Responsive Paging)
    private string SortColumn { get; set; } = "Date";
    private bool SortAscending { get; set; } = false; // Mặc định mới nhất lên đầu
    private int CurrentPage { get; set; } = 1;

    private int ResponsiveColumns { get; set; } = 5;
    private int RowsPerPage { get; set; } = 2;
    private DotNetObjectReference<HistoryTab>? _dotNetRef;

    private int PageSize => Math.Max(2, ResponsiveColumns * RowsPerPage);

    private void SetRowsPerPage(int rows)
    {
        RowsPerPage = rows;
        CurrentPage = 1;
    }

    [JSInvokable]
    public void OnGalleryColumnsChanged(int columns)
    {
        if (columns >= 2 && columns != ResponsiveColumns)
        {
            ResponsiveColumns = columns;
            InvokeAsync(StateHasChanged);
        }
    }

    private void SetViewMode(bool gallery)
    {
        IsGalleryView = gallery;
        if (CurrentPage > TotalPages) CurrentPage = Math.Max(1, TotalPages);
    }

    private List<GameHistoryEntry> ProcessedHistories
    {
        get
        {
            var list = HistoryVM.GameHistories.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(FilterText))
            {
                list = list.Where(x => x.GameName.Contains(FilterText, StringComparison.OrdinalIgnoreCase));
            }

            list = SortColumn switch
            {
                "GameName" => SortAscending ? list.OrderBy(x => x.GameName) : list.OrderByDescending(x => x.GameName),
                "Count" => SortAscending ? list.OrderBy(x => x.BackupCount) : list.OrderByDescending(x => x.BackupCount),
                "Date" => SortAscending ? list.OrderBy(x => x.LatestBackupDate) : list.OrderByDescending(x => x.LatestBackupDate),
                "LatestSize" => SortAscending ? list.OrderBy(x => x.LatestSizeBytes) : list.OrderByDescending(x => x.LatestSizeBytes),
                "TotalSize" => SortAscending ? list.OrderBy(x => x.TotalSizeBytes) : list.OrderByDescending(x => x.TotalSizeBytes),
                _ => list.OrderByDescending(x => x.LatestBackupDate)
            };

            return list.ToList();
        }
    }

    private int TotalItems => ProcessedHistories.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)PageSize));
    private int FromItem => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int ToItem => Math.Min(CurrentPage * PageSize, TotalItems);

    private List<GameHistoryEntry> PagedHistories
    {
        get
        {
            if (CurrentPage > TotalPages) CurrentPage = TotalPages;
            if (CurrentPage < 1) CurrentPage = 1;
            return ProcessedHistories.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = column;
            SortAscending = (column == "Date") ? false : true;
        }
        CurrentPage = 1;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        FilterText = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        FilterText = string.Empty;
        CurrentPage = 1;
    }

    private void DeselectEntry()
    {
        SelectedEntry = null;
    }

    private async Task TriggerBackupSelected()
    {
        if (SelectedEntry == null) return;
        VM.SelectedTabIndex = 0;
        await VM.SearchVM.LoadGameFromHistoryAsync(SelectedEntry);
    }

    protected override async Task OnInitializedAsync()
    {
        HistoryVM.PropertyChanged += OnStateChanged;
        await RefreshHistory();
    }

    private void OnStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (SelectedEntry != null && !HistoryVM.GameHistories.Contains(SelectedEntry))
        {
            SelectedEntry = null;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshHistory()
    {
        await HistoryVM.RefreshHistoryAsync();
    }

    private void OpenGameDetails(GameHistoryEntry entry)
    {
        HistoryVM.SelectedGameHistory = entry;
        HistoryVM.OpenGameDetailsCommand.Execute(entry);
    }

    private void RequestDeleteGame(GameHistoryEntry entry)
    {
        SelectedEntry = null;
        HistoryVM.RequestDeleteGameHistoryCommand.Execute(entry);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("galleryHelper.init", "gallery-container", _dotNetRef);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        HistoryVM.PropertyChanged -= OnStateChanged;
        try
        {
            _dotNetRef?.Dispose();
            _ = JSRuntime.InvokeVoidAsync("galleryHelper.dispose");
        }
        catch { }
    }
}

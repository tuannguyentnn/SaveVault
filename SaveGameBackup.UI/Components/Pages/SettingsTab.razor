@namespace SaveGameBackup.UI.Components.Pages
@inject MainViewModel VM
@inject INativeDialogService NativeDialog
@implements IDisposable

<div class="h-full flex flex-col p-5 space-y-4 overflow-hidden relative select-none">
    <!-- Floating Success Toast Notification -->
    @if (ShowSavedToast)
    {
        <div class="toast-notification toast-float flex items-center space-x-3 bg-emerald-950/95 border border-emerald-500/60 text-white px-5 py-3 rounded-xl shadow-2xl backdrop-blur-md">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center flex-shrink-0">
                <span class="text-emerald-400 font-bold text-sm">✓</span>
            </div>
            <div>
                <div class="text-[12.5px] font-bold text-emerald-300">Đã lưu cài đặt thành công!</div>
                <div class="text-[11px] text-slate-300">Cấu hình lưu trữ và thông tin Cloud API đã được ghi nhận.</div>
            </div>
        </div>
    }

    <!-- Header Card -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-4 shadow-lg flex items-center justify-between flex-shrink-0">
        <div class="flex items-center space-x-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/40 flex items-center justify-center shadow-inner">
                <span class="text-blue-400 font-bold text-lg">⚙️</span>
            </div>
            <div>
                <div class="flex items-center space-x-2">
                    <h2 class="text-[15px] font-bold text-white tracking-wide">CÀI ĐẶT HỆ THỐNG &amp; ĐỒNG BỘ</h2>
                    <span class="px-2 py-0.5 text-[10px] font-semibold bg-blue-950/80 text-blue-300 border border-blue-500/30 rounded-md">SaveVault Core</span>
                </div>
                <div class="text-[11.5px] text-slate-400 mt-0.5">
                    Quản lý thư mục lưu trữ, tài khoản Cloud REST API, SQLite database và nhật ký hoạt động.
                </div>
            </div>
        </div>

        <div class="flex items-center space-x-2.5">
            <button type="button"
                    class="btn-backup-primary py-2 px-5 text-[12.5px] flex items-center space-x-2 shadow-lg hover:shadow-emerald-500/20 transition-all cursor-pointer"
                    @onclick="SaveAllSettings">
                <span>💾</span>
                <span>Lưu Tất Cả Cài Đặt</span>
            </button>
        </div>
    </div>

    <!-- Segmented Sub-Navigation Pills -->
    <div class="flex items-center space-x-2 p-1.5 bg-[#131C2E] border border-[#1E293B] rounded-xl flex-shrink-0">
        <button type="button"
                class="subtab-pill @(ActiveSubTab == 0 ? "active" : "")"
                @onclick="() => ActiveSubTab = 0">
            <span>📁</span>
            <span>Lưu Trữ &amp; Sao Lưu</span>
        </button>

        <button type="button"
                class="subtab-pill @(ActiveSubTab == 1 ? "active" : "")"
                @onclick="() => ActiveSubTab = 1">
            <span>☁️</span>
            <span>Đồng Bộ Đám Mây</span>
            @if (CloudVM.IsGoogleDriveLoggedIn || CloudVM.IsOneDriveLoggedIn)
            {
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse ml-0.5"></span>
            }
        </button>

        <button type="button"
                class="subtab-pill @(ActiveSubTab == 2 ? "active" : "")"
                @onclick="() => ActiveSubTab = 2">
            <span>⚡</span>
            <span>Cơ Sở Dữ Liệu &amp; Game</span>
            <span class="px-1.5 py-0.2 rounded text-[10px] bg-slate-800 text-slate-400 border border-slate-700">@SettingsVM.CatalogGamesCount</span>
        </button>

        <button type="button"
                class="subtab-pill @(ActiveSubTab == 3 ? "active" : "")"
                @onclick="() => ActiveSubTab = 3">
            <span>🚀</span>
            <span>Cập Nhật &amp; Logs</span>
            @if (ErrCount > 0)
            {
                <span class="px-1.5 py-0.2 rounded text-[10px] bg-red-950 text-red-400 border border-red-700">@ErrCount lỗi</span>
            }
        </button>
    </div>

    <!-- Main Viewport Area -->
    <div class="sv-scroll-wrapper flex-1 min-h-0 flex flex-col" data-scroll-text="Còn cài đặt bên dưới (Cuộn)">
        <div class="flex-1 overflow-y-auto space-y-4 pr-1 sv-scroll-area">
        <!-- ==================== SUB-TAB 0: LƯU TRỮ & SAO LƯU ==================== -->
        @if (ActiveSubTab == 0 || ActiveSubTab == 4)
        {
            <div class="space-y-4">
                <!-- Thư mục gốc lưu trữ -->
                <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                        <div class="flex items-center space-x-2.5">
                            <span class="text-blue-400 text-lg">📁</span>
                            <div>
                                <h3 class="text-[13.5px] font-bold text-white uppercase tracking-wide">THƯ MỤC GỐC LƯU TRỮ CÁC BẢN SAO LƯU</h3>
                                <div class="text-[11px] text-slate-400">Vị trí mặc định trên máy để cất giữ các file zip hoặc thư mục save game</div>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between">
                            <label class="block text-[11px] text-slate-400 font-semibold">Đường dẫn thư mục sao lưu:</label>
                            <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-950/70 text-emerald-400 border border-emerald-500/30">
                                <span>🔒</span>
                                <span>Cố Định Theo Chuẩn Portable</span>
                            </span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <input type="text"
                                   class="input-dark font-mono text-[12px] py-2 px-3 flex-1 bg-[#0B101E] border-[#253248] text-slate-300 select-all cursor-default opacity-90"
                                   value="@SettingsVM.BackupDestinationRoot"
                                   readonly />
                            <button type="button"
                                    class="btn-secondary py-2 px-4 text-[12px] flex-shrink-0 flex items-center space-x-1.5 text-sky-300 hover:text-white border-sky-500/30"
                                    @onclick="OpenBackupFolder">
                                <span>📂</span>
                                <span>Mở Thư Mục</span>
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-400 leading-relaxed">
                            Toàn bộ bản sao lưu được lưu trữ an toàn và cố định bên trong thư mục <code class="text-sky-300 font-mono text-[11px]">data/backups/</code> của ứng dụng để đảm bảo tính toàn vẹn dữ liệu khi di chuyển thư mục hoặc chuyển sang máy tính khác.
                        </p>
                    </div>
                </div>

                <!-- Tùy chọn nén & đặt tên -->
                <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-4">
                    <div class="flex items-center space-x-2.5 pb-3 border-b border-[#1E293B]">
                        <span class="text-emerald-400 text-lg">⚙️</span>
                        <div>
                            <h3 class="text-[13.5px] font-bold text-white uppercase tracking-wide">TÙY CHỌN NÉN VÀ ĐẶT TÊN BẢN LƯU</h3>
                            <div class="text-[11px] text-slate-400">Tối ưu dung lượng đĩa cứng và phân loại lịch sử sao lưu</div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Toggle ZIP -->
                        <div class="p-4 bg-[#0F172A] border border-[#2D3748] rounded-xl flex items-start justify-between space-x-3">
                            <div class="space-y-1">
                                <div class="flex items-center space-x-2">
                                    <span class="text-[13px] font-bold text-white">Tự động nén thành file .ZIP</span>
                                    <span class="px-1.5 py-0.5 text-[9.5px] font-bold rounded bg-emerald-950 text-emerald-300 border border-emerald-500/40">Khuyên dùng</span>
                                </div>
                                <div class="text-[11px] text-slate-400 leading-relaxed">
                                    Tiết kiệm tới 80% dung lượng ổ đĩa, tăng tốc độ sao chép và đồng bộ đám mây nhanh hơn nhiều lần.
                                </div>
                            </div>
                            <label class="switch-toggle mt-1">
                                <input type="checkbox" @bind="SettingsVM.AutoCompressZip" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <!-- Toggle Timestamp -->
                        <div class="p-4 bg-[#0F172A] border border-[#2D3748] rounded-xl flex items-start justify-between space-x-3">
                            <div class="space-y-1">
                                <div class="text-[13px] font-bold text-white">Tạo thư mục con theo ngày giờ (Timestamp)</div>
                                <div class="text-[11px] text-slate-400 leading-relaxed">
                                    Tự động gom các bản lưu theo định dạng ngày giờ (YYYY-MM-DD_HH-mm-ss) tránh xung đột và ghi đè file.
                                </div>
                            </div>
                            <label class="switch-toggle mt-1">
                                <input type="checkbox" @bind="SettingsVM.CreateTimestampSubfolder" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <!-- Phân trang bảng dữ liệu -->
                    <div class="p-4 bg-[#0F172A] border border-[#2D3748] rounded-xl flex items-center justify-between">
                        <div class="space-y-0.5">
                            <div class="text-[12.5px] font-bold text-white">Số dòng hiển thị trên mỗi trang bảng dữ liệu</div>
                            <div class="text-[11px] text-slate-400">Áp dụng cho bảng Lịch sử sao lưu và bảng Chi tiết các bản lưu (Snapshot)</div>
                        </div>
                        <div class="w-56">
                            <select class="input-dark py-1.5 px-3 text-[12px] bg-[#0A0F1D] border-[#334155] text-slate-200 cursor-pointer"
                                    @bind="SettingsVM.PageSize">
                                <option value="5">5 dòng / trang</option>
                                <option value="10">10 dòng / trang (Mặc định)</option>
                                <option value="15">15 dòng / trang</option>
                                <option value="20">20 dòng / trang</option>
                                <option value="25">25 dòng / trang</option>
                                <option value="50">50 dòng / trang</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== SUB-TAB 1: ĐỒNG BỘ ĐÁM MÂY ==================== -->
        @if (ActiveSubTab == 1 || ActiveSubTab == 4)
        {
            <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-cyan-400 text-lg">☁️</span>
                        <div>
                            <h3 class="text-[13.5px] font-bold text-white uppercase tracking-wide">CẤU HÌNH ĐỒNG BỘ CLOUD (REST API OAuth PKCE)</h3>
                            <div class="text-[11px] text-slate-400">Kết nối Google Drive và OneDrive để tự động upload bản sao lưu lên đám mây</div>
                        </div>
                    </div>
                    <div class="text-[10.5px] font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2.5 py-1 rounded-md">
                        🔒 AES-256 Encrypted Token Storage
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                    <!-- ================= GOOGLE DRIVE CARD ================= -->
                    <div class="bg-[#0F172A] border border-[#2D3748] rounded-xl p-4 flex flex-col justify-between space-y-4 hover:border-slate-600 transition-all">
                        <div class="space-y-3.5">
                            <!-- Card Header -->
                            <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                                <div class="flex items-center space-x-2.5">
                                    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-base">
                                        📁
                                    </div>
                                    <div>
                                        <div class="font-bold text-white text-[13px]">Google Drive REST API</div>
                                        <div class="text-[10.5px] text-slate-400">Chuẩn OAuth 2.0 PKCE Public Client</div>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded-full text-[10.5px] font-semibold @(CloudVM.IsGoogleDriveLoggedIn ? "bg-emerald-950/80 text-emerald-300 border border-emerald-500/50" : "bg-slate-800 text-slate-400 border border-slate-700")">
                                    @(CloudVM.IsGoogleDriveLoggedIn ? (string.IsNullOrEmpty(CloudVM.GoogleDriveAccountEmail) ? "✓ Đã kết nối" : $"✓ {CloudVM.GoogleDriveAccountEmail}") : "○ Chưa kết nối")
                                </span>
                            </div>

                            @if (!CloudVM.UseCustomGoogleDriveApi)
                            {
                                <!-- Chế độ Tự Động 1-Click -->
                                <div class="p-3.5 bg-gradient-to-br from-emerald-950/30 to-[#0A0F1D] border border-emerald-500/30 rounded-xl space-y-2">
                                    <div class="flex items-center space-x-2 text-emerald-400 font-bold text-[12px]">
                                        <span>⚡</span>
                                        <span>Chế Độ Tự Động 1-Click (Khuyên dùng)</span>
                                    </div>
                                    <p class="text-[11px] text-slate-300 leading-relaxed">
                                        Đã cấu hình sẵn cho ứng dụng desktop SaveVault. Nhấn nút <b>Đăng Nhập OAuth</b> bên dưới để liên kết ngay tài khoản cá nhân.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <!-- Chế độ Tùy Chỉnh Cho Developer -->
                                <div class="space-y-3 text-[12px] bg-[#131C2E] p-3.5 rounded-xl border border-[#334155]">
                                    <div class="flex items-center justify-between">
                                        <div class="text-[11.5px] text-amber-400 font-semibold flex items-center space-x-1.5">
                                            <span>⚙️</span>
                                            <span>Đang dùng Google Cloud API riêng</span>
                                        </div>
                                        <button type="button"
                                                class="btn-secondary text-[10.5px] py-1 px-2.5 text-sky-300 hover:text-white border-sky-500/40 flex items-center space-x-1"
                                                @onclick="() => CloudVM.OpenGoogleCloudConsoleGuideCommand.Execute(null)">
                                            <span>📖</span>
                                            <span>Mở Cẩm Nang A-Z</span>
                                        </button>
                                    </div>

                                    <div class="space-y-2">
                                        <div>
                                            <label class="block text-slate-400 text-[11px] font-semibold mb-1">Google OAuth Client ID:</label>
                                            <input type="text"
                                                   class="input-dark font-mono text-[11px] py-1.5 px-3 bg-[#0A0F1D] border-[#334155] text-slate-200"
                                                   placeholder="xxxx.apps.googleusercontent.com"
                                                   @bind="CloudVM.GoogleDriveClientId" />
                                        </div>
                                        <div>
                                            <label class="block text-slate-400 text-[11px] font-semibold mb-1">Google Client Secret:</label>
                                            <div class="relative">
                                                <input type="@(ShowGSecret ? "text" : "password")"
                                                       class="input-dark font-mono text-[11px] py-1.5 px-3 pr-8 bg-[#0A0F1D] border-[#334155] text-slate-200"
                                                       placeholder="GOCSPX-xxxx"
                                                       @bind="CloudVM.GoogleDriveClientSecret" />
                                                <button type="button"
                                                        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs cursor-pointer"
                                                        @onclick="() => ShowGSecret = !ShowGSecret">
                                                    @(ShowGSecret ? "🙈" : "👁️")
                                                </button>
                                            </div>
                                        </div>
                                        <div class="pt-1">
                                            <button type="button"
                                                    class="btn-blue text-[11px] py-1 px-3"
                                                    @onclick="() => CloudVM.SaveCloudApiSettingsCommand.Execute(null)">
                                                💾 Lưu Cấu Hình API
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Switch Developer Mode -->
                            <div class="flex items-center justify-between pt-1">
                                <span class="text-[11.5px] text-slate-400">Tùy chỉnh Google Cloud API riêng (Dành cho Dev)</span>
                                <label class="switch-toggle">
                                    <input type="checkbox" @bind="CloudVM.UseCustomGoogleDriveApi" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>

                        <!-- Card Footer Actions -->
                        <div class="flex items-center justify-between pt-3 border-t border-[#1E293B]">
                            @if (CloudVM.UseCustomGoogleDriveApi)
                            {
                                <button type="button"
                                        class="btn-secondary text-[11px] py-1 px-2.5 text-sky-300 hover:text-white border-sky-500/40 flex items-center space-x-1"
                                        @onclick="() => CloudVM.OpenGoogleCloudConsoleGuideCommand.Execute(null)">
                                    <span>📖</span>
                                    <span>Xem Hướng Dẫn</span>
                                </button>
                            }
                            else
                            {
                                <span class="text-[11px] text-slate-500 font-mono">1-Click OAuth 2.0</span>
                            }

                            <div>
                                @if (CloudVM.IsGoogleDriveLoggedIn)
                                {
                                    <button type="button"
                                            class="btn-danger text-[11.5px] py-1.5 px-4 font-semibold shadow hover:bg-red-700"
                                            @onclick="() => DisconnectCloud(0)">
                                        🔓 Ngắt Kết Nối
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn-blue text-[11.5px] py-1.5 px-4 font-semibold shadow hover:bg-blue-600"
                                            @onclick="() => ConnectCloud(0)">
                                        🔗 Đăng Nhập OAuth
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ================= ONEDRIVE CARD ================= -->
                    <div class="bg-[#0F172A] border border-[#2D3748] rounded-xl p-4 flex flex-col justify-between space-y-4 hover:border-slate-600 transition-all">
                        <div class="space-y-3.5">
                            <!-- Card Header -->
                            <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                                <div class="flex items-center space-x-2.5">
                                    <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-base">
                                        ☁️
                                    </div>
                                    <div>
                                        <div class="font-bold text-white text-[13px]">Microsoft OneDrive (Graph API)</div>
                                        <div class="text-[10.5px] text-slate-400">Microsoft Identity PKCE Public Client</div>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded-full text-[10.5px] font-semibold @(CloudVM.IsOneDriveLoggedIn ? "bg-emerald-950/80 text-emerald-300 border border-emerald-500/50" : "bg-slate-800 text-slate-400 border border-slate-700")">
                                    @(CloudVM.IsOneDriveLoggedIn ? (string.IsNullOrEmpty(CloudVM.OneDriveAccountEmail) ? "✓ Đã kết nối" : $"✓ {CloudVM.OneDriveAccountEmail}") : "○ Chưa kết nối")
                                </span>
                            </div>

                            @if (!CloudVM.UseCustomOneDriveApi)
                            {
                                <!-- Chế độ Tự Động 1-Click -->
                                <div class="p-3.5 bg-gradient-to-br from-blue-950/30 to-[#0A0F1D] border border-blue-500/30 rounded-xl space-y-2">
                                    <div class="flex items-center space-x-2 text-blue-400 font-bold text-[12px]">
                                        <span>⚡</span>
                                        <span>Chế Độ Tự Động 1-Click (Khuyên dùng)</span>
                                    </div>
                                    <p class="text-[11px] text-slate-300 leading-relaxed">
                                        Sử dụng Microsoft PKCE Public Client. Kết nối trực tiếp vào tài khoản OneDrive cá nhân chỉ với 1 cú click an toàn.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <!-- Chế độ Tùy Chỉnh Cho Developer -->
                                <div class="space-y-3 text-[12px] bg-[#131C2E] p-3.5 rounded-xl border border-[#334155]">
                                    <div class="text-[11.5px] text-amber-400 font-semibold flex items-center space-x-1.5">
                                        <span>⚙️</span>
                                        <span>Đang dùng Azure Client ID riêng</span>
                                    </div>
                                    <div class="space-y-2">
                                        <div>
                                            <label class="block text-slate-400 text-[11px] font-semibold mb-1">Azure App Client ID:</label>
                                            <input type="text"
                                                   class="input-dark font-mono text-[11px] py-1.5 px-3 bg-[#0A0F1D] border-[#334155] text-slate-200"
                                                   placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                                   @bind="CloudVM.OneDriveClientId" />
                                        </div>
                                        <div class="text-[10.5px] text-slate-500">
                                            OneDrive sử dụng chuẩn OAuth 2.0 PKCE Public Client (không cần Client Secret).
                                        </div>
                                        <div class="flex items-center justify-between pt-1">
                                            <button type="button"
                                                    class="btn-blue text-[11px] py-1 px-3"
                                                    @onclick="() => CloudVM.SaveCloudApiSettingsCommand.Execute(null)">
                                                💾 Lưu Cấu Hình
                                            </button>
                                            <button type="button"
                                                    class="btn-secondary text-[11px] py-1 px-2.5 text-slate-400 hover:text-white"
                                                    @onclick="() => CloudVM.ResetOneDriveApiToDefault()">
                                                ↩ Về Mặc Định
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Switch Developer Mode -->
                            <div class="flex items-center justify-between pt-1">
                                <span class="text-[11.5px] text-slate-400">Tùy chỉnh Azure App Client ID riêng (Dành cho Dev)</span>
                                <label class="switch-toggle">
                                    <input type="checkbox" @bind="CloudVM.UseCustomOneDriveApi" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>

                        <!-- Card Footer Actions -->
                        <div class="flex items-center justify-between pt-3 border-t border-[#1E293B]">
                            @if (CloudVM.UseCustomOneDriveApi)
                            {
                                <button type="button"
                                        class="btn-secondary text-[11px] py-1 px-2.5 text-slate-400 hover:text-white"
                                        @onclick="() => CloudVM.OpenAzurePortalGuideCommand.Execute(null)">
                                    Hướng dẫn Azure App
                                </button>
                            }
                            else
                            {
                                <span class="text-[11px] text-slate-500 font-mono">1-Click PKCE</span>
                            }

                            <div>
                                @if (CloudVM.IsOneDriveLoggedIn)
                                {
                                    <button type="button"
                                            class="btn-danger text-[11.5px] py-1.5 px-4 font-semibold shadow hover:bg-red-700"
                                            @onclick="() => DisconnectCloud(1)">
                                        🔓 Ngắt Kết Nối
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn-blue text-[11.5px] py-1.5 px-4 font-semibold shadow hover:bg-blue-600"
                                            @onclick="() => ConnectCloud(1)">
                                        🔗 Đăng Nhập OAuth
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== SUB-TAB 2: DATABASE & GAME MANIFEST ==================== -->
        @if (ActiveSubTab == 2 || ActiveSubTab == 4)
        {
            <div class="space-y-4">

                <!-- Cơ chế Phân trang: SQL Pagination vs RAM Pagination -->
                <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                        <div class="flex items-center space-x-2.5">
                            <span class="text-cyan-400 text-lg">⚡</span>
                            <div>
                                <h3 class="text-[13.5px] font-bold text-white uppercase tracking-wide">CƠ CHẾ PHÂN TRANG (PAGINATION ENGINE)</h3>
                                <div class="text-[11px] text-slate-400">Tối ưu hóa hiệu năng truy vấn và mức tiêu thụ bộ nhớ RAM</div>
                            </div>
                        </div>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold rounded @(SettingsVM.UseSqlPagination ? "bg-cyan-950/80 text-cyan-300 border border-cyan-500/40" : "bg-amber-950/80 text-amber-300 border border-amber-500/40")">
                            @(SettingsVM.UseSqlPagination ? "⚡ SQL-level (Tối ưu RAM)" : "💾 In-Memory RAM (Cũ)")
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-4 rounded-xl border transition-all cursor-pointer @(SettingsVM.UseSqlPagination ? "bg-cyan-950/20 border-cyan-500/50 shadow-md" : "bg-[#0F172A] border-[#2D3748] opacity-70 hover:opacity-100")"
                             @onclick="() => SettingsVM.UseSqlPagination = true">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center space-x-2">
                                    <span class="text-cyan-400 font-bold text-base">⚡</span>
                                    <span class="font-bold text-[13px] text-white">SQL Pagination</span>
                                </div>
                                <span class="px-1.5 py-0.5 text-[9.5px] font-bold rounded bg-cyan-950 text-cyan-300 border border-cyan-500/40">Khuyên dùng</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Sử dụng mệnh đề <code class="text-cyan-300 font-mono">LIMIT / OFFSET</code> truy vấn trực tiếp từ SQLite. Tiết kiệm RAM tối đa, tốc độ cực nhanh kể cả với hàng ngàn bản lưu.
                            </p>
                        </div>

                        <div class="p-4 rounded-xl border transition-all cursor-pointer @(!SettingsVM.UseSqlPagination ? "bg-blue-950/20 border-blue-500/50 shadow-md" : "bg-[#0F172A] border-[#2D3748] opacity-70 hover:opacity-100")"
                             @onclick="() => SettingsVM.UseSqlPagination = false">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center space-x-2">
                                    <span class="text-blue-400 font-bold text-base">💾</span>
                                    <span class="font-bold text-[13px] text-white">RAM Pagination</span>
                                </div>
                                <span class="px-1.5 py-0.5 text-[9.5px] font-semibold rounded bg-slate-800 text-slate-400 border border-slate-700">Cơ chế cũ</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Nạp toàn bộ danh sách lịch sử sao lưu vào bộ nhớ RAM của ứng dụng rồi phân trang trên giao diện. Phù hợp khi cần tương thích đặc biệt.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Danh bạ Game & Ludusavi Manifest -->
                <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                        <div class="flex items-center space-x-2.5">
                            <span class="text-amber-400 text-lg">🎮</span>
                            <div>
                                <h3 class="text-[13.5px] font-bold text-white uppercase tracking-wide">CƠ SỞ DỮ LIỆU GAME (LUDUSAVI MANIFEST)</h3>
                                <div class="text-[11px] text-slate-400">Danh bạ vị trí thư mục save game tự động từ cộng đồng mã nguồn mở GitHub</div>
                            </div>
                        </div>
                        <span class="px-3 py-1 text-[11px] font-bold rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center space-x-1.5">
                            <span>🎮</span>
                            <span>@SettingsVM.CatalogGamesCount tựa game sẵn sàng</span>
                        </span>
                    </div>

                    <div class="p-4 bg-[#0F172A] border border-[#2D3748] rounded-xl space-y-3">
                        <div class="flex items-center justify-between flex-wrap gap-2">
                            <div class="space-y-0.5">
                                <div class="text-[12.5px] font-bold text-white flex items-center space-x-2">
                                    <span>Đồng bộ danh mục tựa game mới nhất</span>
                                    @if (SettingsVM.IsSyncingCatalog)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-950/80 text-cyan-300 border border-cyan-500/40 animate-pulse">
                                            Đang tải @SettingsVM.SyncProgressPercent%
                                        </span>
                                    }
                                </div>
                                <div class="text-[11px] text-slate-400">
                                    @(string.IsNullOrEmpty(SettingsVM.SyncCatalogStatus)
                                        ? (SettingsVM.AutoUpdateLudusaviManifest
                                            ? (SettingsVM.LastLudusaviSyncDate.HasValue
                                                ? $"Cập nhật hơn 12.000+ cấu hình game từ Ludusavi (Lần cuối: {SettingsVM.LastLudusaviSyncDate.Value:dd/MM/yyyy HH:mm} - Tự động {SettingsVM.LudusaviAutoUpdateDays} ngày/lần)."
                                                : $"Cập nhật hơn 12.000+ cấu hình đường dẫn game từ dự án Ludusavi (Tự động {SettingsVM.LudusaviAutoUpdateDays} ngày/lần).")
                                            : (SettingsVM.LastLudusaviSyncDate.HasValue
                                                ? $"Cập nhật hơn 12.000+ cấu hình game từ Ludusavi (Lần cuối: {SettingsVM.LastLudusaviSyncDate.Value:dd/MM/yyyy HH:mm} - Đã tắt tự động)."
                                                : "Cập nhật hơn 12.000+ cấu hình đường dẫn game từ dự án Ludusavi (Đã tắt tự động)."))
                                        : SettingsVM.SyncCatalogStatus)
                                </div>
                            </div>

                            <div class="flex items-center space-x-2">
                                @if (SettingsVM.IsSyncingCatalog)
                                {
                                    <button type="button"
                                            class="btn-secondary py-1.5 px-3 text-[12px] flex items-center space-x-1.5 text-red-300 hover:text-white hover:bg-red-600/30 border-red-500/40"
                                            @onclick="() => SettingsVM.CancelSync()">
                                        <span>✕</span>
                                        <span>Hủy</span>
                                    </button>
                                }
                                <button type="button"
                                        class="btn-backup-primary py-1.5 px-4 text-[12px] flex items-center space-x-2 cursor-pointer shadow"
                                        disabled="@SettingsVM.IsSyncingCatalog"
                                        @onclick="() => SettingsVM.SyncCatalogCommand.Execute(null)">
                                    <span>@(SettingsVM.IsSyncingCatalog ? "⏳" : "🔄")</span>
                                    <span>@(SettingsVM.IsSyncingCatalog ? "Đang đồng bộ..." : "Cập Nhật Từ GitHub")</span>

        <!-- ==================== SUB-TAB 3: CẬP NHẬT & LOGS ==================== -->
        @if (ActiveSubTab == 3 || ActiveSubTab == 4)
        {
            <!-- Card Phiên Bản & Cập Nhật Hệ Thống (Đưa lên trên Card Log) -->
            <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-3.5">
                <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-cyan-400 text-lg">🚀</span>
                        <div>
                            <h3 class="text-[13.5px] font-bold text-white uppercase tracking-wide">PHIÊN BẢN &amp; CẬP NHẬT ỨNG DỤNG</h3>
                            <div class="text-[11px] text-slate-400">Kiểm tra và nâng cấp trực tiếp từ repository bản build publish</div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold bg-cyan-950/80 text-cyan-300 border border-cyan-500/40">
                            v@(UpdateVM.CurrentVersion)
                        </span>
                    </div>
                </div>

                <div class="flex items-center justify-between flex-wrap gap-2 p-3 bg-[#0F172A] border border-[#2D3748] rounded-xl">
                    <div class="space-y-0.5">
                        <div class="text-[12px] font-semibold text-white">Trạng thái cập nhật hệ thống:</div>
                        <div class="text-[11px] text-slate-400">
                            @(string.IsNullOrEmpty(UpdateVM.StatusMessage) ? "Ứng dụng tự động kiểm tra bản build publish mới mỗi khi khởi động." : UpdateVM.StatusMessage)
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button type="button"
                                class="btn-secondary py-1.5 px-3.5 text-[12px] flex items-center space-x-1.5 text-sky-300 hover:text-white border-sky-500/30"
                                disabled="@UpdateVM.IsCheckingForUpdate"
                                @onclick="() => UpdateVM.CheckForUpdateCommand.Execute(null)">
                            <span>@(UpdateVM.IsCheckingForUpdate ? "⏳" : "🔄")</span>
                            <span>@(UpdateVM.IsCheckingForUpdate ? "Đang kiểm tra..." : "Kiểm Tra Bản Mới")</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card Nhật Ký Hoạt Động (Logs Console) -->
            <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-4">
                <!-- Log Header -->
                <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-slate-400 text-lg">📋</span>
                        <div>
                            <h3 class="text-[13.5px] font-bold text-white uppercase tracking-wide">NHẬT KÝ HOẠT ĐỘNG (ACTION LOGS CONSOLE)</h3>
                            <div class="text-[11px] text-slate-400">Ghi lại toàn bộ hành động sao lưu, khôi phục, đồng bộ đám mây và lỗi hệ thống</div>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button type="button"
                                class="btn-secondary text-[11px] py-1.5 px-3 flex items-center space-x-1.5 text-slate-300 hover:text-white"
                                @onclick="LoadRecentLogs">
                            <span>🔄</span>
                            <span>Làm Mới</span>
                        </button>
                        <button type="button"
                                class="btn-secondary text-[11px] py-1.5 px-3 flex items-center space-x-1.5 text-sky-300 hover:text-white border-sky-500/30"
                                @onclick="OpenLogsFolder">
                            <span>📂</span>
                            <span>Mở Thư Mục Logs</span>
                        </button>
                        <button type="button"
                                class="btn-secondary text-[11px] py-1.5 px-2.5 text-slate-400 hover:text-red-300"
                                @onclick="() => RecentLogs.Clear()"
                                title="Xóa tạm thời hiển thị log trên màn hình">
                            <span>🗑️</span>
                        </button>
                    </div>
                </div>

                <!-- Log Filter Bar -->
                <div class="flex items-center justify-between flex-wrap gap-2 p-2.5 bg-[#0F172A] border border-[#2D3748] rounded-xl">
                    <div class="flex items-center space-x-2">
                        <span class="text-[11px] text-slate-400 font-semibold">Lọc mức độ:</span>
                        <button type="button"
                                class="px-2.5 py-1 rounded text-[10.5px] font-semibold transition-all cursor-pointer @(SelectedLogLevelFilter == "ALL" ? "bg-blue-600 text-white shadow" : "bg-[#1E293B] text-slate-400 hover:text-white")"
                                @onclick='() => SelectedLogLevelFilter = "ALL"'>
                            Tất cả (@RecentLogs.Count)
                        </button>
                        <button type="button"
                                class="px-2.5 py-1 rounded text-[10.5px] font-semibold transition-all cursor-pointer @(SelectedLogLevelFilter == "INFO" ? "bg-emerald-600 text-white shadow" : "bg-[#1E293B] text-emerald-400 hover:text-white")"
                                @onclick='() => SelectedLogLevelFilter = "INFO"'>
                            INFO (@InfoCount)
                        </button>
                        <button type="button"
                                class="px-2.5 py-1 rounded text-[10.5px] font-semibold transition-all cursor-pointer @(SelectedLogLevelFilter == "WARN" ? "bg-amber-600 text-white shadow" : "bg-[#1E293B] text-amber-400 hover:text-white")"
                                @onclick='() => SelectedLogLevelFilter = "WARN"'>
                            WARN (@WarnCount)
                        </button>
                        <button type="button"
                                class="px-2.5 py-1 rounded text-[10.5px] font-semibold transition-all cursor-pointer @(SelectedLogLevelFilter == "ERR" ? "bg-red-600 text-white shadow" : "bg-[#1E293B] text-red-400 hover:text-white")"
                                @onclick='() => SelectedLogLevelFilter = "ERR"'>
                            ERR (@ErrCount)
                        </button>
                    </div>

                    <div class="w-64">
                        <input type="text"
                               class="input-dark text-[11px] py-1 px-3 bg-[#0A0F1D] border-[#334155] text-slate-200"
                               placeholder="🔍 Tìm kiếm trong nhật ký..."
                               @bind="SearchLogKeyword"
                               @bind:event="oninput" />
                    </div>
                </div>

                <!-- Log Console Box -->
                <div class="sv-scroll-wrapper" data-scroll-text="Còn nhật ký bên dưới (Cuộn)">
                    <div class="bg-[#0A0F1D] border border-[#2D3748] rounded-xl p-3 font-mono text-[11px] text-slate-300 min-h-[220px] max-h-[380px] overflow-y-auto space-y-1.5 shadow-inner sv-scroll-area">
                        @if (!FilteredLogs.Any())
                        {
                            <div class="text-slate-500 italic py-8 text-center flex flex-col items-center justify-center space-y-2">
                                <span class="text-2xl">📋</span>
                                <span>Không tìm thấy bản ghi nhật ký phù hợp với bộ lọc.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var log in FilteredLogs)
                            {
                                <div class="flex items-start space-x-2 py-1 px-1.5 rounded hover:bg-slate-800/50 border-b border-[#1E293B]/30 last:border-0 transition-colors">
                                    <span class="text-slate-500 shrink-0 select-none text-[10.5px]">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                                    <span class="px-1.5 py-0.2 rounded text-[9.5px] font-bold shrink-0 @log.BadgeClass">@log.ShortLevel</span>
                                    <span class="text-slate-200 break-all leading-relaxed">@log.Message</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        </div>
    </div>
</div>

@code {
    private SettingsSubViewModel SettingsVM => VM.SettingsVM;
    private CloudSubViewModel CloudVM => VM.CloudVM;
    private UpdateSubViewModel UpdateVM => VM.UpdateVM;

    private int ActiveSubTab { get; set; } = 0;
    private bool ShowGSecret { get; set; }
    private bool ShowSavedToast { get; set; }
    private string SelectedLogLevelFilter { get; set; } = "ALL";
    private string SearchLogKeyword { get; set; } = string.Empty;
    private List<LogEntryItem> RecentLogs { get; set; } = new();

    private IEnumerable<LogEntryItem> FilteredLogs
    {
        get
        {
            var list = RecentLogs.AsEnumerable();
            if (SelectedLogLevelFilter != "ALL")
            {
                list = list.Where(l => l.ShortLevel.Equals(SelectedLogLevelFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(SearchLogKeyword))
            {
                list = list.Where(l => l.Message.Contains(SearchLogKeyword, StringComparison.OrdinalIgnoreCase));
            }
            return list;
        }
    }

    private int InfoCount => RecentLogs.Count(l => l.ShortLevel == "INFO");
    private int WarnCount => RecentLogs.Count(l => l.ShortLevel == "WARN");
    private int ErrCount => RecentLogs.Count(l => l.ShortLevel == "ERR");

    protected override void OnInitialized()
    {
        SettingsVM.PropertyChanged += OnStateChanged;
        CloudVM.PropertyChanged += OnStateChanged;
        UpdateVM.PropertyChanged += OnStateChanged;
        LoadRecentLogs();
    }

    private void OnStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SaveAllSettings()
    {
        await SettingsVM.ExecuteSaveSettingsAsync();
        await CloudVM.ExecuteSaveCloudApiSettingsAsync();

        ShowSavedToast = true;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            ShowSavedToast = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ConnectCloud(int providerIndex)
    {
        if (providerIndex == 0)
            await CloudVM.ConnectGoogleDriveAsync();
        else
            await CloudVM.ConnectOneDriveAsync();
    }

    private async Task DisconnectCloud(int providerIndex)
    {
        if (providerIndex == 0)
            await CloudVM.DisconnectGoogleDriveAsync();
        else
            await CloudVM.DisconnectOneDriveAsync();
    }

    private string GetResolvedLogsDirectory()
    {
        return !string.IsNullOrWhiteSpace(LoggingService.LogDirectory) && Directory.Exists(LoggingService.LogDirectory)
            ? LoggingService.LogDirectory
            : Path.Combine(DatabaseService.GetDefaultProjectRoot(), "data", "logs");
    }

    private void OpenLogsFolder()
    {
        var logsDir = GetResolvedLogsDirectory();
        if (!Directory.Exists(logsDir))
        {
            try { Directory.CreateDirectory(logsDir); } catch { }
        }
        NativeDialog.OpenFolderInExplorer(logsDir);
    }

    private void OpenBackupFolder()
    {
        var backupDir = SettingsVM.BackupDestinationRoot;
        if (!string.IsNullOrWhiteSpace(backupDir))
        {
            if (!Directory.Exists(backupDir))
            {
                try { Directory.CreateDirectory(backupDir); } catch { }
            }
            NativeDialog.OpenFolderInExplorer(backupDir);
        }
    }


    private void LoadRecentLogs()
    {
        try
        {
            var logsDir = GetResolvedLogsDirectory();
            if (!Directory.Exists(logsDir))
            {
                RecentLogs = new();
                return;
            }

            var files = Directory.GetFiles(logsDir, "*.json").OrderByDescending(f => f).ToList();
            if (files.Count == 0)
            {
                RecentLogs = new();
                return;
            }

            var targetFile = files[0];
            var parsed = new List<LogEntryItem>();

            using (var fs = new FileStream(targetFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
            using (var reader = new StreamReader(fs))
            {
                var lines = new List<string>();
                string? line;
                while ((line = reader.ReadLine()) != null)
                {
                    if (!string.IsNullOrWhiteSpace(line))
                        lines.Add(line);
                }

                var latestLines = lines.TakeLast(50).Reverse();

                foreach (var rawLine in latestLines)
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(rawLine);
                        var root = doc.RootElement;

                        DateTime ts = DateTime.Now;
                        if (root.TryGetProperty("Timestamp", out var tsEl) && tsEl.TryGetDateTime(out var dt))
                            ts = dt;

                        string lvl = "Info";
                        if (root.TryGetProperty("Level", out var lvlEl))
                            lvl = lvlEl.GetString() ?? "Info";

                        string msg = "";
                        if (root.TryGetProperty("RenderedMessage", out var rmEl))
                            msg = rmEl.GetString() ?? "";
                        else if (root.TryGetProperty("MessageTemplate", out var mtEl))
                            msg = mtEl.GetString() ?? "";

                        if (string.IsNullOrWhiteSpace(msg) && root.TryGetProperty("Properties", out var propEl))
                            msg = propEl.ToString();

                        parsed.Add(new LogEntryItem(ts, lvl, msg));
                    }
                    catch
                    {
                        parsed.Add(new LogEntryItem(DateTime.Now, "Info", rawLine));
                    }
                }
            }

            RecentLogs = parsed;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SettingsTab] LoadRecentLogs error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        SettingsVM.PropertyChanged -= OnStateChanged;
        CloudVM.PropertyChanged -= OnStateChanged;
        UpdateVM.PropertyChanged -= OnStateChanged;
    }

    private record LogEntryItem(DateTime Timestamp, string Level, string Message)
    {
        public string ShortLevel => Level.ToUpperInvariant() switch
        {
            "WARNING" or "WARN" => "WARN",
            "ERROR" or "FATAL" => "ERR",
            "DEBUG" => "DBG",
            _ => "INFO"
        };

        public string BadgeClass => Level.ToUpperInvariant() switch
        {
            "WARNING" or "WARN" => "text-amber-300 bg-amber-950/80 border border-amber-700/60",
            "ERROR" or "FATAL" => "text-red-300 bg-red-950/80 border border-red-700/60",
            "DEBUG" => "text-slate-400 bg-slate-800 border border-slate-700",
            _ => "text-emerald-300 bg-emerald-950/80 border border-emerald-700/60"
        };
    }
}

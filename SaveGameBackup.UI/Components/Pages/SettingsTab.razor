@namespace SaveGameBackup.UI.Components.Pages
@inject MainViewModel VM
@inject INativeDialogService NativeDialog
@implements IDisposable

<div class="h-full flex flex-col p-5 space-y-4 overflow-y-auto">
    <!-- Header Card -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-4 shadow-lg flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-lg bg-blue-600/20 border border-blue-500/40 flex items-center justify-center">
                <span class="text-blue-400 font-bold text-base">⚙️</span>
            </div>
            <div>
                <h2 class="text-[15px] font-bold text-white tracking-wide">CÀI ĐẶT HỆ THỐNG & CLOUD SYNC</h2>
                <div class="text-[11px] text-slate-400">
                    Cấu hình đường dẫn lưu trữ, kết nối Cloud REST API (Google Drive & OneDrive), và vị trí database SQLite.
                </div>
            </div>
        </div>

        <button class="btn-backup-primary py-2 px-5 text-[13px]"
                @onclick="SaveAllSettings">
            💾 Lưu Tất Cả Cài Đặt
        </button>
    </div>

    <!-- Section 1: Thư Mục Lưu Trữ Sao Lưu (Image 8.JPG) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center space-x-2 mb-3">
            <span class="text-blue-400 font-bold">📁</span>
            <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">THƯ MỤC GỐC LƯU TRỮ CÁC BẢN SAO LƯU</h3>
        </div>

        <div class="space-y-3">
            <div>
                <label class="block text-[11px] text-slate-400 font-semibold mb-1">Đường dẫn thư mục sao lưu mặc định:</label>
                <div class="flex items-center space-x-2">
                    <input type="text"
                           class="input-dark font-mono text-[12px] py-2 px-3 flex-1 bg-[#0F172A] border-[#334155] text-slate-200"
                           @bind="SettingsVM.BackupDestinationRoot" />
                    <button class="btn-secondary py-2 px-4 text-[12px] flex-shrink-0"
                            @onclick="() => SettingsVM.BrowseBackupDirectoryCommand.Execute(null)">
                        📁 Duyệt...
                    </button>
                </div>
            </div>

            <div class="flex items-center space-x-6 pt-1">
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox"
                           class="checkbox-custom"
                           @bind="SettingsVM.CreateTimestampSubfolder" />
                    <span class="text-[12px] text-slate-200 font-medium">Tạo thư mục con theo ngày giờ (Timestamp)</span>
                </label>
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox"
                           class="checkbox-custom"
                           @bind="SettingsVM.AutoCompressZip" />
                    <span class="text-[12px] text-slate-200 font-medium">Tự động nén thành file .ZIP (Khuyên dùng)</span>
                </label>
            </div>

            <div class="pt-3 border-t border-[#1E293B] flex items-center justify-between">
                <div>
                    <label class="block text-[11.5px] text-slate-300 font-semibold mb-0.5">Số dòng trên mỗi trang (Phân trang bảng dữ liệu):</label>
                    <span class="text-[11px] text-slate-500">Áp dụng cho bảng Lịch sử sao lưu và bảng Chi tiết các bản lưu (Snapshot)</span>
                </div>
                <div class="w-52">
                    <select class="input-dark py-1.5 px-3 text-[12px] bg-[#0F172A] border-[#334155] text-slate-200 cursor-pointer"
                            @bind="SettingsVM.PageSize">
                        <option value="5">5 dòng / trang</option>
                        <option value="10">10 dòng / trang (Mặc định)</option>
                        <option value="15">15 dòng / trang</option>
                        <option value="20">20 dòng / trang</option>
                        <option value="25">25 dòng / trang</option>
                        <option value="50">50 dòng / trang</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Cấu Hình Cloud Sync REST API (Image 8.JPG) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-2">
                <span class="text-cyan-400 font-bold">☁️</span>
                <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">CẤU HÌNH ĐỒNG BỘ CLOUD (REST API OAuth PKCE)</h3>
            </div>
            <span class="text-[11px] text-slate-400">
                Toàn bộ Client ID / Secret được mã hóa AES-256 trong <code class="text-slate-300 font-mono">app_config.json</code>
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Google Drive Box -->
            <div class="bg-[#0F172A] border border-[#2D3748] rounded-xl p-4 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#1E293B]">
                        <div class="flex items-center space-x-2">
                            <span class="text-[18px]">📁</span>
                            <span class="font-bold text-white text-[13px]">Google Drive REST API</span>
                        </div>
                        <span class="badge-count text-[10px] @(CloudVM.IsGoogleDriveLoggedIn ? "bg-emerald-600/30 text-emerald-400 border border-emerald-500/30" : "bg-slate-700/50 text-slate-400")">
                            @(CloudVM.IsGoogleDriveLoggedIn ? (string.IsNullOrEmpty(CloudVM.GoogleDriveAccountEmail) ? "✓ Đã kết nối" : $"✓ {CloudVM.GoogleDriveAccountEmail}") : "Chưa kết nối")
                        </span>
                    </div>

                    <div class="space-y-3 text-[12px]">
                        <div>
                            <label class="block text-slate-400 text-[11px] font-semibold mb-1">Google OAuth Client ID:</label>
                            <input type="text"
                                   class="input-dark font-mono text-[11px] py-1.5 px-3 bg-[#131C2E] border-[#334155] text-slate-200"
                                   placeholder="xxxx.apps.googleusercontent.com"
                                   @bind="CloudVM.GoogleDriveClientId" />
                        </div>
                        <div>
                            <label class="block text-slate-400 text-[11px] font-semibold mb-1">Google Client Secret:</label>
                            <div class="relative">
                                <input type="@(ShowGSecret ? "text" : "password")"
                                       class="input-dark font-mono text-[11px] py-1.5 px-3 pr-8 bg-[#131C2E] border-[#334155] text-slate-200"
                                       placeholder="GOCSPX-xxxx"
                                       @bind="CloudVM.GoogleDriveClientSecret" />
                                <button class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs"
                                        @onclick="() => ShowGSecret = !ShowGSecret">
                                    @(ShowGSecret ? "🙈" : "👁️")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 mt-3 border-t border-[#1E293B]">
                    <button class="btn-secondary text-[11px] py-1 px-2 text-slate-400 hover:text-white"
                            @onclick="() => CloudVM.OpenGoogleCloudConsoleGuideCommand.Execute(null)">
                        Hướng dẫn tạo API
                    </button>
                    <div class="flex items-center space-x-2">
                        @if (CloudVM.IsGoogleDriveLoggedIn)
                        {
                            <button class="btn-danger text-[11px] py-1 px-3"
                                    @onclick="() => DisconnectCloud(0)">
                                Ngắt Kết Nối
                            </button>
                        }
                        else
                        {
                            <button class="btn-blue text-[11px] py-1 px-3"
                                    @onclick="() => ConnectCloud(0)">
                                🔗 Đăng Nhập OAuth
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Microsoft OneDrive Box -->
            <div class="bg-[#0F172A] border border-[#2D3748] rounded-xl p-4 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#1E293B]">
                        <div class="flex items-center space-x-2">
                            <span class="text-[18px]">☁️</span>
                            <span class="font-bold text-white text-[13px]">Microsoft OneDrive (Graph API)</span>
                        </div>
                        <span class="badge-count text-[10px] @(CloudVM.IsOneDriveLoggedIn ? "bg-emerald-600/30 text-emerald-400 border border-emerald-500/30" : "bg-slate-700/50 text-slate-400")">
                            @(CloudVM.IsOneDriveLoggedIn ? (string.IsNullOrEmpty(CloudVM.OneDriveAccountEmail) ? "✓ Đã kết nối" : $"✓ {CloudVM.OneDriveAccountEmail}") : "Chưa kết nối")
                        </span>
                    </div>

                    <div class="space-y-3 text-[12px]">
                        <div>
                            <label class="block text-slate-400 text-[11px] font-semibold mb-1">Azure App Client ID:</label>
                            <input type="text"
                                   class="input-dark font-mono text-[11px] py-1.5 px-3 bg-[#131C2E] border-[#334155] text-slate-200"
                                   placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                   @bind="CloudVM.OneDriveClientId" />
                        </div>
                        <div class="text-[11px] text-slate-500 pt-3">
                            OneDrive sử dụng chuẩn OAuth 2.0 PKCE Public Client (không cần Client Secret).
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 mt-3 border-t border-[#1E293B]">
                    <button class="btn-secondary text-[11px] py-1 px-2 text-slate-400 hover:text-white"
                            @onclick="() => CloudVM.OpenAzurePortalGuideCommand.Execute(null)">
                        Hướng dẫn Azure App
                    </button>
                    <div class="flex items-center space-x-2">
                        @if (CloudVM.IsOneDriveLoggedIn)
                        {
                            <button class="btn-danger text-[11px] py-1 px-3"
                                    @onclick="() => DisconnectCloud(1)">
                                Ngắt Kết Nối
                            </button>
                        }
                        else
                        {
                            <button class="btn-blue text-[11px] py-1 px-3"
                                    @onclick="() => ConnectCloud(1)">
                                🔗 Đăng Nhập OAuth
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Cơ Sở Dữ Liệu SQLite (Image 8.JPG) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center space-x-2 mb-3">
            <span class="text-emerald-400 font-bold">🗄️</span>
            <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">CƠ SỞ DỮ LIỆU SQLITE (SaveVault.db)</h3>
        </div>

        <div class="space-y-3">
            <div>
                <label class="block text-[11px] text-slate-400 font-semibold mb-1">Vị trí file cơ sở dữ liệu hiện tại:</label>
                <div class="flex items-center space-x-2">
                    <input type="text"
                           class="input-dark font-mono text-[12px] py-2 px-3 flex-1 bg-[#0F172A] border-[#334155] text-slate-200"
                           @bind="SettingsVM.DatabaseLocation" />
                    <button class="btn-secondary py-2 px-3 text-[12px] flex-shrink-0"
                            @onclick="() => SettingsVM.BrowseDatabaseFileCommand.Execute(null)">
                        📂 Duyệt...
                    </button>
                    <button class="btn-blue py-2 px-3 text-[12px] flex-shrink-0"
                            @onclick="() => SettingsVM.ApplyDatabaseLocationCommand.Execute(null)">
                        Áp Dụng
                    </button>
                    <button class="btn-secondary py-2 px-3 text-[12px] flex-shrink-0 text-slate-400 hover:text-white"
                            @onclick="() => SettingsVM.ResetDatabaseLocationCommand.Execute(null)">
                        Khôi Phục Mặc Định
                    </button>
                </div>
            </div>
            <div class="text-[11px] text-slate-400">
                Lưu trữ master-detail lịch sử sao lưu (Dapper + SQLite) và game cache offline.
            </div>
        </div>
    </div>

    <!-- Section 4: Nhật Ký Hoạt Động (Action Logs) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center space-x-2">
                <span class="text-slate-400 font-bold">📋</span>
                <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">NHẬT KÝ HOẠT ĐỘNG (ACTION LOGS)</h3>
            </div>
            <button class="btn-secondary text-[11px] py-1 px-2.5"
                    @onclick="OpenLogsFolder">
                📂 Mở Thư Mục Logs
            </button>
        </div>

        <div class="bg-[#0F172A] border border-[#2D3748] rounded-lg p-3 font-mono text-[11px] text-slate-300 max-h-[140px] overflow-y-auto space-y-1">
            @if (RecentLogs.Count == 0)
            {
                <div class="text-slate-500 italic">Chưa có bản ghi hoạt động nào. Các thao tác sao lưu, khôi phục, xóa sẽ được ghi nhận tại đây.</div>
            }
            else
            {
                @foreach (var log in RecentLogs)
                {
                    <div class="break-all">@log</div>
                }
            }
        </div>
    </div>
</div>

@code {
    private SettingsSubViewModel SettingsVM => VM.SettingsVM;
    private CloudSubViewModel CloudVM => VM.CloudVM;

    private bool ShowGSecret { get; set; }
    private List<string> RecentLogs { get; set; } = new();

    protected override void OnInitialized()
    {
        SettingsVM.PropertyChanged += OnStateChanged;
        CloudVM.PropertyChanged += OnStateChanged;
        LoadRecentLogs();
    }

    private void OnStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SaveAllSettings()
    {
        await SettingsVM.ExecuteSaveSettingsAsync();
        await CloudVM.ExecuteSaveCloudApiSettingsAsync();
    }

    private async Task ConnectCloud(int providerIndex)
    {
        if (providerIndex == 0)
            await CloudVM.ConnectGoogleDriveAsync();
        else
            await CloudVM.ConnectOneDriveAsync();
    }

    private async Task DisconnectCloud(int providerIndex)
    {
        if (providerIndex == 0)
            await CloudVM.DisconnectGoogleDriveAsync();
        else
            await CloudVM.DisconnectOneDriveAsync();
    }

    private void OpenLogsFolder()
    {
        var logsDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "logs");
        NativeDialog.OpenFolderInExplorer(logsDir);
    }

    private void LoadRecentLogs()
    {
        try
        {
            var logsDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "logs");
            if (Directory.Exists(logsDir))
            {
                var files = Directory.GetFiles(logsDir, "actions-*.json").OrderByDescending(f => f).ToList();
                if (files.Count > 0)
                {
                    var lines = File.ReadLines(files[0]).Reverse().Take(15).Reverse().ToList();
                    RecentLogs = lines;
                }
            }
        }
        catch { }
    }

    public void Dispose()
    {
        SettingsVM.PropertyChanged -= OnStateChanged;
        CloudVM.PropertyChanged -= OnStateChanged;
    }
}

                                    {
                                        <span class="px-2 py-0.2 rounded text-[10px] font-semibold bg-emerald-950 text-emerald-400 border border-emerald-700">Đang bật</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.2 rounded text-[10px] font-semibold bg-slate-800 text-slate-400 border border-slate-700">Đã tắt</span>
                                    }
                                </div>
                                <div class="text-[11px] text-slate-400 leading-relaxed">
                                    Tự động tải ngầm file manifest mới nhất khi mở ứng dụng theo chu kỳ định kỳ, không làm gián đoạn trải nghiệm người dùng.
                                </div>
                            </div>
                            <label class="switch-toggle mt-1">
                                <input type="checkbox" @bind="SettingsVM.AutoUpdateLudusaviManifest" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        @if (SettingsVM.AutoUpdateLudusaviManifest)
                        {
                            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between flex-wrap gap-2">
                                <div class="space-y-0.5">
                                    <div class="text-[12px] font-semibold text-slate-200">Chu kỳ tự động cập nhật:</div>
                                    <div class="text-[10.5px] text-slate-400">Khoảng thời gian tự động đồng bộ lại từ GitHub</div>
                                </div>
                                <div class="w-48">
                                    <select class="input-dark py-1.5 px-3 text-[12px] bg-[#0A0F1D] border-[#334155] text-slate-200 cursor-pointer"
                                            @bind="SettingsVM.LudusaviAutoUpdateDays">
                                        <option value="15">15 ngày (Mặc định)</option>

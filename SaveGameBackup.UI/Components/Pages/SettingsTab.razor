@namespace SaveGameBackup.UI.Components.Pages
@inject MainViewModel VM
@inject INativeDialogService NativeDialog
@implements IDisposable

<div class="h-full flex flex-col p-5 space-y-4 overflow-y-auto">
    <!-- Header Card -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-4 shadow-lg flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-lg bg-blue-600/20 border border-blue-500/40 flex items-center justify-center">
                <span class="text-blue-400 font-bold text-base">⚙️</span>
            </div>
            <div>
                <h2 class="text-[15px] font-bold text-white tracking-wide">CÀI ĐẶT HỆ THỐNG & CLOUD SYNC</h2>
                <div class="text-[11px] text-slate-400">
                    Cấu hình đường dẫn lưu trữ, kết nối Cloud REST API (Google Drive & OneDrive), và vị trí database SQLite.
                </div>
            </div>
        </div>

        <button class="btn-backup-primary py-2 px-5 text-[13px]"
                @onclick="SaveAllSettings">
            💾 Lưu Tất Cả Cài Đặt
        </button>
    </div>

    <!-- Section 1: Thư Mục Lưu Trữ Sao Lưu (Image 8.JPG) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center space-x-2 mb-3">
            <span class="text-blue-400 font-bold">📁</span>
            <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">THƯ MỤC GỐC LƯU TRỮ CÁC BẢN SAO LƯU</h3>
        </div>

        <div class="space-y-3">
            <div>
                <label class="block text-[11px] text-slate-400 font-semibold mb-1">Đường dẫn thư mục sao lưu mặc định:</label>
                <div class="flex items-center space-x-2">
                    <input type="text"
                           class="input-dark font-mono text-[12px] py-2 px-3 flex-1 bg-[#0F172A] border-[#334155] text-slate-200"
                           @bind="SettingsVM.BackupDestinationRoot" />
                    <button class="btn-secondary py-2 px-4 text-[12px] flex-shrink-0"
                            @onclick="() => SettingsVM.BrowseBackupDirectoryCommand.Execute(null)">
                        📁 Duyệt...
                    </button>
                </div>
            </div>

            <div class="flex items-center space-x-6 pt-1">
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox"
                           class="checkbox-custom"
                           @bind="SettingsVM.CreateTimestampSubfolder" />
                    <span class="text-[12px] text-slate-200 font-medium">Tạo thư mục con theo ngày giờ (Timestamp)</span>
                </label>
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox"
                           class="checkbox-custom"
                           @bind="SettingsVM.AutoCompressZip" />
                    <span class="text-[12px] text-slate-200 font-medium">Tự động nén thành file .ZIP (Khuyên dùng)</span>
                </label>
            </div>

            <div class="pt-3 border-t border-[#1E293B] flex items-center justify-between">
                <div>
                    <label class="block text-[11.5px] text-slate-300 font-semibold mb-0.5">Số dòng trên mỗi trang (Phân trang bảng dữ liệu):</label>
                    <span class="text-[11px] text-slate-500">Áp dụng cho bảng Lịch sử sao lưu và bảng Chi tiết các bản lưu (Snapshot)</span>
                </div>
                <div class="w-52">
                    <select class="input-dark py-1.5 px-3 text-[12px] bg-[#0F172A] border-[#334155] text-slate-200 cursor-pointer"
                            @bind="SettingsVM.PageSize">
                        <option value="5">5 dòng / trang</option>
                        <option value="10">10 dòng / trang (Mặc định)</option>
                        <option value="15">15 dòng / trang</option>
                        <option value="20">20 dòng / trang</option>
                        <option value="25">25 dòng / trang</option>
                        <option value="50">50 dòng / trang</option>
                    </select>
                </div>
            </div>

            <!-- Cơ chế Phân trang: SQL Pagination vs RAM Pagination -->
            <div class="pt-3 border-t border-[#1E293B] flex items-center justify-between">
                <div>
                    <div class="flex items-center space-x-2">
                        <label class="text-[11.5px] text-slate-300 font-semibold">Cơ chế phân trang (Pagination Engine):</label>
                        <span class="px-1.5 py-0.5 text-[9.5px] font-bold rounded @(SettingsVM.UseSqlPagination ? "bg-cyan-950/80 text-cyan-300 border border-cyan-500/40" : "bg-amber-950/80 text-amber-300 border border-amber-500/40")">
                            @(SettingsVM.UseSqlPagination ? "⚡ SQL-level (Tối ưu)" : "💾 In-Memory RAM (Cũ)")
                        </span>
                    </div>
                    <span class="text-[11px] text-slate-500 block mt-0.5">
                        @(SettingsVM.UseSqlPagination 
                            ? "SQL Pagination: Truy vấn trực tiếp phân trang từ SQLite bằng LIMIT/OFFSET (Tối ưu RAM tối đa, tốc độ cực nhanh với hàng ngàn bản lưu)." 
                            : "RAM Pagination: Nạp toàn bộ lịch sử game vào bộ nhớ RAM rồi phân trang trên giao diện (Cơ chế hoạt động cũ).")
                    </span>
                </div>
                <div class="inline-flex rounded-lg p-0.5 bg-[#0F172A] border border-[#334155] flex-shrink-0">
                    <button type="button"
                            class="px-3 py-1.5 text-[11.5px] font-semibold rounded-md transition-all flex items-center space-x-1.5 @(SettingsVM.UseSqlPagination ? "bg-cyan-600 text-white shadow" : "text-slate-400 hover:text-slate-200")"
                            @onclick="() => SettingsVM.UseSqlPagination = true"
                            title="Sử dụng phân trang trực tiếp từ SQLite Database (Khuyên dùng)">
                        <span>⚡</span>
                        <span>SQL Pagination</span>
                    </button>
                    <button type="button"
                            class="px-3 py-1.5 text-[11.5px] font-semibold rounded-md transition-all flex items-center space-x-1.5 @(!SettingsVM.UseSqlPagination ? "bg-blue-600 text-white shadow" : "text-slate-400 hover:text-slate-200")"
                            @onclick="() => SettingsVM.UseSqlPagination = false"
                            title="Sử dụng nạp toàn bộ vào RAM rồi phân trang (Cơ chế cũ)">
                        <span>💾</span>
                        <span>RAM Pagination</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Cấu Hình Cloud Sync REST API (Image 8.JPG) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-2">
                <span class="text-cyan-400 font-bold">☁️</span>
                <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">CẤU HÌNH ĐỒNG BỘ CLOUD (REST API OAuth PKCE)</h3>
            </div>
            <span class="text-[11px] text-slate-400">
                Toàn bộ Client ID / Secret được mã hóa AES-256 trong <code class="text-slate-300 font-mono">app_config.json</code>
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Google Drive Box -->
            <div class="bg-[#0F172A] border border-[#2D3748] rounded-xl p-4 flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                        <div class="flex items-center space-x-2">
                            <span class="text-[18px]">📁</span>
                            <span class="font-bold text-white text-[13px]">Google Drive REST API</span>
                        </div>
                        <span class="badge-count text-[10px] @(CloudVM.IsGoogleDriveLoggedIn ? "bg-emerald-600/30 text-emerald-400 border border-emerald-500/30" : "bg-slate-700/50 text-slate-400")">
                            @(CloudVM.IsGoogleDriveLoggedIn ? (string.IsNullOrEmpty(CloudVM.GoogleDriveAccountEmail) ? "✓ Đã kết nối" : $"✓ {CloudVM.GoogleDriveAccountEmail}") : "Chưa kết nối")
                        </span>
                    </div>

                    @if (!CloudVM.UseCustomGoogleDriveApi)
                    {
                        <!-- Chế độ Tự Động 1-Click -->
                        <div class="p-3 bg-gradient-to-r from-emerald-950/40 to-slate-900/60 border border-emerald-500/30 rounded-lg space-y-1.5">
                            <div class="flex items-center space-x-2 text-emerald-400 font-bold text-[12px]">
                                <span>⚡</span>
                                <span>Chế Độ Tự Động (Khuyên dùng)</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Tích hợp cấu hình chuẩn cho Desktop App. Người dùng không cần tạo Google Cloud Project hay điền Client ID phức tạp.
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- Chế độ Tùy Chỉnh Cho Developer -->
                        <div class="space-y-3 text-[12px] bg-[#131C2E] p-3 rounded-lg border border-[#334155]">
                            <div class="flex items-center justify-between">
                                <div class="text-[11px] text-amber-400 font-semibold flex items-center space-x-1">
                                    <span>⚙️</span>
                                    <span>Đang dùng Google Cloud API riêng</span>
                                </div>
                                <button class="btn-secondary text-[10px] py-0.5 px-2 text-sky-300 hover:text-white border-sky-500/40 flex items-center space-x-1"
                                        @onclick="() => CloudVM.OpenGoogleCloudConsoleGuideCommand.Execute(null)">
                                    <span>📖</span>
                                    <span>Mở Cẩm Nang A-Z</span>
                                </button>
                            </div>

                            <!-- Dòng text hướng dẫn mở guide -->
                            <div class="p-2 bg-sky-950/30 border border-sky-500/30 rounded text-[11px] text-sky-200 leading-relaxed flex items-start space-x-1.5">
                                <span class="text-[13px] leading-none">💡</span>
                                <span>
                                    Chưa có Client ID & Secret? Nhấn nút <b>"Mở Cẩm Nang A-Z"</b> ở trên để xem hướng dẫn từng bước kèm hình ảnh chụp thực tế.
                                </span>
                            </div>

                            <div>
                                <label class="block text-slate-400 text-[11px] font-semibold mb-1">Google OAuth Client ID:</label>
                                <input type="text"
                                       class="input-dark font-mono text-[11px] py-1.5 px-3 bg-[#0A0F1D] border-[#334155] text-slate-200"
                                       placeholder="xxxx.apps.googleusercontent.com"
                                       @bind="CloudVM.GoogleDriveClientId" />
                            </div>
                            <div>
                                <label class="block text-slate-400 text-[11px] font-semibold mb-1">Google Client Secret:</label>
                                <div class="relative">
                                    <input type="@(ShowGSecret ? "text" : "password")"
                                           class="input-dark font-mono text-[11px] py-1.5 px-3 pr-8 bg-[#0A0F1D] border-[#334155] text-slate-200"
                                           placeholder="GOCSPX-xxxx"
                                           @bind="CloudVM.GoogleDriveClientSecret" />
                                    <button class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs"
                                            @onclick="() => ShowGSecret = !ShowGSecret">
                                        @(ShowGSecret ? "🙈" : "👁️")
                                    </button>
                                </div>
                            </div>
                            <div class="flex items-center pt-2">
                                <button class="btn-blue text-[11px] py-1 px-2.5"
                                        @onclick="() => CloudVM.SaveCloudApiSettingsCommand.Execute(null)">
                                    💾 Lưu Cấu Hình
                                </button>
                            </div>
                        </div>
                    }

                    <div class="pt-1">
                        <label class="flex items-center space-x-2 text-[11px] text-slate-400 hover:text-slate-200 cursor-pointer select-none">
                            <input type="checkbox" class="checkbox-custom" @bind="CloudVM.UseCustomGoogleDriveApi" />
                            <span>Tùy chỉnh Google Cloud API riêng (Dành cho Developer)</span>
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 mt-3 border-t border-[#1E293B]">
                    @if (CloudVM.UseCustomGoogleDriveApi)
                    {
                        <button class="btn-secondary text-[11px] py-1 px-2.5 text-sky-300 hover:text-white border-sky-500/40 flex items-center space-x-1.5"
                                @onclick="() => CloudVM.OpenGoogleCloudConsoleGuideCommand.Execute(null)"
                                title="Mở cẩm nang hướng dẫn A-Z chi tiết kèm ảnh chụp thực tế">
                            <span>📖</span>
                            <span>Mở Cẩm Nang Hướng Dẫn (A-Z)</span>
                        </button>
                    }
                    else
                    {
                        <span class="text-[11px] text-slate-500 font-mono">1-Click OAuth 2.0</span>
                    }

                    <div class="flex items-center space-x-2">
                        @if (CloudVM.IsGoogleDriveLoggedIn)
                        {
                            <button class="btn-danger text-[11px] py-1 px-3"
                                    @onclick="() => DisconnectCloud(0)">
                                Ngắt Kết Nối
                            </button>
                        }
                        else
                        {
                            <button class="btn-blue text-[11px] py-1 px-3"
                                    @onclick="() => ConnectCloud(0)">
                                🔗 Đăng Nhập OAuth
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Microsoft OneDrive Box -->
            <div class="bg-[#0F172A] border border-[#2D3748] rounded-xl p-4 flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="flex items-center justify-between pb-3 border-b border-[#1E293B]">
                        <div class="flex items-center space-x-2">
                            <span class="text-[18px]">☁️</span>
                            <span class="font-bold text-white text-[13px]">Microsoft OneDrive (Graph API)</span>
                        </div>
                        <span class="badge-count text-[10px] @(CloudVM.IsOneDriveLoggedIn ? "bg-emerald-600/30 text-emerald-400 border border-emerald-500/30" : "bg-slate-700/50 text-slate-400")">
                            @(CloudVM.IsOneDriveLoggedIn ? (string.IsNullOrEmpty(CloudVM.OneDriveAccountEmail) ? "✓ Đã kết nối" : $"✓ {CloudVM.OneDriveAccountEmail}") : "Chưa kết nối")
                        </span>
                    </div>

                    @if (!CloudVM.UseCustomOneDriveApi)
                    {
                        <!-- Chế độ Tự Động 1-Click -->
                        <div class="p-3 bg-gradient-to-r from-blue-950/40 to-slate-900/60 border border-blue-500/30 rounded-lg space-y-1.5">
                            <div class="flex items-center space-x-2 text-blue-400 font-bold text-[12px]">
                                <span>⚡</span>
                                <span>Chế Độ Tự Động (Khuyên dùng)</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Sử dụng Microsoft PKCE Public Client. Kết nối trực tiếp vào tài khoản OneDrive cá nhân chỉ với 1 cú click.
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- Chế độ Tùy Chỉnh Cho Developer -->
                        <div class="space-y-3 text-[12px] bg-[#131C2E] p-3 rounded-lg border border-[#334155]">
                            <div class="text-[11px] text-amber-400 font-semibold flex items-center space-x-1">
                                <span>⚙️</span>
                                <span>Đang dùng Azure Client ID riêng</span>
                            </div>
                            <div>
                                <label class="block text-slate-400 text-[11px] font-semibold mb-1">Azure App Client ID:</label>
                                <input type="text"
                                       class="input-dark font-mono text-[11px] py-1.5 px-3 bg-[#0A0F1D] border-[#334155] text-slate-200"
                                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                       @bind="CloudVM.OneDriveClientId" />
                            </div>
                            <div class="text-[11px] text-slate-500">
                                OneDrive sử dụng chuẩn OAuth 2.0 PKCE Public Client (không cần Client Secret).
                            </div>
                            <div class="flex items-center justify-between pt-2">
                                <button class="btn-blue text-[11px] py-1 px-2.5"
                                        @onclick="() => CloudVM.SaveCloudApiSettingsCommand.Execute(null)">
                                    💾 Lưu Cấu Hình
                                </button>
                                <button class="btn-secondary text-[11px] py-1 px-2 text-slate-400 hover:text-white"
                                        @onclick="() => CloudVM.ResetOneDriveApiToDefault()">
                                    ↩ Về Mặc Định
                                </button>
                            </div>
                        </div>
                    }

                    <div class="pt-1">
                        <label class="flex items-center space-x-2 text-[11px] text-slate-400 hover:text-slate-200 cursor-pointer select-none">
                            <input type="checkbox" class="checkbox-custom" @bind="CloudVM.UseCustomOneDriveApi" />
                            <span>Tùy chỉnh Azure App Client ID riêng (Dành cho Developer)</span>
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 mt-3 border-t border-[#1E293B]">
                    @if (CloudVM.UseCustomOneDriveApi)
                    {
                        <button class="btn-secondary text-[11px] py-1 px-2 text-slate-400 hover:text-white"
                                @onclick="() => CloudVM.OpenAzurePortalGuideCommand.Execute(null)">
                            Hướng dẫn Azure App
                        </button>
                    }
                    else
                    {
                        <span class="text-[11px] text-slate-500 font-mono">1-Click PKCE</span>
                    }

                    <div class="flex items-center space-x-2">
                        @if (CloudVM.IsOneDriveLoggedIn)
                        {
                            <button class="btn-danger text-[11px] py-1 px-3"
                                    @onclick="() => DisconnectCloud(1)">
                                Ngắt Kết Nối
                            </button>
                        }
                        else
                        {
                            <button class="btn-blue text-[11px] py-1 px-3"
                                    @onclick="() => ConnectCloud(1)">
                                🔗 Đăng Nhập OAuth
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Cơ Sở Dữ Liệu SQLite (Image 8.JPG) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center space-x-2 mb-3">
            <span class="text-emerald-400 font-bold">🗄️</span>
            <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">CƠ SỞ DỮ LIỆU SQLITE (SaveVault.db)</h3>
        </div>

        <div class="space-y-3">
            <div>
                <label class="block text-[11px] text-slate-400 font-semibold mb-1">Vị trí file cơ sở dữ liệu hiện tại:</label>
                <div class="flex items-center space-x-2">
                    <input type="text"
                           class="input-dark font-mono text-[12px] py-2 px-3 flex-1 bg-[#0F172A] border-[#334155] text-slate-200"
                           @bind="SettingsVM.DatabaseLocation" />
                    <button class="btn-secondary py-2 px-3 text-[12px] flex-shrink-0"
                            @onclick="() => SettingsVM.BrowseDatabaseFileCommand.Execute(null)">
                        📂 Duyệt...
                    </button>
                    <button class="btn-blue py-2 px-3 text-[12px] flex-shrink-0"
                            @onclick="() => SettingsVM.ApplyDatabaseLocationCommand.Execute(null)">
                        Áp Dụng
                    </button>
                    <button class="btn-secondary py-2 px-3 text-[12px] flex-shrink-0 text-slate-400 hover:text-white"
                            @onclick="() => SettingsVM.ResetDatabaseLocationCommand.Execute(null)">
                        Khôi Phục Mặc Định
                    </button>
                </div>
            </div>
            <div class="text-[11px] text-slate-400">
                Lưu trữ master-detail lịch sử sao lưu (Dapper + SQLite) và game cache offline.
            </div>
        </div>
    </div>

    <!-- Section 3.5: Cơ Sở Dữ Liệu Game & Ludusavi Manifest -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center space-x-2">
                <span class="text-amber-400 font-bold">🎮</span>
                <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">CƠ SỞ DỮ LIỆU GAME (LUDUSAVI MANIFEST)</h3>
            </div>
            <span class="badge-count text-[11px] bg-amber-500/20 text-amber-300 border border-amber-500/30">
                @SettingsVM.CatalogGamesCount tựa game sẵn sàng
            </span>
        </div>

        <div class="space-y-3">
            <div class="text-[12px] text-slate-300 leading-relaxed">
                Tích hợp sẵn danh bạ vị trí save game từ dự án <strong class="text-white">Ludusavi Manifest</strong> (mã nguồn mở). Hoạt động 100% offline, không bị ảnh hưởng bởi Cloudflare hay sự cố mạng.
            </div>

            <div class="flex flex-col p-3.5 bg-[#0F172A] border border-[#2D3748] rounded-lg space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="space-y-0.5">
                        <div class="text-[12px] font-semibold text-white flex items-center space-x-2">
                            <span>Đồng bộ danh mục mới nhất từ GitHub</span>
                            @if (SettingsVM.IsSyncingCatalog)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-950/80 text-cyan-300 border border-cyan-500/40 animate-pulse">
                                    Đang tải @SettingsVM.SyncProgressPercent%
                                </span>
                            }
                        </div>
                        <div class="text-[11px] text-slate-400">
                            @(string.IsNullOrEmpty(SettingsVM.SyncCatalogStatus) ? "Cập nhật hơn 12.000+ cấu hình game mới nhất từ cộng đồng." : SettingsVM.SyncCatalogStatus)
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        @if (SettingsVM.IsSyncingCatalog)
                        {
                            <button type="button" class="btn-secondary py-1.5 px-3 text-[12px] flex items-center space-x-1.5 text-red-300 hover:text-white hover:bg-red-600/30 border-red-500/40"
                                    @onclick="() => SettingsVM.CancelSync()">
                                <span>✕</span>
                                <span>Hủy</span>
                            </button>
                        }
                        <button class="btn-backup-primary py-1.5 px-4 text-[12px] flex items-center space-x-2"
                                disabled="@SettingsVM.IsSyncingCatalog"
                                @onclick="() => SettingsVM.SyncCatalogCommand.Execute(null)">
                            <span>@(SettingsVM.IsSyncingCatalog ? "⏳" : "🔄")</span>
                            <span>@(SettingsVM.IsSyncingCatalog ? "Đang đồng bộ..." : "Cập Nhật Từ GitHub")</span>
                        </button>
                    </div>
                </div>

                @if (SettingsVM.IsSyncingCatalog)
                {
                    <div class="pt-1.5 space-y-1.5 border-t border-slate-800/60">
                        <div class="w-full bg-[#1E293B] rounded-full h-2 overflow-hidden border border-slate-700/50">
                            <div class="bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 h-2 rounded-full transition-all duration-200"
                                 style="width: @(Math.Clamp(SettingsVM.SyncProgressPercent, 0, 100))%;"></div>
                        </div>
                        <div class="flex justify-between items-center text-[10px] text-slate-400 font-mono">
                            <span>@SettingsVM.SyncProgressSubText</span>
                            <span class="font-bold text-cyan-400">@SettingsVM.SyncProgressPercent%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Section 4: Nhật Ký Hoạt Động (Action Logs) -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center space-x-2">
                <span class="text-slate-400 font-bold">📋</span>
                <h3 class="text-[14px] font-bold text-white uppercase tracking-wide">NHẬT KÝ HOẠT ĐỘNG (ACTION LOGS)</h3>
            </div>
            <div class="flex items-center space-x-2">
                <button class="btn-secondary text-[11px] py-1 px-2.5 flex items-center space-x-1"
                        @onclick="LoadRecentLogs">
                    <span>🔄</span>
                    <span>Làm Mới</span>
                </button>
                <button class="btn-secondary text-[11px] py-1 px-2.5 flex items-center space-x-1"
                        @onclick="OpenLogsFolder">
                    <span>📂</span>
                    <span>Mở Thư Mục Logs</span>
                </button>
            </div>
        </div>

        <div class="bg-[#0F172A] border border-[#2D3748] rounded-lg p-3 font-mono text-[11px] text-slate-300 max-h-[160px] overflow-y-auto space-y-1.5">
            @if (RecentLogs.Count == 0)
            {
                <div class="text-slate-500 italic py-2 text-center">Chưa có bản ghi hoạt động nào hoặc thư mục nhật ký trống.</div>
            }
            else
            {
                @foreach (var log in RecentLogs)
                {
                    <div class="flex items-start space-x-2 py-0.5 border-b border-[#1E293B]/40 last:border-0">
                        <span class="text-slate-500 shrink-0 select-none">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold shrink-0 @log.BadgeClass">@log.ShortLevel</span>
                        <span class="text-slate-200 break-all leading-relaxed">@log.Message</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private SettingsSubViewModel SettingsVM => VM.SettingsVM;
    private CloudSubViewModel CloudVM => VM.CloudVM;

    private bool ShowGSecret { get; set; }
    private List<LogEntryItem> RecentLogs { get; set; } = new();

    protected override void OnInitialized()
    {
        SettingsVM.PropertyChanged += OnStateChanged;
        CloudVM.PropertyChanged += OnStateChanged;
        LoadRecentLogs();
    }

    private void OnStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SaveAllSettings()
    {
        await SettingsVM.ExecuteSaveSettingsAsync();
        await CloudVM.ExecuteSaveCloudApiSettingsAsync();
    }

    private async Task ConnectCloud(int providerIndex)
    {
        if (providerIndex == 0)
            await CloudVM.ConnectGoogleDriveAsync();
        else
            await CloudVM.ConnectOneDriveAsync();
    }

    private async Task DisconnectCloud(int providerIndex)
    {
        if (providerIndex == 0)
            await CloudVM.DisconnectGoogleDriveAsync();
        else
            await CloudVM.DisconnectOneDriveAsync();
    }

    private string GetResolvedLogsDirectory()
    {
        return !string.IsNullOrWhiteSpace(LoggingService.LogDirectory) && Directory.Exists(LoggingService.LogDirectory)
            ? LoggingService.LogDirectory
            : Path.Combine(DatabaseService.GetDefaultProjectRoot(), "Logs");
    }

    private void OpenLogsFolder()
    {
        var logsDir = GetResolvedLogsDirectory();
        if (!Directory.Exists(logsDir))
        {
            try { Directory.CreateDirectory(logsDir); } catch { }
        }
        NativeDialog.OpenFolderInExplorer(logsDir);
    }

    private void LoadRecentLogs()
    {
        try
        {
            var logsDir = GetResolvedLogsDirectory();
            if (!Directory.Exists(logsDir))
            {
                RecentLogs = new();
                return;
            }

            var files = Directory.GetFiles(logsDir, "*.json").OrderByDescending(f => f).ToList();
            if (files.Count == 0)
            {
                RecentLogs = new();
                return;
            }

            var targetFile = files[0];
            var parsed = new List<LogEntryItem>();

            using (var fs = new FileStream(targetFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
            using (var reader = new StreamReader(fs))
            {
                var lines = new List<string>();
                string? line;
                while ((line = reader.ReadLine()) != null)
                {
                    if (!string.IsNullOrWhiteSpace(line))
                        lines.Add(line);
                }

                var latestLines = lines.TakeLast(30).Reverse();

                foreach (var rawLine in latestLines)
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(rawLine);
                        var root = doc.RootElement;

                        DateTime ts = DateTime.Now;
                        if (root.TryGetProperty("Timestamp", out var tsEl) && tsEl.TryGetDateTime(out var dt))
                            ts = dt;

                        string lvl = "Info";
                        if (root.TryGetProperty("Level", out var lvlEl))
                            lvl = lvlEl.GetString() ?? "Info";

                        string msg = "";
                        if (root.TryGetProperty("RenderedMessage", out var rmEl))
                            msg = rmEl.GetString() ?? "";
                        else if (root.TryGetProperty("MessageTemplate", out var mtEl))
                            msg = mtEl.GetString() ?? "";

                        if (string.IsNullOrWhiteSpace(msg) && root.TryGetProperty("Properties", out var propEl))
                            msg = propEl.ToString();

                        parsed.Add(new LogEntryItem(ts, lvl, msg));
                    }
                    catch
                    {
                        parsed.Add(new LogEntryItem(DateTime.Now, "Info", rawLine));
                    }
                }
            }

            RecentLogs = parsed;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SettingsTab] LoadRecentLogs error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        SettingsVM.PropertyChanged -= OnStateChanged;
        CloudVM.PropertyChanged -= OnStateChanged;
    }

    private record LogEntryItem(DateTime Timestamp, string Level, string Message)
    {
        public string ShortLevel => Level.ToUpperInvariant() switch
        {
            "WARNING" or "WARN" => "WARN",
            "ERROR" or "FATAL" => "ERR",
            "DEBUG" => "DBG",
            _ => "INFO"
        };

        public string BadgeClass => Level.ToUpperInvariant() switch
        {
            "WARNING" or "WARN" => "text-amber-300 bg-amber-950/80 border border-amber-700/60",
            "ERROR" or "FATAL" => "text-red-300 bg-red-950/80 border border-red-700/60",
            "DEBUG" => "text-slate-400 bg-slate-800 border border-slate-700",
            _ => "text-emerald-300 bg-emerald-950/80 border border-emerald-700/60"
        };
    }
}

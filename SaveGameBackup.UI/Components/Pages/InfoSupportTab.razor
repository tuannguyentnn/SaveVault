@namespace SaveGameBackup.UI.Components.Pages
@using SaveGameBackup.Core.Constants
@inject MainViewModel VM
@inject INativeDialogService NativeDialog

<div class="h-full flex flex-col p-5 space-y-4 overflow-hidden relative select-none">
    <!-- Header Hero Card -->
    <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg flex items-center justify-between flex-shrink-0 flex-wrap gap-4">
        <div class="flex items-center space-x-3.5">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center shadow-[0_0_15px_rgba(6,182,212,0.2)]">
                <span class="text-cyan-400 font-bold text-2xl">🛡️</span>
            </div>
            <div>
                <div class="flex items-center space-x-2.5">
                    <h2 class="text-[17px] font-bold text-white tracking-wide">@AppBuildInfo.AppTitle</h2>
                    <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold bg-cyan-950/80 text-cyan-300 border border-cyan-500/40">
                        v@AppBuildInfo.Version
                    </span>
                </div>
                <div class="text-[12px] text-slate-400 mt-0.5">@AppBuildInfo.Description</div>
            </div>
        </div>

        <div class="flex items-center space-x-2.5">
            <button type="button"
                    class="btn-secondary py-2 px-4 text-[12px] flex items-center space-x-2 text-purple-300 hover:text-white border-purple-500/40 hover:bg-purple-900/30"
                    @onclick="() => VM.UpdateVM.OpenChangelogModalCommand.Execute(null)">
                <span>📜</span>
                <span>Xem Nhật Ký Phiên Bản</span>
            </button>

            <button type="button"
                    class="btn-secondary py-2 px-4 text-[12px] flex items-center space-x-2 text-sky-300 hover:text-white border-sky-500/40 hover:bg-sky-900/30"
                    @onclick="OpenGitHub">
                <span>🌐</span>
                <span>GitHub Repo</span>
            </button>
        </div>
    </div>

    <!-- Scrollable Content Body -->
    <div class="flex-1 overflow-y-auto space-y-4 pr-1.5 sv-custom-scrollbar">
        <!-- Grid 1: Kiến trúc công nghệ & Thông số build -->
        <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-3.5">
            <div class="flex items-center justify-between pb-2.5 border-b border-[#1E293B]">
                <div class="flex items-center space-x-2">
                    <span class="text-sky-400 text-base">⚡</span>
                    <h3 class="text-[13px] font-bold text-white uppercase tracking-wide">NỀN TẢNG &amp; THÔNG SỐ XUẤT BẢN</h3>
                </div>
                <div class="text-[11px] text-slate-400 font-mono">
                    Ngày Build: <span class="text-slate-200 font-bold">@AppBuildInfo.BuildDate</span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                <div class="p-3 bg-[#0F172A] border border-[#1E293B] rounded-xl flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 text-sm">
                        🖥️
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Framework ứng dụng</div>
                        <div class="text-[12px] font-semibold text-white">@AppBuildInfo.TechStack.Framework</div>
                    </div>
                </div>

                <div class="p-3 bg-[#0F172A] border border-[#1E293B] rounded-xl flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-sm">
                        🗄️
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Cơ sở dữ liệu cục bộ</div>
                        <div class="text-[12px] font-semibold text-white">@AppBuildInfo.TechStack.Database</div>
                    </div>
                </div>

                <div class="p-3 bg-[#0F172A] border border-[#1E293B] rounded-xl flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-sm">
                        🎨
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Giao diện người dùng</div>
                        <div class="text-[12px] font-semibold text-white">@AppBuildInfo.TechStack.Styling</div>
                    </div>
                </div>

                <div class="p-3 bg-[#0F172A] border border-[#1E293B] rounded-xl flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-sm">
                        ☁️
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Đồng bộ Cloud API</div>
                        <div class="text-[12px] font-semibold text-white">@AppBuildInfo.TechStack.Cloud</div>
                    </div>
                </div>

                <div class="p-3 bg-[#0F172A] border border-[#1E293B] rounded-xl flex items-center space-x-3 lg:col-span-2">
                    <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 text-sm">
                        🎮
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Cơ sở dữ liệu nhận diện game</div>
                        <div class="text-[12px] font-semibold text-white">@AppBuildInfo.TechStack.ManifestDb</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grid 2: Tính năng nổi bật -->
        <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-3.5">
            <div class="flex items-center space-x-2 pb-2.5 border-b border-[#1E293B]">
                <span class="text-amber-400 text-base">✨</span>
                <h3 class="text-[13px] font-bold text-white uppercase tracking-wide">TÍNH NĂNG NỔI BẬT</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                @foreach (var feature in AppBuildInfo.Features)
                {
                    <div class="p-3 bg-[#0F172A] border border-[#1E293B] rounded-xl flex items-start space-x-3 hover:border-slate-600 transition-colors">
                        <span class="text-cyan-400 font-bold text-sm mt-0.5">✔</span>
                        <span class="text-[12px] text-slate-300 leading-relaxed">@feature</span>
                    </div>
                }
            </div>
        </div>

        <!-- Grid 3: Kênh hỗ trợ & Liên kết cộng đồng -->
        <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-4">
            <div class="flex items-center space-x-2 pb-2.5 border-b border-[#1E293B]">
                <span class="text-indigo-400 text-base">💬</span>
                <h3 class="text-[13px] font-bold text-white uppercase tracking-wide">HỖ TRỢ &amp; BÁO CÁO SỰ CỐ</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <button type="button"
                        class="p-4 bg-[#0F172A] border border-[#1E293B] hover:border-sky-500/50 hover:bg-sky-950/20 rounded-xl text-left transition-all group cursor-pointer flex flex-col justify-between space-y-2"
                        @onclick="OpenIssues">
                    <div class="flex items-center justify-between">
                        <span class="text-xl">🐞</span>
                        <span class="text-xs text-sky-400 group-hover:translate-x-1 transition-transform">➔</span>
                    </div>
                    <div>
                        <div class="text-[13px] font-bold text-white group-hover:text-sky-300">Báo Lỗi &amp; Góp Ý</div>
                        <div class="text-[11px] text-slate-400">Mở GitHub Issue Tracker để gửi báo cáo lỗi hoặc đề xuất tính năng mới</div>
                    </div>
                </button>

                <button type="button"
                        class="p-4 bg-[#0F172A] border border-[#1E293B] hover:border-emerald-500/50 hover:bg-emerald-950/20 rounded-xl text-left transition-all group cursor-pointer flex flex-col justify-between space-y-2"
                        @onclick="OpenCloudGuide">
                    <div class="flex items-center justify-between">
                        <span class="text-xl">📖</span>
                        <span class="text-xs text-emerald-400 group-hover:translate-x-1 transition-transform">➔</span>
                    </div>
                    <div>
                        <div class="text-[13px] font-bold text-white group-hover:text-emerald-300">Hướng Dẫn Cài Đặt Cloud</div>
                        <div class="text-[11px] text-slate-400">Xem cẩm nang hướng dẫn tạo Google Drive Client ID &amp; OneDrive</div>
                    </div>
                </button>

                <button type="button"
                        class="p-4 bg-[#0F172A] border border-[#1E293B] hover:border-purple-500/50 hover:bg-purple-950/20 rounded-xl text-left transition-all group cursor-pointer flex flex-col justify-between space-y-2"
                        @onclick="SendSupportEmail">
                    <div class="flex items-center justify-between">
                        <span class="text-xl">✉️</span>
                        <span class="text-xs text-purple-400 group-hover:translate-x-1 transition-transform">➔</span>
                    </div>
                    <div>
                        <div class="text-[13px] font-bold text-white group-hover:text-purple-300">Email Hỗ Trợ Kỹ Thuật</div>
                        <div class="text-[11px] text-slate-400 font-mono truncate">@AppBuildInfo.Support.Email</div>
                    </div>
                </button>
            </div>
        </div>

        <!-- Grid 4: Tác giả & Giấy phép -->
        <div class="bg-[#131C2E] border border-[#1E293B] rounded-xl p-5 shadow-lg space-y-3">
            <div class="flex items-center justify-between flex-wrap gap-2 pb-2.5 border-b border-[#1E293B]">
                <div class="flex items-center space-x-2">
                    <span class="text-emerald-400 text-base">⚖️</span>
                    <h3 class="text-[13px] font-bold text-white uppercase tracking-wide">TÁC GIẢ &amp; BẢN QUYỀN</h3>
                </div>
                <div class="text-[11.5px] text-slate-400">
                    Phát triển bởi: <strong class="text-white">@AppBuildInfo.Author</strong>
                </div>
            </div>

            <div class="p-3.5 bg-[#0F172A] border border-[#1E293B] rounded-xl flex items-center justify-between flex-wrap gap-3">
                <div class="text-[12px] text-slate-300">
                    @AppBuildInfo.License
                </div>
                <div class="text-[11px] text-slate-500">
                    SaveVault © 2026. Made with ❤️ for PC Gamers.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void OpenGitHub()
    {
        NativeDialog.OpenUrl(AppBuildInfo.Links.GitHub);
    }

    private void OpenIssues()
    {
        NativeDialog.OpenUrl(AppBuildInfo.Links.Issues);
    }

    private void OpenCloudGuide()
    {
        var appDir = AppContext.BaseDirectory;
        var guidePaths = new[]
        {
            Path.Combine(appDir, "GoogleDrive_Setup_Guide.html"),
            Path.Combine(appDir, "..", "GoogleDrive_Setup_Guide.html"),
            Path.Combine(appDir, "app", "GoogleDrive_Setup_Guide.html")
        };

        foreach (var path in guidePaths)
        {
            if (File.Exists(path))
            {
                NativeDialog.OpenFileInExplorer(path);
                return;
            }
        }

        NativeDialog.OpenUrl(AppBuildInfo.Links.Guide);
    }

    private void SendSupportEmail()
    {
        NativeDialog.OpenUrl($"mailto:{AppBuildInfo.Support.Email}?subject=SaveVault%20Support%20Request");
    }
}

@namespace SaveGameBackup.UI.Components.Pages
@inject MainViewModel VM
@inject INativeDialogService NativeDialog
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="h-full flex flex-col space-y-3.5 p-5 overflow-y-auto" style="background-color: #0A0F1D;">
    <!-- Card 1: Nhập tên game để tìm kiếm vị trí save game (Clone chuẩn Image 2 / 0.JPG) -->
    <div class="sv-card">
        <label class="sv-card-label">Nhập tên game để tìm kiếm vị trí save game:</label>
        <div class="flex items-center space-x-2.5 mb-2.5">
            <div class="relative flex-1">
                <input type="text" class="sv-input" style="height: 38px;"
                       placeholder="Nhập tên game (ví dụ: Elden Ring, Cyberpunk 2077, Black Myth: Wukong, Baldur's Gate 3...)"
                       @bind="SearchVM.SearchQuery" @bind:event="oninput" @onkeydown="HandleKeyDown" />

                @if (SearchVM.IsGameDropdownOpen && SearchVM.GameCandidates.Count > 0)
                {
                    <div class="absolute left-0 top-[42px] w-full rounded-md border border-[#334155] bg-[#0F172A] shadow-2xl z-50 overflow-hidden sv-scroll-wrapper"
                         style="position: absolute !important; top: 42px; left: 0; width: 100%; z-index: 50; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7), 0 8px 10px -6px rgba(0, 0, 0, 0.7);"
                         data-scroll-text="Còn gợi ý game bên dưới (Cuộn)">
                        <div class="px-3 py-2 border-b border-[#1E293B] bg-[#0A0F1D] flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                                <span>🎯</span> Chọn game phù hợp (@SearchVM.GameCandidates.Count kết quả từ PCGamingWiki)
                            </span>
                            <button type="button"
                                    class="text-xs text-slate-400 hover:text-red-400 transition-colors cursor-pointer"
                                    @onclick="() => SearchVM.CancelCandidateModalCommand.Execute(null)">✕ Đóng</button>
                        </div>
                        <div class="max-h-60 overflow-y-auto py-1 sv-scroll-area">
                            @foreach (var candidate in SearchVM.GameCandidates)
                            {
                                <button type="button"
                                        class="w-full text-left px-3.5 py-2.5 text-xs text-slate-200 hover:bg-[#1E293B] hover:text-emerald-400 flex items-center justify-between transition-colors border-b border-[#1E293B]/40 last:border-b-0 cursor-pointer"
                                        @onclick="() => SearchVM.SelectCandidateCommand.Execute(candidate)">
                                    <span class="font-medium truncate pr-2">@candidate</span>
                                    <span class="text-[11px] text-slate-500 hover:text-emerald-400 flex items-center gap-1 flex-shrink-0">
                                        <span>Chọn</span>
                                        <span>➔</span>
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <button type="button" class="sv-btn-dark flex-shrink-0" style="height: 38px; padding: 0 16px;"
                    disabled="@((SearchVM.IsSearching && !SearchVM.IsGameDropdownOpen) || string.IsNullOrWhiteSpace(SearchVM.SearchQuery))"
                    @onclick="ExecuteSearch">
                @if (SearchVM.IsSearching && !SearchVM.IsGameDropdownOpen)
                {
                    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                    <span>Đang quét...</span>
                }
                else
                {
                    <span>🔎</span>
                    <span>Tìm kiếm &amp; Quét máy</span>
                }
            </button>
        </div>

        <!-- Gợi ý nhanh (10 game cache gần nhất) -->
        <div class="flex items-center flex-wrap gap-2 pt-0.5 min-h-[28px]">
            <span style="font-size: 11.5px; color: #64748B; margin-right: 4px;">Gợi ý nhanh:</span>
            @if (SearchVM.PopularGameSuggestions.Count == 0)
            {
                <span class="text-[11.5px] text-slate-500 italic">Chưa có lịch sử cache. Các game bạn tìm kiếm sẽ xuất hiện tại đây.</span>
            }
            else
            {
                @foreach (var game in SearchVM.PopularGameSuggestions.Take(10))
                {
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#131C2E] border border-[#1E2D42] text-slate-300 text-[11.5px] hover:border-cyan-500/40 hover:bg-[#18233C] transition-all group shadow-sm">
                        <button type="button"
                                class="hover:text-cyan-300 transition-colors cursor-pointer truncate max-w-[160px] text-left"
                                title="Tìm kiếm '@game' từ cache"
                                @onclick="() => SelectPopularGame(game)">
                            @game
                        </button>
                        <button type="button"
                                class="w-4 h-4 rounded-full flex items-center justify-center text-slate-500 hover:text-red-400 hover:bg-red-500/20 transition-all cursor-pointer text-[10px] leading-none"
                                title="Xóa cache cho '@game'"
                                @onclick="() => DeleteGameCache(game)"
                                @onclick:stopPropagation="true">
                            ✕
                        </button>
                    </div>
                }
            }
        </div>
    </div>

        <!-- Card 2: Thông tin & Vị trí Save Game (LUÔN HIỆN, KHÔNG BAO GIỜ ẨN - Image 2 / 0.JPG) -->
        <div class="sv-card relative min-h-[360px]" style="position: relative; min-height: 360px;">
            @if (SearchVM.IsSearching && !SearchVM.IsGameDropdownOpen)
            {
                <div class="absolute inset-0 z-30 flex flex-col items-center justify-center p-6 text-center select-none"
                     style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 9px; background: rgba(7, 11, 20, 0.88); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid rgba(56, 189, 248, 0.35);">
                    <div class="relative w-12 h-12 mb-3 flex-shrink-0">
                        <div class="absolute inset-0 rounded-full border-2 border-cyan-500/20 border-t-cyan-400 animate-spin"></div>
                        <div class="absolute inset-1.5 rounded-full border-2 border-blue-500/20 border-b-blue-400 animate-spin" style="animation-direction: reverse; animation-duration: 1.2s;"></div>
                        <div class="absolute inset-0 flex items-center justify-center text-sm">🔍</div>
                    </div>
                    <div class="text-[13.5px] font-bold text-cyan-300 mb-1.5 tracking-wide">
                        Đang tìm kiếm &amp; nạp thông tin save game...
                    </div>
                    <div class="text-[11.5px] text-slate-300 font-mono max-w-lg line-clamp-2 px-3 leading-relaxed">
                        @(string.IsNullOrEmpty(SearchVM.StatusMessage) ? "Đang kết nối hệ thống PCGamingWiki & quét ổ đĩa..." : SearchVM.StatusMessage)
                    </div>
                </div>
            }

            <div class="flex gap-4 items-start">
                <!-- Cột trái: Cover ảnh game (Width 200px - Luôn hiện, không bao giờ ẩn) -->
                <div class="sv-cover-col w-[200px] flex-shrink-0">
                    <div
                        class="w-full aspect-[2/3] min-h-[220px] rounded-lg overflow-hidden border border-[#1E2D42] bg-[#070B14] shadow-lg flex flex-col relative">
                        @if (SearchVM.HasGame && !string.IsNullOrEmpty(SearchVM.OnlineCoverUrl))
                        {
                            <img src="@SearchVM.OnlineCoverUrl" alt="Game Cover Preview"
                                 class="w-full h-full object-cover block" loading="lazy"
                                 onerror="this.style.display='none'; var ph = document.getElementById('search-tab-cover-placeholder'); if (ph) ph.style.display='flex';" />
                            <div id="search-tab-cover-placeholder" style="display: none;"
                                 class="w-full h-full bg-gradient-to-br from-[#1E293B] via-[#0F172A] to-[#0A0F1D] flex-col items-center justify-center p-4 text-center">
                                <img src="icon.png" class="w-16 h-16 object-contain opacity-50 mb-2 drop-shadow-[0_0_12px_rgba(6,182,212,0.3)]" alt="Omnisave Logo" />
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider line-clamp-2 px-1">
                                    @(SearchVM.HasGame ? SearchVM.CurrentGame?.GameName : "SAVE GAME")
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="w-full h-full bg-gradient-to-br from-[#1E293B] via-[#0F172A] to-[#0A0F1D] flex flex-col items-center justify-center p-4 text-center">
                                <img src="icon.png" class="w-16 h-16 object-contain opacity-50 mb-2 drop-shadow-[0_0_12px_rgba(6,182,212,0.3)]" alt="Omnisave Logo" />
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider line-clamp-2 px-1">
                                    @(SearchVM.HasGame ? SearchVM.CurrentGame?.GameName : "SAVE GAME")
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Cột phải: Toàn bộ nội dung Thông tin & Vị trí Save Game -->
                <div class="flex-1 min-w-0 flex flex-col">
                    <!-- Header: Title + Nguồn nếu có + Nút Chọn thư mục thủ công -->
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center space-x-2">
                            <h3 class="sv-card-title">Thông tin &amp; Vị trí Save Game</h3>
                            @if (SearchVM.HasGame && SearchVM.CurrentGame != null &&
                            !string.IsNullOrEmpty(SearchVM.CurrentGame.Source))
                            {
                                @if (!string.IsNullOrEmpty(SearchVM.CurrentGame.WikiUrl))
                                {
                                    <button type="button"
                                            @onclick="() => SearchVM.OpenWikiPage()"
                                            title="Nhấp để mở trang web PCGamingWiki (@SearchVM.CurrentGame.WikiUrl)"
                                            class="inline-flex items-center space-x-1.5 transition-all duration-150 cursor-pointer hover:bg-[#1E293B] hover:border-cyan-500 hover:text-cyan-300 group"
                                            style="font-size: 10px; font-weight: 700; padding: 2.5px 8px; border-radius: 4px; background-color: #0A101E; border: 1px solid #1E3A8A; color: #60A5FA;">
                                        <span>Nguồn: @SearchVM.CurrentGame.Source</span>
                                        <svg class="w-2.5 h-2.5 text-blue-400 group-hover:text-cyan-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" 
                                             fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <span
                                        style="font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px; background-color: #0A101E; border: 1px solid #1E3A8A; color: #60A5FA;">
                                        Nguồn: @SearchVM.CurrentGame.Source
                                    </span>
                                }
                            }
                        </div>
                        <button type="button" class="sv-btn-dark sv-btn-sm"
                                @onclick="() => SearchVM.AddCustomPathCommand.Execute(null)">
                            <span>📁</span>
                            <span>Chọn thư mục thủ công</span>
                        </button>
                    </div>

                    <!-- Khối Thông tin game (Khi chưa chọn game vs khi đã chọn game - 0.JPG vs 1.JPG) -->
                    <div class="sv-box-inner mb-3 relative overflow-hidden">
                        @if (SearchVM.HasGame && SearchVM.CurrentGame != null)
                        {
                            @if (!string.IsNullOrEmpty(SearchVM.CurrentGame.SteamAppId))
                            {
                                <button type="button"
                                        style="position: absolute; top: 0; right: 0; border-radius: 0 6px 6px 6px;"
                                        class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 bg-[#0e1f3d] hover:bg-[#162e5b] border-b border-l border-blue-500/40 hover:border-cyan-400 text-sky-300 hover:text-cyan-200 font-mono text-[11px] shadow-sm cursor-pointer z-10 transition-all duration-150 group"
                                        title="Nhấp để mở trang Steam Store (@SearchVM.CurrentGame.SteamUrl)"
                                        @onclick="() => SearchVM.OpenSteamStorePage()">
                                    <span class="text-[10px] text-slate-400 font-sans group-hover:text-slate-300">Steam ID:</span>
                                    <span class="font-bold">@SearchVM.CurrentGame.SteamAppId</span>
                                    <svg class="w-2.5 h-2.5 text-sky-400 group-hover:text-cyan-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" 
                                         fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </button>
                            }
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <span style="font-size: 22px; color: #38BDF8;">📁</span>
                                    <div>
                                        @if (IsEditingGameName)
                                        {
                                            <div class="flex items-center space-x-2 my-0.5">
                                                <input type="text"
                                                       class="sv-input font-bold text-[13px] py-1 px-2.5 h-[32px] w-64 text-white bg-[#0A0F1D] border-cyan-500 focus:border-cyan-400"
                                                       @bind="EditedGameName" @bind:event="oninput"
                                                       @onkeydown="HandleEditGameNameKeyDown" placeholder="Nhập tên game..."
                                                       autofocus />
                                                <button type="button"
                                                        class="btn-success h-[32px] px-2.5 py-0 text-[12px] font-semibold text-white rounded bg-emerald-600 hover:bg-emerald-500 border border-emerald-400 transition-all cursor-pointer inline-flex items-center space-x-1"
                                                        title="Lưu tên game mới" @onclick="SaveEditedGameName">
                                                    <span>✓</span>
                                                    <span>Lưu</span>
                                                </button>
                                                <button type="button"
                                                        class="btn-secondary h-[32px] px-2 py-0 text-[12px] text-slate-400 hover:text-white rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 transition-all cursor-pointer"
                                                        title="Hủy bỏ" @onclick="CancelEditGameName">
                                                    ✕
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex items-center space-x-2">
                                                <div style="color: #FFFFFF; font-weight: 700; font-size: 14px;">
                                                    @SearchVM.CurrentGame.GameName
                                                </div>
                                                @if (SearchVM.CurrentGame.DetectedVersion?.IsDetected == true)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 font-mono"
                                                          title="@($"Phiên bản: {SearchVM.CurrentGame.CurrentGameVersion}\nCơ chế: {SearchVM.CurrentGame.DetectionMechanism ?? "Local"}\nNguồn: {SearchVM.CurrentGame.OnlineSource ?? SearchVM.CurrentGame.DetectedVersion?.DetectionSource}\nThời gian: {SearchVM.CurrentGame.ResolutionDurationMs ?? 0} ms\nFile: {SearchVM.CurrentGame.ExecutablePath ?? "(Không xác định)"}")">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                                        <span>@SearchVM.CurrentGame.CurrentGameVersion</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800/80 border border-slate-700/80 text-slate-400 font-sans"
                                                          title="Chưa tìm thấy phiên bản của game trên máy tính. Bạn có thể bấm 'Tìm file .exe thủ công' bên dưới để trích xuất phiên bản.">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                                                        <span>Không tìm ra phiên bản</span>
                                                    </span>
                                                }
                                                <button type="button"
                                                        class="text-slate-400 hover:text-cyan-400 p-1 rounded hover:bg-slate-800 transition-colors cursor-pointer text-[13px] leading-none"
                                                        title="Chỉnh sửa tên game" @onclick="StartEditGameName">
                                                    ✏️
                                                </button>
                                                <button type="button"
                                                        class="text-slate-400 hover:text-red-400 px-1.5 py-0.5 rounded hover:bg-red-500/10 border border-transparent hover:border-red-500/30 transition-colors cursor-pointer text-[11px] leading-none inline-flex items-center gap-1"
                                                        title="Xóa cache của game này" @onclick="() => DeleteGameCache(SearchVM.CurrentGame.GameName)">
                                                    <span>✕</span>
                                                    <span>Xóa cache</span>
                                                </button>
                                            </div>
                                        }
                                        <div style="font-size: 11.5px; color: #8D9CB0; margin-top: 2px;">
                                            Tìm thấy @SearchVM.DetectedPathItems.Count vị trí lưu game trên máy
                                            (@SearchVM.DetectedFileCount tệp, @SearchVM.DetectedSizeFormatted).
                                            <div class="flex items-center flex-wrap gap-2 mt-1">
                                                @if (!string.IsNullOrEmpty(SearchVM.CurrentGame.ExecutablePath))
                                                {
                                                    <span class="inline-flex items-center text-[11px] text-slate-400/90 truncate max-w-md" title="@($"File: {SearchVM.CurrentGame.ExecutablePath}\nCơ chế: {SearchVM.CurrentGame.DetectionMechanism}\nNguồn: {SearchVM.CurrentGame.OnlineSource}")">
                                                        <span class="text-cyan-400/80 font-medium mr-1">🎮 Thực thi:</span>
                                                        <span class="font-mono text-slate-300 truncate">@SearchVM.CurrentGame.ExecutablePath</span>
                                                        @if (!string.IsNullOrEmpty(SearchVM.CurrentGame.DetectionMechanism))
                                                        {
                                                            <span class="ml-1 text-[10px] px-1.5 py-0.2 rounded bg-blue-950/60 text-blue-300 border border-blue-500/30 font-sans shrink-0">@SearchVM.CurrentGame.DetectionMechanism</span>
                                                        }
                                                    </span>
                                                    <button type="button"
                                                            class="inline-flex items-center space-x-1 px-2 py-0.5 text-[11px] font-medium rounded bg-slate-800 hover:bg-slate-700 text-cyan-300 hover:text-cyan-200 border border-slate-700 hover:border-cyan-500/50 shadow-sm transition-all cursor-pointer"
                                                            title="Mở thư mục chứa file .exe trong Windows Explorer"
                                                            @onclick="() => SearchVM.OpenExecutableFolder()">
                                                        <span>📂</span>
                                                        <span>Mở thư mục .exe</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center text-[11px] text-slate-400/70 italic">
                                                        <span class="text-slate-400 font-medium mr-1 not-italic">🎮 Thực thi:</span>
                                                        <span>Chưa tìm thấy file .exe tự động</span>
                                                    </span>
                                                }
                                                <button type="button"
                                                        class="inline-flex items-center space-x-1 px-2 py-0.5 text-[11px] font-medium rounded bg-slate-800 hover:bg-slate-700 text-amber-300 hover:text-amber-200 border border-slate-700 hover:border-amber-500/50 shadow-sm transition-all cursor-pointer"
                                                        title="Chọn file thực thi (.exe) thủ công từ máy tính để phân tích và cập nhật phiên bản"
                                                        @onclick="() => SearchVM.PickExecutableFileManuallyAsync()">
                                                    <span>🎯</span>
                                                    <span>@(string.IsNullOrEmpty(SearchVM.CurrentGame.ExecutablePath) ? "Tìm file .exe thủ công" : "Đổi file .exe")</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-right @(!string.IsNullOrEmpty(SearchVM.CurrentGame.SteamAppId) ? "pt-5" : "")">
                                    <div
                                        style="font-size: 16px; font-weight: 700; color: #34D399; font-family: var(--font-mono);">
                                        @SearchVM.SelectedSizeFormatted
                                    </div>
                                    <div style="font-size: 11px; color: #8D9CB0; margin-top: 2px;">
                                        @SearchVM.SelectedFileCount tệp đã chọn
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center space-x-3">
                                <span style="font-size: 22px; color: #64748B;">📁</span>
                                <div>
                                    <div style="color: #FFFFFF; font-weight: 700; font-size: 13px;">Chưa chọn game nào</div>
                                    <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">Sẵn sàng. Hãy nhập tên game
                                        để tìm
                                        kiếm vị trí save game.</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Thanh tiêu đề danh sách thư mục -->
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center space-x-2" style="font-size: 12px; color: #94A3B8;">
                                <span>Thư mục save phát hiện trên máy tính:</span>
                                <span style="color: #64748B;">
                                    Đã chọn: <strong
                                    style="color: #38BDF8; font-family: var(--font-mono);">@SearchVM.SelectedPathCount/@SearchVM.DetectedPathItems.Count
                                    vị trí</strong>
                                </span>
                            </div>

                            <div class="flex items-center space-x-2">
                                <button type="button" class="sv-btn-dark sv-btn-sm"
                                        disabled="@(SearchVM.DetectedPathItems.Count == 0)"
                                        @onclick="() => SearchVM.SelectAllPathsCommand.Execute(null)">
                                    ✓ Chọn tất cả
                                </button>
                                <button type="button" class="sv-btn-dark sv-btn-sm"
                                        disabled="@(SearchVM.DetectedPathItems.Count == 0)"
                                        @onclick="() => SearchVM.DeselectAllPathsCommand.Execute(null)">
                                    ✕ Bỏ chọn hết
                                </button>
                            </div>
                        </div>

                        <!-- Khung danh sách thư mục (List box - min-height 200px, max-height 300px kèm scroll hint) -->
                        <div class="sv-listbox-wrapper">
                            <div id="sv-detected-paths-box" class="sv-listbox">
                                @if (SearchVM.DetectedPathItems.Count == 0)
                                {
                                    <div class="flex items-center justify-center h-full min-h-[200px]" style="min-height: 200px;">
                                        <span style="color: #64748B; font-size: 12px; font-style: italic; text-align: center;">
                                            Chưa phát hiện thư mục save nào trên máy tính. Bạn có thể nhấn '📁 Chọn thư mục thủ công' ở
                                            góc trên
                                            để thêm vị trí lưu.
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-1.5 w-full">
                                        @foreach (var item in SearchVM.DetectedPathItems)
                                        {
                                            <div class="flex items-center justify-between p-2 rounded"
                                                 style="background-color: #0F172A; border: 1px solid @(item.IsSelected ? "#059669" : "#1E293B");">
                                                <label class="flex items-center space-x-2.5 min-w-0 flex-1 mr-3 cursor-pointer select-none"
                                                       @onclick="() => TogglePathItem(item)" @onclick:preventDefault="true">
                                                    <input type="checkbox" checked="@item.IsSelected" style="cursor: pointer;" />
                                                    <span style="font-size: 13px; color: #94A3B8;">📁</span>
                                                    <div class="min-w-0 flex-1">
                                                        <div style="font-family: var(--font-mono); font-size: 12px; color: #E2E8F0; word-break: break-all;">
                                                            @item.Path
                                                        </div>
                                                    </div>
                                                </label>

                                                <div class="flex items-center space-x-3 flex-shrink-0">
                                                    <span style="font-size: 11px; color: #8D9CB0; font-family: var(--font-mono);">
                                                        @item.FileCount tệp
                                                    </span>
                                                    <span style="font-size: 11px; color: #34D399; font-family: var(--font-mono); font-weight: 600;">
                                                        @item.FormattedSize
                                                    </span>
                                                    <button type="button" class="sv-btn-dark sv-btn-sm"
                                                            title="Mở thư mục trong File Explorer"
                                                            @onclick="() => SearchVM.OpenSpecificDetectedPathCommand.Execute(item.Path)">
                                                        📁 Mở
                                                    </button>
                                                    <button type="button"
                                                            class="bg-red-600/20 hover:bg-red-600 border border-red-500/50 hover:border-red-500 text-red-300 hover:text-white font-semibold text-[11px] py-1 px-2.5 rounded transition-all cursor-pointer"
                                                            title="Xóa khỏi danh sách này"
                                                            @onclick="() => SearchVM.RemoveDetectedPathCommand.Execute(item)">
                                                        🗑 Xóa
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (CanScrollDown && SearchVM.DetectedPathItems.Count > 0)
                            {
                                <div class="sv-listbox-gradient-overlay"></div>
                                <button type="button"
                                        class="sv-listbox-scroll-hint"
                                        @onclick="ScrollListboxDown"
                                        title="Nhấp để cuộn xuống xem thêm thư mục save bên dưới">
                                    <span>▼</span>
                                    <span>Còn vị trí bên dưới (Cuộn)</span>
                                </button>
                            }
                        </div>

                        <!-- Toggle Xem các định dạng đường dẫn tra cứu từ mạng / wiki (Image 2 / 0.JPG) -->
                        <div class="mt-2.5">
                            <button type="button"
                                    style="background: transparent; border: none; color: #8D9CB0; font-size: 11.5px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;"
                                    @onclick="() => ShowOnlinePatterns = !ShowOnlinePatterns">
                                <span>@(ShowOnlinePatterns ? "▼" : "👁")</span>
                                <span>Xem các định dạng đường dẫn tra cứu từ mạng / wiki</span>
                            </button>

                            @if (ShowOnlinePatterns)
                            {
                                <div class="sv-scroll-wrapper mt-2" data-scroll-text="Còn định dạng bên dưới (Cuộn)">
                                    <div class="sv-box-inner font-mono text-[11px] text-slate-300 max-h-[110px] overflow-y-auto space-y-1 sv-scroll-area">
                                        @if (SearchVM.OnlinePatternsList.Count == 0)
                                        {
                                            <div class="text-slate-500 italic">Chưa có mẫu đường dẫn online nào được nạp. Hãy tìm kiếm một game để xem các mẫu từ PCGamingWiki &amp; Steam.</div>
                                        }
                                        else
                                        {
                                            @foreach (var pattern in SearchVM.OnlinePatternsList)
                                            {
                                                <div class="text-cyan-400 select-text break-all">• @pattern</div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3: Thực hiện Sao lưu -->
            <div class="sv-card">
                <div class="flex items-center space-x-3">
                    <button type="button" class="sv-btn-backup @(CanBackup ? "ready" : "")" disabled="@(!CanBackup)"
                            @onclick="ExecuteBackup">
                        <span>💾</span>
                        <span>SAO LƯU NGAY (BACKUP NOW)</span>
                    </button>

                    <button type="button" class="sv-btn-dark" style="padding: 10px 18px; font-size: 12.5px; font-weight: 600;"
                            @onclick="() => BackupVM.OpenBackupFolderCommand.Execute(null)">
                        <span>📁</span>
                        <span>Mở thư mục Backup</span>
                    </button>
                </div>
            </div>
</div>

@code {
    private SearchSubViewModel SearchVM => VM.SearchVM;
    private BackupSubViewModel BackupVM => VM.BackupVM;

    private bool ShowOnlinePatterns { get; set; } = false;
    private bool IsEditingGameName { get; set; } = false;
    private string EditedGameName { get; set; } = string.Empty;

    private bool CanScrollDown { get; set; } = false;
    private DotNetObjectReference<SearchTab>? _dotNetRef;

    private bool CanBackup => !BackupVM.IsBackingUp && SearchVM.HasGame && SearchVM.HasSelectedPaths;

    protected override void OnInitialized()
    {
        SearchVM.PropertyChanged += OnStateChanged;
        BackupVM.PropertyChanged += OnStateChanged;
    }

    private void OnStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (!SearchVM.HasGame)
        {
            IsEditingGameName = false;
        }
        if (SearchVM.DetectedPathItems.Count > 3)
        {
            CanScrollDown = true;
        }
        else if (SearchVM.DetectedPathItems.Count <= 2)
        {
            CanScrollDown = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private void StartEditGameName()
    {
        if (SearchVM.CurrentGame != null)
        {
            EditedGameName = SearchVM.CurrentGame.GameName;
            IsEditingGameName = true;
        }
    }

    private void SaveEditedGameName()
    {
        if (!string.IsNullOrWhiteSpace(EditedGameName))
        {
            SearchVM.UpdateGameName(EditedGameName);
        }
        IsEditingGameName = false;
    }

    private void CancelEditGameName()
    {
        IsEditingGameName = false;
    }

    private void HandleEditGameNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SaveEditedGameName();
        }
        else if (e.Key == "Escape")
        {
            CancelEditGameName();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchVM.SearchQuery))
        {
            await ExecuteSearch();
        }
    }

    private async Task ExecuteSearch()
    {
        if (SearchVM.IsSearching && !SearchVM.IsGameDropdownOpen) return;
        await SearchVM.ExecuteSearchAsync();
    }

    private async Task SelectPopularGame(string gameName)
    {
        SearchVM.SearchQuery = gameName;
        await ExecuteSearch();
    }

    private async Task DeleteGameCache(string? gameName)
    {
        if (string.IsNullOrWhiteSpace(gameName)) return;
        await SearchVM.DeleteGameCacheAsync(gameName);
    }

    private void TogglePathItem(DetectedPathItem item)
    {
        item.IsSelected = !item.IsSelected;
        SearchVM.UpdateSelectedPathsStats();
    }

    private async Task ExecuteBackup()
    {
        if (!CanBackup) return;
        await BackupVM.ExecuteBackupAsync();
    }

    [JSInvokable]
    public void OnListBoxScrollChanged(bool canScroll)
    {
        if (CanScrollDown != canScroll)
        {
            CanScrollDown = canScroll;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task ScrollListboxDown()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("listboxHelper.scrollDown", "sv-detected-paths-box");
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("listboxHelper.init", "sv-detected-paths-box", _dotNetRef);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        SearchVM.PropertyChanged -= OnStateChanged;
        BackupVM.PropertyChanged -= OnStateChanged;
        try
        {
            _dotNetRef?.Dispose();
            _ = JSRuntime.InvokeVoidAsync("listboxHelper.dispose", "sv-detected-paths-box");
        }
        catch { }
    }
}
